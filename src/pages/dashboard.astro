---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { APP_CONFIG } from '../utils/config';

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "User Dashboard", href: "/dashboard/" }
];
---

<BaseLayout 
  title="User Dashboard & Link History — TeraWala" 
  description="Manage your TeraWala account, check your daily 5 free link quota, view download history, and manage your high-speed Premium subscription."
  noindex={true}
>
  <div class="dashboard-wrapper">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Loading State Overlay -->
      <div id="dash-loading" class="dash-loading-card">
        <div class="dash-spinner"></div>
        <p>Loading your profile and quota details...</p>
      </div>

      <!-- Unauthorized / Not Logged In State -->
      <div id="dash-unauthorized" class="dash-unauth-card" style="display: none;">
        <div class="unauth-icon-wrap">
          <img src="/logo.svg" alt="TeraWala Logo" width="56" height="56" class="unauth-brand-logo" />
        </div>
        <h2 class="unauth-title">Authentication Required</h2>
        <p class="unauth-desc">Please sign in or create an account to view your dashboard, link history, and Premium status.</p>
        <div class="unauth-actions">
          <button type="button" class="btn-primary" id="dash-login-btn">
            <span>Sign In to TeraWala</span>
          </button>
          <button type="button" class="btn-secondary" id="dash-signup-btn">
            <span>Create Free Account</span>
          </button>
        </div>
      </div>

      <!-- Main Dashboard Content (When Authenticated) -->
      <div id="dash-content" class="dash-content" style="display: none;">
        
        <!-- Top Profile Banner & Stats Grid -->
        <div class="profile-hero-card">
          <div class="profile-meta-row">
            <div class="profile-avatar-box">
              <span id="user-avatar-initials">U</span>
            </div>
            <div class="profile-text-box">
              <div class="name-badge-row">
                <h1 class="user-display-name" id="user-display-name">User</h1>
                <span class="user-tier-badge" id="user-tier-badge">Free Tier</span>
                <span class="user-admin-badge" id="user-admin-badge" style="display: none;">Admin</span>
              </div>
              <div class="user-profile-plan-banner" id="user-plan-subheading">
                <span class="membership-crown-icon" id="membership-crown-icon">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path></svg>
                </span>
                <span class="membership-plan-name" id="user-profile-plan-name">Free Tier Member</span>
              </div>
              <p class="user-email-text" id="user-email-text">user@example.com</p>
              <span class="user-member-since" id="user-member-since">Member since today</span>
            </div>
            <div class="profile-hero-actions">
              <a href="/admin/" class="btn-admin-nav" id="dash-admin-link" style="display: none;">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                <span>Admin Console</span>
              </a>
              <button type="button" class="btn-signout" id="dash-signout-btn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                <span>Sign Out</span>
              </button>
            </div>
          </div>

          <!-- 3 Highlight Metric Cards -->
          <div class="dash-stats-row">
            <!-- Metric 1: Daily Link Quota -->
            <div class="dash-metric-card" id="metric-quota-card">
              <div class="metric-top">
                <span class="metric-label">Daily Link Quota</span>
                <span class="metric-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="#10b981" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                </span>
              </div>
              <div class="metric-value-row">
                <span class="metric-value" id="quota-used-val">0</span>
                <span class="metric-sub" id="quota-total-val">/ 5 Links</span>
              </div>
              <div class="quota-progress-track">
                <div class="quota-progress-fill" id="quota-progress-fill" style="width: 0%;"></div>
              </div>
              <div class="dash-reset-pill-box" id="dash-reset-pill-box">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>Resets in <strong id="dash-reset-timer">--:--:--</strong></span>
              </div>
              <p class="metric-hint" id="quota-hint-text">Free tier allows 5 links daily with midnight reset.</p>
            </div>

            <!-- Metric 2: Plan Status -->
            <div class="dash-metric-card" id="metric-plan-card">
              <div class="metric-top">
                <span class="metric-label">Membership Tier</span>
                <span class="metric-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="#f59e0b" aria-hidden="true"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path></svg>
                </span>
              </div>
              <div class="metric-value-row">
                <span class="metric-value metric-plan-title" id="plan-name-val">Free Plan</span>
              </div>
              <p class="metric-hint" id="plan-expiry-text">Upgrade for unlimited links & 4K speed</p>
              <button type="button" class="metric-action-btn" id="dash-upgrade-btn">
                <span id="dash-upgrade-btn-text">Buy Premium</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>

            <!-- Metric 3: Total Links Resolved -->
            <div class="dash-metric-card">
              <div class="metric-top">
                <span class="metric-label">Total Links Processed</span>
                <span class="metric-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#38bdf8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </span>
              </div>
              <div class="metric-value-row">
                <span class="metric-value" id="total-processed-val">0</span>
                <span class="metric-sub">Videos</span>
              </div>
              <p class="metric-hint">Lifetime processed via TeraWala</p>
              <a href="/" class="metric-link-btn">
                <span>Resolve New Link</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Section: Recent Link History -->
        <div class="dash-section-card">
          <div class="section-card-header">
            <div>
              <h2 class="section-card-title">Your Resolved Video History</h2>
              <p class="section-card-subtitle">Recent TeraBox and Diskwala streams processed on your account</p>
            </div>
            <button type="button" class="btn-refresh" id="refresh-history-btn" title="Refresh history">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
              <span>Refresh</span>
            </button>
          </div>

          <!-- History Table / Feed -->
          <div class="history-table-wrapper">
            <table class="history-table" id="history-table">
              <thead>
                <tr>
                  <th>File / Title</th>
                  <th>Platform</th>
                  <th>Status</th>
                  <th>Resolved Time</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="history-tbody">
                <!-- Dynamically populated -->
              </tbody>
            </table>

            <!-- Empty State -->
            <div class="empty-history" id="empty-history" style="display: none;">
              <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
              <h3>No Resolved Links Yet</h3>
              <p>You haven't resolved any video links yet. Paste any Terabox or Diskwala link on the homepage to start streaming!</p>
              <a href="/" class="btn-primary" style="margin-top: 14px;">
                <span>Start Resolving Links</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Section: Premium Membership Options -->
        <div class="dash-section-card" id="pricing-plans-section">
          <div class="section-card-header">
            <div>
              <h2 class="section-card-title" id="pricing-section-title">Buy Premium Membership</h2>
              <p class="section-card-subtitle" id="pricing-section-subtitle">Unlock unlimited daily downloads, 4K video player, zero ads, and maximum speeds</p>
            </div>
          </div>

          <!-- VIP Active Banner -->
          <div id="vip-active-banner" class="vip-active-banner" style="display: none;">
            <div class="vip-banner-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="#f59e0b"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path></svg>
            </div>
            <div class="vip-banner-info">
              <div class="vip-banner-title">VIP Membership Active: <span id="vip-banner-plan-name">Turbo 24h VIP</span></div>
              <div class="vip-banner-desc">You have unlocked uncapped daily link conversions, highest 4K streaming pipeline, and zero queue delays. You can renew or extend your pass anytime below.</div>
            </div>
          </div>

          <div class="dash-pricing-grid">
            {APP_CONFIG.plans.map((p) => (
              <div class={`dash-plan-box ${p.badge ? 'is-best' : ''}`}>
                {p.badge && <span class="dash-plan-badge">{p.badge}</span>}
                <h3 class="dash-plan-title">{p.name}</h3>
                <div class="dash-plan-price">
                  <span class="sym">₹</span>
                  <span class="amt">{p.price}</span>
                  <span class="per">/ {p.period}</span>
                </div>
                <p class="dash-plan-desc">{p.description}</p>
                <ul class="dash-plan-feats">
                  {p.features.map(f => (
                    <li>
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
                <button 
                  type="button" 
                  class={`dash-buy-btn ${p.badge ? 'btn-popular' : ''}`}
                  data-buy-plan-id={p.id}
                >
                  <span>Activate {p.name}</span>
                </button>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .dashboard-wrapper {
    padding: 30px 16px 80px;
    min-height: 80vh;
  }

  .dash-loading-card,
  .dash-unauth-card {
    background: rgba(10, 16, 18, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: 60px 24px;
    text-align: center;
    max-width: 560px;
    margin: 40px auto;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
  }

  .dash-spinner {
    width: 38px;
    height: 38px;
    border: 3px solid rgba(16, 185, 129, 0.2);
    border-top-color: #10b981;
    border-radius: 50%;
    animation: dashSpin 0.8s linear infinite;
    margin: 0 auto 18px;
  }

  @keyframes dashSpin {
    to { transform: rotate(360deg); }
  }

  .unauth-icon-wrap {
    width: 68px;
    height: 68px;
    border-radius: var(--radius-lg);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .unauth-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .unauth-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .unauth-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Profile Hero Card */
  .profile-hero-card {
    background: linear-gradient(180deg, rgba(14, 23, 26, 0.95) 0%, rgba(8, 13, 14, 0.98) 100%);
    border: 1px solid rgba(52, 211, 153, 0.28);
    border-radius: var(--radius-xl);
    padding: 32px 28px;
    margin-bottom: 28px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .profile-meta-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-bottom: 26px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }

  .profile-avatar-box {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 26px;
    font-weight: 850;
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    flex-shrink: 0;
  }

  .profile-text-box {
    flex: 1;
    min-width: 200px;
  }

  .name-badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .user-display-name {
    font-size: var(--text-2xl);
    font-weight: 850;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .user-tier-badge {
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .user-tier-badge.is-vip {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(5, 150, 105, 0.35) 100%);
    color: #34d399;
    border-color: rgba(52, 211, 153, 0.5);
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.25);
  }

  .user-admin-badge {
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    background: rgba(239, 68, 68, 0.2);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  .user-email-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: 2px;
  }

  .user-member-since {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .profile-hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-admin-nav {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 750;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-admin-nav:hover {
    background: rgba(239, 68, 68, 0.25);
    color: #ffffff;
  }

  .btn-signout {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: 650;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .btn-signout:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  /* 3 Metric Cards Row */
  .dash-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 26px;
  }

  .dash-metric-card {
    background: rgba(10, 16, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .metric-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .metric-icon {
    font-size: 16px;
  }

  .metric-value-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 10px;
  }

  .metric-value {
    font-size: 2rem;
    font-weight: 850;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .metric-sub {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .quota-progress-track {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .quota-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #34d399);
    border-radius: 9999px;
    transition: width 0.3s ease;
  }

  .metric-hint {
    font-size: 11px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .metric-action-btn,
  .metric-link-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
    padding: 8px 14px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(52, 211, 153, 0.4);
    color: #34d399;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 750;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .metric-action-btn:hover,
  .metric-link-btn:hover {
    background: rgba(16, 185, 129, 0.25);
    color: #ffffff;
  }

  /* Section Card */
  .dash-section-card {
    background: rgba(11, 17, 19, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 28px;
    margin-bottom: 28px;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.6);
  }

  .section-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .section-card-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.015em;
  }

  .section-card-subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: 4px;
  }

  .btn-refresh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .btn-refresh:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  /* History Table */
  .history-table-wrapper {
    overflow-x: auto;
  }

  .history-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    text-align: left;
  }

  .history-table th {
    padding: 12px 14px;
    color: var(--color-text-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .history-table td {
    padding: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary);
  }

  .history-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .table-file-title {
    color: #ffffff;
    font-weight: 600;
    max-width: 280px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .table-platform-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-size: 10px;
    font-weight: 750;
    text-transform: uppercase;
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .table-platform-badge.terabox {
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    border-color: rgba(16, 185, 129, 0.3);
  }

  .empty-history {
    text-align: center;
    padding: 40px 20px;
    color: var(--color-text-muted);
  }

  .empty-history svg {
    margin-bottom: 14px;
    color: rgba(255, 255, 255, 0.2);
  }

  .empty-history h3 {
    font-size: var(--text-base);
    color: #ffffff;
    margin-bottom: 6px;
  }

  .empty-history p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    max-width: 440px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Dash Pricing Grid */
  .dash-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .dash-plan-box {
    background: rgba(8, 14, 16, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.2s;
  }

  .dash-plan-box:hover {
    transform: translateY(-3px);
    border-color: rgba(52, 211, 153, 0.35);
  }

  .dash-plan-box.is-best {
    border-color: rgba(16, 185, 129, 0.5);
    background: linear-gradient(180deg, rgba(13, 26, 24, 0.8) 0%, rgba(8, 14, 16, 0.9) 100%);
  }

  .dash-plan-badge {
    position: absolute;
    top: -10px;
    left: 20px;
    background: #10b981;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 10px;
    border-radius: 9999px;
    text-transform: uppercase;
  }

  .dash-plan-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .dash-plan-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 8px;
  }

  .dash-plan-price .sym {
    font-size: var(--text-lg);
    color: #10b981;
    font-weight: 700;
  }

  .dash-plan-price .amt {
    font-size: 1.8rem;
    font-weight: 850;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .dash-plan-price .per {
    font-size: 11px;
    color: var(--color-text-secondary);
  }

  .dash-plan-desc {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-bottom: 14px;
    min-height: 32px;
  }

  .dash-plan-feats {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dash-plan-feats li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #e2e8f0;
  }

  .dash-buy-btn {
    width: 100%;
    padding: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 750;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .dash-buy-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .dash-buy-btn.btn-popular {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
  }

  .dash-buy-btn.btn-popular:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
  }

  @media (max-width: 860px) {
    .dash-stats-row {
      grid-template-columns: 1fr;
    }
    .dash-pricing-grid {
      grid-template-columns: 1fr;
    }
    .profile-meta-row {
      flex-direction: column;
      text-align: center;
    }
    .name-badge-row {
      justify-content: center;
    }
    .profile-hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .profile-hero-card {
      padding: 20px 16px;
    }
    .dash-section-card {
      padding: 20px 14px;
    }
    .dash-stats-row {
      gap: 14px;
    }
    .profile-avatar-box {
      width: 56px;
      height: 56px;
      font-size: 20px;
    }
    .user-display-name {
      font-size: 1.25rem;
    }
    .profile-hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-admin-nav, .btn-signout {
      width: 100%;
      min-height: 44px;
      justify-content: center;
    }
    .history-table-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 0 -4px;
    }
    .history-table {
      min-width: 520px;
    }
    .history-table th, .history-table td {
      padding: 10px 8px;
    }
  }

  @media (max-width: 480px) {
    .dashboard-section {
      padding-top: 18px;
      padding-bottom: 40px;
    }
    .profile-hero-card {
      padding: 18px 12px;
      border-radius: var(--radius-lg);
    }
    .dash-section-card {
      padding: 18px 12px;
      border-radius: var(--radius-lg);
    }
    .dash-plan-box {
      padding: 20px 14px;
    }
    .dash-buy-btn {
      min-height: 48px;
      font-size: 14px;
    }
    .dash-unauth-card {
      padding: 28px 14px 22px;
      border-radius: var(--radius-lg);
    }
    .dash-unauth-card h2 {
      font-size: 1.45rem;
    }
    .dash-unauth-btn {
      min-height: 48px;
      font-size: 15px;
    }
  }

  /* Plan Subtitle Banner under Profile Name */
  .user-profile-plan-banner {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 12px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 11px;
    font-weight: 750;
    color: #cbd5e1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-bottom: 6px;
    width: fit-content;
  }

  .user-profile-plan-banner.is-vip {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.16) 0%, rgba(217, 119, 6, 0.24) 100%);
    border-color: rgba(245, 158, 11, 0.45);
    color: #fbbf24;
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.2);
  }

  .membership-crown-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Reset Pill inside Quota Card */
  .dash-reset-pill-box {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #f59e0b;
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 8px;
    width: fit-content;
  }

  .dash-reset-pill-box strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #fbbf24;
  }

  /* VIP Active Banner */
  .vip-active-banner {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 20px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(5, 150, 105, 0.2) 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
    border-radius: var(--radius-lg);
    margin-bottom: 24px;
  }

  .vip-banner-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: rgba(245, 158, 11, 0.18);
    border: 1px solid rgba(245, 158, 11, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vip-banner-title {
    font-size: var(--text-sm);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .vip-banner-title span {
    color: #34d399;
    text-transform: uppercase;
  }

  .vip-banner-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .metric-plan-title {
    font-size: 1.45rem !important;
    letter-spacing: -0.01em;
  }

  /* Light Mode Styling for Dashboard */
  :root[data-theme="light"] .profile-hero-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.05) !important;
  }
  :root[data-theme="light"] .user-display-name {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .user-email-text {
    color: #475569 !important;
  }
  :root[data-theme="light"] .user-profile-plan-banner {
    background: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #334155 !important;
  }
  :root[data-theme="light"] .user-profile-plan-banner.is-vip {
    background: #fef3c7 !important;
    border-color: #fcd34d !important;
    color: #b45309 !important;
    box-shadow: 0 2px 10px rgba(245, 158, 11, 0.15) !important;
  }
  :root[data-theme="light"] .dash-reset-pill-box {
    background: #fffbeb !important;
    border-color: #fde68a !important;
    color: #b45309 !important;
  }
  :root[data-theme="light"] .dash-reset-pill-box strong {
    color: #92400e !important;
  }
  :root[data-theme="light"] .dash-metric-card {
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02) !important;
  }
  :root[data-theme="light"] .metric-label {
    color: #64748b !important;
  }
  :root[data-theme="light"] .metric-value {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .metric-sub {
    color: #64748b !important;
  }
  :root[data-theme="light"] .metric-hint {
    color: #64748b !important;
  }
  :root[data-theme="light"] .quota-progress-track {
    background: #e2e8f0 !important;
  }
  :root[data-theme="light"] .dash-section-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.05) !important;
  }
  :root[data-theme="light"] .section-card-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .section-card-subtitle {
    color: #64748b !important;
  }
  :root[data-theme="light"] .history-table th {
    border-bottom-color: #e2e8f0 !important;
    color: #475569 !important;
    background: #f8fafc !important;
  }
  :root[data-theme="light"] .history-table td {
    border-bottom-color: #f1f5f9 !important;
    color: #334155 !important;
  }
  :root[data-theme="light"] .history-table tr:hover td {
    background: #f8fafc !important;
  }
  :root[data-theme="light"] .table-file-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .dash-plan-box {
    background: #ffffff !important;
    border-color: #e2e8f0 !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
  }
  :root[data-theme="light"] .dash-plan-box.is-best {
    background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%) !important;
    border-color: rgba(5, 150, 105, 0.4) !important;
  }
  :root[data-theme="light"] .dash-plan-title,
  :root[data-theme="light"] .dash-plan-price .amt {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .dash-plan-desc {
    color: #64748b !important;
  }
  :root[data-theme="light"] .dash-plan-feats li {
    color: #334155 !important;
  }
  :root[data-theme="light"] .dash-buy-btn {
    background: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }
  :root[data-theme="light"] .vip-active-banner {
    background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%) !important;
    border-color: #6ee7b7 !important;
  }
  :root[data-theme="light"] .vip-banner-title {
    color: #065f46 !important;
  }
  :root[data-theme="light"] .vip-banner-title span {
    color: #047857 !important;
  }
  :root[data-theme="light"] .vip-banner-desc {
    color: #065f46 !important;
  }
</style>

<script>
  import { getCurrentUser, getUserProfile, getSupabase, signOutUser, checkDailyQuota } from '../utils/supabase';
  import { startRazorpayCheckout } from '../utils/razorpay';
  import { APP_CONFIG } from '../utils/config';

  const loadingEl = document.getElementById('dash-loading');
  const unauthEl = document.getElementById('dash-unauthorized');
  const contentEl = document.getElementById('dash-content');

  const avatarInitials = document.getElementById('user-avatar-initials');
  const displayName = document.getElementById('user-display-name');
  const emailText = document.getElementById('user-email-text');
  const memberSince = document.getElementById('user-member-since');
  const tierBadge = document.getElementById('user-tier-badge');
  const adminBadge = document.getElementById('user-admin-badge');
  const adminLink = document.getElementById('dash-admin-link');
  const signoutBtn = document.getElementById('dash-signout-btn');

  const quotaUsed = document.getElementById('quota-used-val');
  const quotaTotal = document.getElementById('quota-total-val');
  const quotaFill = document.getElementById('quota-progress-fill');
  const quotaHint = document.getElementById('quota-hint-text');

  const planNameVal = document.getElementById('plan-name-val');
  const planExpiryText = document.getElementById('plan-expiry-text');
  const totalProcessedVal = document.getElementById('total-processed-val');

  const historyTbody = document.getElementById('history-tbody');
  const emptyHistory = document.getElementById('empty-history');
  const refreshHistoryBtn = document.getElementById('refresh-history-btn');

  const userProfilePlanName = document.getElementById('user-profile-plan-name');
  const userPlanSubheading = document.getElementById('user-plan-subheading');
  const dashResetTimer = document.getElementById('dash-reset-timer');
  const vipActiveBanner = document.getElementById('vip-active-banner');
  const vipBannerPlanName = document.getElementById('vip-banner-plan-name');
  const pricingSectionTitle = document.getElementById('pricing-section-title');
  const pricingSectionSubtitle = document.getElementById('pricing-section-subtitle');
  const dashUpgradeBtnText = document.getElementById('dash-upgrade-btn-text');

  // Live midnight countdown ticker for quota reset
  function startDashCountdown() {
    function update() {
      const now = new Date();
      const midnight = new Date();
      midnight.setHours(24, 0, 0, 0);
      const diffMs = midnight.getTime() - now.getTime();
      if (diffMs <= 0) {
        if (dashResetTimer) dashResetTimer.textContent = '00h 00m 00s';
        return;
      }
      const hrs = Math.floor(diffMs / (1000 * 60 * 60));
      const mins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
      const secs = Math.floor((diffMs % (1000 * 60)) / 1000);
      const str = `${hrs.toString().padStart(2, '0')}h ${mins.toString().padStart(2, '0')}m ${secs.toString().padStart(2, '0')}s`;
      if (dashResetTimer) dashResetTimer.textContent = str;
    }
    update();
    setInterval(update, 1000);
  }
  startDashCountdown();

  async function loadDashboard() {
    try {
      const user = await getCurrentUser();
      if (!user) {
        if (loadingEl) loadingEl.style.display = 'none';
        if (unauthEl) unauthEl.style.display = 'block';
        if (contentEl) contentEl.style.display = 'none';
        return;
      }

      const profile = await getUserProfile(user.id);
      const quota = await checkDailyQuota();

      // Show content
      if (loadingEl) loadingEl.style.display = 'none';
      if (unauthEl) unauthEl.style.display = 'none';
      if (contentEl) contentEl.style.display = 'block';

      // Fill User Profile info
      const name = profile?.full_name || user.email?.split('@')[0] || 'User';
      if (displayName) displayName.textContent = name;
      if (emailText) emailText.textContent = user.email || '';
      if (avatarInitials) avatarInitials.textContent = name.charAt(0).toUpperCase();

      if (profile?.created_at && memberSince) {
        const d = new Date(profile.created_at);
        memberSince.textContent = `Member since ${d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}`;
      }

      // Determine Specific Plan Name
      let planDisplayName = 'Free Tier Member';
      if (profile?.role === 'admin') {
        planDisplayName = 'Super Admin VIP';
      } else if (profile?.subscription_plan_name) {
        planDisplayName = profile.subscription_plan_name;
      } else if (profile?.subscription_plan_id) {
        const matched = APP_CONFIG.plans.find(p => p.id === profile.subscription_plan_id);
        if (matched) planDisplayName = matched.name;
        else planDisplayName = 'Premium VIP Member';
      } else if (quota.isPremium) {
        planDisplayName = 'Premium VIP Member';
      }

      if (userProfilePlanName) userProfilePlanName.textContent = planDisplayName;

      // Check Tier & Role
      const isVip = quota.isPremium;
      if (isVip) {
        if (userPlanSubheading) userPlanSubheading.classList.add('is-vip');
        if (tierBadge) {
          tierBadge.textContent = planDisplayName.toUpperCase();
          tierBadge.classList.add('is-vip');
        }
        if (planNameVal) planNameVal.textContent = planDisplayName;
        if (dashUpgradeBtnText) dashUpgradeBtnText.textContent = 'Extend / Renew Pass';
        if (vipActiveBanner) vipActiveBanner.style.display = 'flex';
        if (vipBannerPlanName) vipBannerPlanName.textContent = planDisplayName;
        if (pricingSectionTitle) pricingSectionTitle.textContent = 'Extend / Renew VIP Pass';
        if (pricingSectionSubtitle) pricingSectionSubtitle.textContent = 'Keep your uncapped speeds, 4K streaming pipeline, and zero queue delays active';
      } else {
        if (userPlanSubheading) userPlanSubheading.classList.remove('is-vip');
        if (tierBadge) {
          tierBadge.textContent = 'FREE MEMBER (5/DAY)';
          tierBadge.classList.remove('is-vip');
        }
        if (planNameVal) planNameVal.textContent = 'Free Starter Plan';
        if (dashUpgradeBtnText) dashUpgradeBtnText.textContent = 'Buy Premium';
        if (vipActiveBanner) vipActiveBanner.style.display = 'none';
        if (pricingSectionTitle) pricingSectionTitle.textContent = 'Buy Premium Membership';
        if (pricingSectionSubtitle) pricingSectionSubtitle.textContent = 'Unlock unlimited daily downloads, 4K video player, zero ads, and maximum speeds';
      }

      if (profile?.role === 'admin') {
        if (adminBadge) adminBadge.style.display = 'inline-block';
        if (adminLink) adminLink.style.display = 'inline-flex';
      }

      // Update Quota Box
      if (isVip) {
        if (quotaUsed) quotaUsed.textContent = '∞';
        if (quotaTotal) quotaTotal.textContent = 'Unlimited Links';
        if (quotaFill) quotaFill.style.width = '100%';
        if (quotaHint) quotaHint.textContent = 'VIP active: Uncapped daily link resolution & maximum streaming pipeline.';
        if (planExpiryText) {
          if (profile?.subscription_end) {
            const exp = new Date(profile.subscription_end);
            planExpiryText.textContent = `Active until ${exp.toLocaleDateString()}`;
          } else {
            planExpiryText.textContent = 'Active & Uncapped';
          }
        }
      } else {
        const used = quota.used;
        const total = quota.limit;
        const pct = Math.min(100, Math.round((used / total) * 100));
        if (quotaUsed) quotaUsed.textContent = used.toString();
        if (quotaTotal) quotaTotal.textContent = `/ ${total} Links Today`;
        if (quotaFill) quotaFill.style.width = `${pct}%`;
        if (quotaHint) quotaHint.textContent = `${quota.remaining} links remaining today. Resets daily.`;
        if (planExpiryText) planExpiryText.textContent = 'Upgrade for unlimited links & 4K stream';
      }

      // Fetch user link history
      await loadUserHistory(user.id);
    } catch (err) {
      console.error('Failed to load dashboard:', err);
    }
  }

  async function loadUserHistory(userId: string) {
    try {
      const sb = getSupabase();
      const { data, count, error } = await sb
        .from('link_usage')
        .select('*', { count: 'exact' })
        .eq('user_id', userId)
        .order('created_at', { ascending: false })
        .limit(20);

      if (totalProcessedVal) {
        totalProcessedVal.textContent = (count || 0).toString();
      }

      if (error || !data || data.length === 0) {
        if (historyTbody) historyTbody.innerHTML = '';
        if (emptyHistory) emptyHistory.style.display = 'block';
        return;
      }

      if (emptyHistory) emptyHistory.style.display = 'none';
      if (historyTbody) {
        historyTbody.innerHTML = '';
        data.forEach((row: any) => {
          const tr = document.createElement('tr');
          const timeStr = row.created_at ? new Date(row.created_at).toLocaleString() : 'Recent';
          const isTera = (row.provider || '').toLowerCase().includes('tera');

          tr.innerHTML = `
            <td>
              <div class="table-file-title" title="${row.file_name || row.link_url}">${row.file_name || 'Processed Video File'}</div>
              <div style="font-size: 10px; color: var(--color-text-muted);">${row.file_size || ''}</div>
            </td>
            <td>
              <span class="table-platform-badge ${isTera ? 'terabox' : ''}">${row.provider || 'TeraBox'}</span>
            </td>
            <td>
              <span style="color: #34d399; font-weight: 700;">● ${row.status || 'Success'}</span>
            </td>
            <td style="font-size: 11px;">${timeStr}</td>
            <td>
              <a href="/?link=${encodeURIComponent(row.link_url)}" class="metric-link-btn" style="padding: 4px 10px; margin: 0; font-size: 11px;">
                Stream
              </a>
            </td>
          `;
          historyTbody.appendChild(tr);
        });
      }
    } catch (err) {
      console.error('Error fetching history:', err);
    }
  }

  // Event wiring
  document.getElementById('dash-login-btn')?.addEventListener('click', () => {
    window.location.href = '/login/';
  });

  document.getElementById('dash-signup-btn')?.addEventListener('click', () => {
    window.location.href = '/signup/';
  });

  signoutBtn?.addEventListener('click', async () => {
    if (confirm('Are you sure you want to sign out?')) {
      await signOutUser();
      window.location.href = '/';
    }
  });

  document.getElementById('dash-upgrade-btn')?.addEventListener('click', () => {
    window.location.href = '/pricing/';
  });

  refreshHistoryBtn?.addEventListener('click', async () => {
    const user = await getCurrentUser();
    if (user) await loadUserHistory(user.id);
  });

  // Wiring Plan Buttons in Dashboard
  document.querySelectorAll('[data-buy-plan-id]').forEach(btn => {
    btn.addEventListener('click', () => {
      const planId = btn.getAttribute('data-buy-plan-id');
      const plan = APP_CONFIG.plans.find(p => p.id === planId);
      if (!plan) return;

      startRazorpayCheckout(plan as any, {
        onSuccess: () => {
          alert('Payment Successful! Premium Activated.');
          loadDashboard();
        }
      });
    });
  });

  // Init
  loadDashboard();
  window.addEventListener('terawala:auth-changed', loadDashboard);
</script>
