---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Reset Password", href: "/reset-password/" }
];
---

<BaseLayout 
  title="Reset Your Password — TeraWala"
  description="Set a new secure password for your TeraWala video downloader account."
>
  <div class="auth-page-container">
    <div class="container container-sm">
      <Breadcrumbs items={breadcrumbs} />

      <div class="auth-page-card">
        <div class="auth-page-icon">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h1 class="auth-page-title">Set New Password</h1>
        <p class="auth-page-desc">Enter a new secure password for your TeraWala account</p>

        <div id="reset-auth-error" class="auth-alert error" style="display: none;"></div>
        <div id="reset-auth-success" class="auth-alert success" style="display: none;"></div>

        <!-- Valid Recovery Form -->
        <form id="reset-password-form" class="auth-page-form">
          <div class="form-group">
            <label for="new-password">New Password</label>
            <div class="pw-input-wrap">
              <input 
                type="password" 
                id="new-password" 
                required 
                minlength="6" 
                placeholder="At least 6 characters" 
                autocomplete="new-password" 
              />
              <button type="button" class="btn-toggle-pw" id="toggle-new-pw" aria-label="Toggle password visibility">
                👁️
              </button>
            </div>
            <div class="pw-strength-bar">
              <div id="strength-fill" class="strength-fill"></div>
            </div>
          </div>

          <div class="form-group">
            <label for="confirm-password">Confirm New Password</label>
            <input 
              type="password" 
              id="confirm-password" 
              required 
              minlength="6" 
              placeholder="Re-enter new password" 
              autocomplete="new-password" 
            />
          </div>

          <button type="submit" class="btn-auth-submit" id="reset-submit-btn">
            <span class="auth-spinner" id="reset-spinner" style="display: none;"></span>
            <span id="reset-btn-text">Update Password</span>
          </button>
        </form>

        <!-- Expired / Invalid state container -->
        <div id="expired-box" class="expired-box" style="display: none;">
          <p style="color: #fca5a5; font-size: var(--text-xs); margin-bottom: 14px;">
            This password reset link is invalid or has expired. Please request a new link from the login page.
          </p>
          <a href="/login/" class="btn-auth-submit" style="text-decoration: none; display: inline-flex;">
            Return to Sign In
          </a>
        </div>

        <div class="auth-page-switch">
          <span>Remembered your password?</span>
          <a href="/login/">Back to Sign In</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page-container {
    padding: 40px 16px 80px;
    min-height: 75vh;
  }
  .container-sm {
    max-width: 480px;
    margin: 0 auto;
  }
  .auth-page-card {
    background: linear-gradient(180deg, rgba(14, 21, 23, 0.98) 0%, rgba(8, 12, 13, 0.99) 100%);
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: var(--radius-xl);
    padding: 38px 30px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 40px rgba(16, 185, 129, 0.12);
    text-align: center;
    margin-top: 10px;
  }
  .auth-page-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .auth-page-title {
    font-size: var(--text-2xl);
    font-weight: 850;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .auth-page-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    line-height: 1.5;
  }
  .auth-alert {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: 16px;
    text-align: left;
  }
  .auth-alert.error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }
  .auth-alert.success {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
  }
  .auth-page-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group label {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--color-text-secondary);
  }
  .pw-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .pw-input-wrap input,
  .form-group input {
    width: 100%;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-sm);
    font-family: inherit;
    transition: all 0.2s;
  }
  .pw-input-wrap input {
    padding-right: 42px;
  }
  .pw-input-wrap input:focus,
  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }
  .btn-toggle-pw {
    position: absolute;
    right: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 14px;
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .btn-toggle-pw:hover {
    opacity: 1;
  }
  .pw-strength-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 99px;
    overflow: hidden;
    margin-top: 4px;
  }
  .strength-fill {
    height: 100%;
    width: 0%;
    transition: width 0.2s, background-color 0.2s;
  }
  .btn-auth-submit {
    margin-top: 8px;
    padding: 13px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
    color: #ffffff;
    font-size: var(--text-sm);
    font-weight: 750;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-auth-submit:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    transform: translateY(-1px);
  }
  .auth-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: authSpin 0.7s linear infinite;
  }
  @keyframes authSpin { to { transform: rotate(360deg); } }
  .auth-page-switch {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .auth-page-switch a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
  }
  .auth-page-switch a:hover {
    text-decoration: underline;
  }

  /* Light Theme */
  :root[data-theme="light"] .auth-page-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), 0 0 30px rgba(16, 185, 129, 0.08) !important;
  }
  :root[data-theme="light"] .auth-page-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .auth-page-desc {
    color: #64748b !important;
  }
  :root[data-theme="light"] .form-group label {
    color: #334155 !important;
  }
  :root[data-theme="light"] .pw-input-wrap input,
  :root[data-theme="light"] .form-group input {
    background: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }
</style>

<script>
  import { getSupabase, updateUserPassword } from '../utils/supabase';

  const form = document.getElementById('reset-password-form') as HTMLFormElement | null;
  const newPwInput = document.getElementById('new-password') as HTMLInputElement | null;
  const confirmPwInput = document.getElementById('confirm-password') as HTMLInputElement | null;
  const submitBtn = document.getElementById('reset-submit-btn') as HTMLButtonElement | null;
  const spinner = document.getElementById('reset-spinner');
  const btnText = document.getElementById('reset-btn-text');
  const errBox = document.getElementById('reset-auth-error');
  const succBox = document.getElementById('reset-auth-success');
  const strengthFill = document.getElementById('strength-fill');
  const toggleBtn = document.getElementById('toggle-new-pw');
  const expiredBox = document.getElementById('expired-box');

  const sb = getSupabase();

  // Show/Hide password toggle
  toggleBtn?.addEventListener('click', () => {
    if (!newPwInput) return;
    const isPw = newPwInput.type === 'password';
    newPwInput.type = isPw ? 'text' : 'password';
    if (confirmPwInput) confirmPwInput.type = isPw ? 'text' : 'password';
  });

  // Password strength meter
  newPwInput?.addEventListener('input', () => {
    const val = newPwInput.value;
    if (!strengthFill) return;
    let score = 0;
    if (val.length >= 6) score += 25;
    if (val.length >= 10) score += 25;
    if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score += 25;
    if (/[0-9]/.test(val) || /[^A-Za-z0-9]/.test(val)) score += 25;

    strengthFill.style.width = score + '%';
    if (score <= 25) {
      strengthFill.style.background = '#ef4444';
    } else if (score <= 50) {
      strengthFill.style.background = '#f59e0b';
    } else if (score <= 75) {
      strengthFill.style.background = '#3b82f6';
    } else {
      strengthFill.style.background = '#10b981';
    }
  });

  // Supabase recovery session listener
  let isRecoverySession = false;

  sb.auth.onAuthStateChange(async (event, session) => {
    if (event === 'PASSWORD_RECOVERY') {
      isRecoverySession = true;
    }
  });

  // Check if hash has access_token or type=recovery
  const hash = window.location.hash;
  if (hash && (hash.includes('type=recovery') || hash.includes('access_token'))) {
    isRecoverySession = true;
  }

  // Also check if active user session is present
  sb.auth.getSession().then(({ data: { session } }) => {
    if (session) {
      isRecoverySession = true;
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!newPwInput || !confirmPwInput) return;

    if (errBox) errBox.style.display = 'none';
    if (succBox) succBox.style.display = 'none';

    const pw = newPwInput.value;
    const confirmPw = confirmPwInput.value;

    if (pw.length < 6) {
      if (errBox) {
        errBox.textContent = 'Password must be at least 6 characters long.';
        errBox.style.display = 'block';
      }
      return;
    }

    if (pw !== confirmPw) {
      if (errBox) {
        errBox.textContent = 'Passwords do not match. Please re-enter both.';
        errBox.style.display = 'block';
      }
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (spinner) spinner.style.display = 'inline-block';
    if (btnText) btnText.textContent = 'Updating...';

    try {
      await updateUserPassword(pw);

      if (succBox) {
        succBox.textContent = '✨ Password successfully updated! Redirecting to login...';
        succBox.style.display = 'block';
      }

      form.reset();
      if (strengthFill) strengthFill.style.width = '0%';

      setTimeout(() => {
        window.location.href = '/login/?reset=success';
      }, 1500);
    } catch (err: any) {
      if (errBox) {
        errBox.textContent = err.message || 'Failed to update password. Recovery link may have expired.';
        errBox.style.display = 'block';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (spinner) spinner.style.display = 'none';
      if (btnText) btnText.textContent = 'Update Password';
    }
  });
</script>
