---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Sign In", href: "/login/" }
];
---

<BaseLayout 
  title="Sign In to TeraWala — Video Downloader & Online Player"
  description="Sign in to your TeraWala account to track link usage, view resolution history, and manage your Premium membership."
>
  <div class="auth-page-container">
    <div class="container container-sm">
      <Breadcrumbs items={breadcrumbs} />

      <div class="auth-page-card">
        <div class="auth-page-icon">
          <img src="/logo.svg" alt="TeraWala Logo" width="48" height="48" class="auth-brand-logo-img" />
        </div>
        <h1 class="auth-page-title">Sign In to TeraWala</h1>
        <p class="auth-page-desc">Enter your credentials to access your daily quota and Premium features</p>

        <div id="page-auth-error" class="auth-alert error" style="display: none;"></div>
        <div id="page-auth-success" class="auth-alert success" style="display: none;"></div>

        <form id="page-login-form" class="auth-page-form">
          <div class="form-group">
            <label for="page-email">Email Address</label>
            <input type="email" id="page-email" required placeholder="you@example.com" autocomplete="email" />
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="page-password">Password</label>
              <a href="#" id="page-forgot-btn">Forgot?</a>
            </div>
            <input type="password" id="page-password" required placeholder="••••••••" autocomplete="current-password" />
          </div>

          <button type="submit" class="btn-auth-submit" id="page-submit-btn">
            <span class="auth-spinner" id="page-spinner" style="display: none;"></span>
            <span id="page-btn-text">Sign In</span>
          </button>
        </form>

        <div class="auth-page-switch">
          <span>Don't have an account?</span>
          <a href="/signup/">Create one for free</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page-container {
    padding: 40px 16px 80px;
    min-height: 75vh;
  }
  .container-sm {
    max-width: 480px;
    margin: 0 auto;
  }
  .auth-page-card {
    background: linear-gradient(180deg, rgba(14, 21, 23, 0.98) 0%, rgba(8, 12, 13, 0.99) 100%);
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: var(--radius-xl);
    padding: 38px 30px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 40px rgba(16, 185, 129, 0.12);
    text-align: center;
    margin-top: 10px;
  }
  .auth-page-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .auth-page-title {
    font-size: var(--text-2xl);
    font-weight: 850;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .auth-page-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    line-height: 1.5;
  }
  .auth-alert {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: 16px;
    text-align: left;
  }
  .auth-alert.error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }
  .auth-alert.success {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
  }
  .auth-page-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group label {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--color-text-secondary);
  }
  .label-row {
    display: flex;
    justify-content: space-between;
  }
  .label-row a {
    font-size: 11px;
    color: var(--color-primary);
    text-decoration: none;
  }
  .form-group input {
    width: 100%;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-sm);
    font-family: inherit;
    transition: all 0.2s;
  }
  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }
  .btn-auth-submit {
    margin-top: 8px;
    padding: 13px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
    color: #ffffff;
    font-size: var(--text-sm);
    font-weight: 750;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-auth-submit:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    transform: translateY(-1px);
  }
  .auth-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: authSpin 0.7s linear infinite;
  }
  @keyframes authSpin { to { transform: rotate(360deg); } }
  .auth-page-switch {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .auth-page-switch a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
  }
  .auth-page-switch a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .auth-page-section {
      padding: 20px 12px 60px;
    }
    .auth-page-card {
      padding: 24px 16px 20px;
      border-radius: var(--radius-lg);
    }
    .auth-page-title {
      font-size: 1.45rem;
    }
    .form-group input {
      font-size: 16px !important;
      height: 48px;
    }
    .btn-auth-submit {
      min-height: 48px;
      font-size: 15px;
    }
  }

  /* Light Mode Styling for Login Page */
  :root[data-theme="light"] .auth-page-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), 0 0 30px rgba(16, 185, 129, 0.08) !important;
  }
  :root[data-theme="light"] .auth-page-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .auth-page-desc {
    color: #64748b !important;
  }
  :root[data-theme="light"] .form-group label {
    color: #334155 !important;
  }
  :root[data-theme="light"] .form-group input {
    background: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }
  :root[data-theme="light"] .form-group input:focus {
    background: #ffffff !important;
    border-color: #10b981 !important;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15) !important;
  }
  :root[data-theme="light"] .auth-page-switch {
    border-top-color: #e2e8f0 !important;
    color: #64748b !important;
  }
</style>

<script>
  import { signInWithEmail, getCurrentUser } from '../utils/supabase';

  const urlParams = new URLSearchParams(window.location.search);
  const targetUrl = urlParams.get('redirect') || '/dashboard/';

  // Preserve redirect query parameter for signup link
  const signupLink = document.querySelector('.auth-page-switch a');
  if (urlParams.get('redirect') && signupLink) {
    signupLink.setAttribute('href', `/signup/?redirect=${encodeURIComponent(targetUrl)}`);
  }

  // If already logged in, redirect straight to target
  getCurrentUser().then(user => {
    if (user) window.location.href = targetUrl;
  });

  const form = document.getElementById('page-login-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('page-email') as HTMLInputElement | null;
  const pwInput = document.getElementById('page-password') as HTMLInputElement | null;
  const submitBtn = document.getElementById('page-submit-btn') as HTMLButtonElement | null;
  const spinner = document.getElementById('page-spinner');
  const btnText = document.getElementById('page-btn-text');
  const errBox = document.getElementById('page-auth-error');
  const succBox = document.getElementById('page-auth-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!emailInput || !pwInput) return;

    if (errBox) errBox.style.display = 'none';
    if (succBox) succBox.style.display = 'none';

    if (submitBtn) submitBtn.disabled = true;
    if (spinner) spinner.style.display = 'inline-block';

    try {
      await signInWithEmail(emailInput.value.trim(), pwInput.value);
      if (succBox) {
        succBox.textContent = 'Signed in successfully! Redirecting...';
        succBox.style.display = 'block';
      }
      setTimeout(() => {
        window.location.href = targetUrl;
      }, 600);
    } catch (err: any) {
      if (errBox) {
        errBox.textContent = err.message || 'Invalid email or password.';
        errBox.style.display = 'block';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (spinner) spinner.style.display = 'none';
    }
  });
</script>
