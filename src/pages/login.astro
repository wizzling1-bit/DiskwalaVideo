---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Sign In", href: "/login/" }
];
---

<BaseLayout 
  title="Sign In to TeraWala — Video Downloader & Online Player"
  description="Sign in to your TeraWala account to track link usage, view resolution history, and manage your Premium membership."
  includeTurnstile={true}
>
  <div class="auth-page-container">
    <div class="container container-sm">
      <Breadcrumbs items={breadcrumbs} />

      <div class="auth-page-card">
        <div class="auth-page-icon">
          <img src="/logo.svg" alt="TeraWala Logo" width="48" height="48" class="auth-brand-logo-img" />
        </div>
        <h1 class="auth-page-title" id="auth-title">Sign In to TeraWala</h1>
        <p class="auth-page-desc" id="auth-desc">Enter your credentials to access your daily quota and Premium features</p>

        <div id="page-auth-error" class="auth-alert error" style="display: none;"></div>
        <div id="page-auth-success" class="auth-alert success" style="display: none;"></div>

        <!-- Main Sign In Form -->
        <form id="page-login-form" class="auth-page-form">
          <div class="form-group">
            <label for="page-email">Email Address</label>
            <input type="email" id="page-email" required placeholder="you@example.com" autocomplete="email" />
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="page-password">Password</label>
              <a href="javascript:void(0)" id="page-forgot-btn">Forgot?</a>
            </div>
            <input type="password" id="page-password" required placeholder="••••••••" autocomplete="current-password" />
          </div>

          <!-- Cloudflare Turnstile Verification -->
          <div id="login-turnstile-container" style="display: flex; justify-content: center; margin: 16px 0; min-height: 65px;"></div>

          <button type="submit" class="btn-auth-submit" id="page-submit-btn">
            <span class="auth-spinner" id="page-spinner" style="display: none;"></span>
            <span id="page-btn-text">Sign In</span>
          </button>
        </form>

        <!-- Forgot Password Form -->
        <form id="page-forgot-form" class="auth-page-form" style="display: none;">
          <div class="form-group">
            <label for="forgot-email">Account Email Address</label>
            <input type="email" id="forgot-email" required placeholder="you@example.com" autocomplete="email" />
          </div>

          <button type="submit" class="btn-auth-submit" id="forgot-submit-btn">
            <span class="auth-spinner" id="forgot-spinner" style="display: none;"></span>
            <span id="forgot-btn-text">Send Password Reset Link</span>
          </button>

          <button type="button" class="btn-auth-back" id="btn-back-to-login">
            ← Back to Sign In
          </button>
        </form>

        <div class="auth-page-switch" id="auth-switch-box">
          <span>Don't have an account?</span>
          <a href="/signup/">Create one for free</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page-container {
    padding: 40px 16px 80px;
    min-height: 75vh;
  }
  .container-sm {
    max-width: 480px;
    margin: 0 auto;
  }
  .auth-page-card {
    background: linear-gradient(180deg, rgba(14, 21, 23, 0.98) 0%, rgba(8, 12, 13, 0.99) 100%);
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: var(--radius-xl);
    padding: 38px 30px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 40px rgba(16, 185, 129, 0.12);
    text-align: center;
    margin-top: 10px;
  }
  .auth-page-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .auth-page-title {
    font-size: var(--text-2xl);
    font-weight: 850;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .auth-page-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    line-height: 1.5;
  }
  .auth-alert {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: 16px;
    text-align: left;
  }
  .auth-alert.error {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #fca5a5;
  }
  .auth-alert.success {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #6ee7b7;
  }
  .auth-page-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-align: left;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-group label {
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--color-text-secondary);
  }
  .label-row {
    display: flex;
    justify-content: space-between;
  }
  .label-row a {
    font-size: 11px;
    color: var(--color-primary);
    text-decoration: none;
  }
  .form-group input {
    width: 100%;
    padding: 12px 14px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-sm);
    font-family: inherit;
    transition: all 0.2s;
  }
  .form-group input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }
  .btn-auth-submit {
    margin-top: 8px;
    padding: 13px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
    color: #ffffff;
    font-size: var(--text-sm);
    font-weight: 750;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-auth-submit:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    transform: translateY(-1px);
  }
  .auth-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: authSpin 0.7s linear infinite;
  }
  @keyframes authSpin { to { transform: rotate(360deg); } }
  .auth-page-switch {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    display: flex;
    justify-content: center;
    gap: 6px;
  }
  .auth-page-switch a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
  }
  .auth-page-switch a:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .auth-page-section {
      padding: 20px 12px 60px;
    }
    .auth-page-card {
      padding: 24px 16px 20px;
      border-radius: var(--radius-lg);
    }
    .auth-page-title {
      font-size: 1.45rem;
    }
    .form-group input {
      font-size: 16px !important;
      height: 48px;
    }
    .btn-auth-submit {
      min-height: 48px;
      font-size: 15px;
    }
  }

  /* Light Mode Styling for Login Page */
  :root[data-theme="light"] .auth-page-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.06), 0 0 30px rgba(16, 185, 129, 0.08) !important;
  }
  :root[data-theme="light"] .auth-page-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .auth-page-desc {
    color: #64748b !important;
  }
  :root[data-theme="light"] .form-group label {
    color: #334155 !important;
  }
  :root[data-theme="light"] .form-group input {
    background: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }
  :root[data-theme="light"] .form-group input:focus {
    background: #ffffff !important;
    border-color: #10b981 !important;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15) !important;
  }
  :root[data-theme="light"] .auth-page-switch {
    border-top-color: #e2e8f0 !important;
    color: #64748b !important;
  }
  .btn-auth-back {
    margin-top: 4px;
    padding: 12px;
    border-radius: var(--radius-md);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-auth-back:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }
  :root[data-theme="light"] .btn-auth-back {
    border-color: #cbd5e1 !important;
    color: #475569 !important;
  }
  :root[data-theme="light"] .btn-auth-back:hover {
    background: #f1f5f9 !important;
    color: #0f172a !important;
  }
</style>

<script>
  import { signInWithEmail, getCurrentUser, sendPasswordResetEmail } from '../utils/supabase';
  import { APP_CONFIG } from '../utils/config';
  import { verifyTurnstileToken } from '../utils/security';

  const urlParams = new URLSearchParams(window.location.search);
  const targetUrl = urlParams.get('redirect') || '/dashboard/';

  const succBox = document.getElementById('page-auth-success');
  const errBox = document.getElementById('page-auth-error');

  // Cloudflare Turnstile explicit rendering
  let loginTurnstileWidgetId: any = null;
  function initLoginTurnstile() {
    const container = document.getElementById('login-turnstile-container');
    if (!container || loginTurnstileWidgetId !== null) return;
    const turnstileObj = (window as any).turnstile;
    if (turnstileObj && typeof turnstileObj.render === 'function') {
      try {
        loginTurnstileWidgetId = turnstileObj.render(container, {
          sitekey: APP_CONFIG.turnstile?.siteKey || '1x00000000000000000000AA',
          theme: 'dark'
        });
      } catch (err) {
        console.warn('Turnstile render warning:', err);
      }
    }
  }

  if (typeof window !== 'undefined') {
    if ((window as any).turnstile) {
      initLoginTurnstile();
    } else {
      const turnstilePoll = setInterval(() => {
        if ((window as any).turnstile) {
          clearInterval(turnstilePoll);
          initLoginTurnstile();
        }
      }, 250);
      setTimeout(() => clearInterval(turnstilePoll), 6000);
    }
  }

  // Check if reset was successful
  if (urlParams.get('reset') === 'success' && succBox) {
    succBox.textContent = '✅ Your password has been successfully reset! Please sign in with your new password.';
    succBox.style.display = 'block';
  }

  // Preserve redirect query parameter for signup link
  const signupLink = document.querySelector('.auth-page-switch a');
  if (urlParams.get('redirect') && signupLink) {
    signupLink.setAttribute('href', `/signup/?redirect=${encodeURIComponent(targetUrl)}`);
  }

  // If already logged in, redirect straight to target
  getCurrentUser().then(user => {
    if (user) window.location.href = targetUrl;
  });

  const loginForm = document.getElementById('page-login-form') as HTMLFormElement | null;
  const forgotForm = document.getElementById('page-forgot-form') as HTMLFormElement | null;
  const forgotBtn = document.getElementById('page-forgot-btn');
  const backToLoginBtn = document.getElementById('btn-back-to-login');

  const authTitle = document.getElementById('auth-title');
  const authDesc = document.getElementById('auth-desc');
  const authSwitchBox = document.getElementById('auth-switch-box');

  const emailInput = document.getElementById('page-email') as HTMLInputElement | null;
  const pwInput = document.getElementById('page-password') as HTMLInputElement | null;
  const submitBtn = document.getElementById('page-submit-btn') as HTMLButtonElement | null;
  const spinner = document.getElementById('page-spinner');

  const forgotEmailInput = document.getElementById('forgot-email') as HTMLInputElement | null;
  const forgotSubmitBtn = document.getElementById('forgot-submit-btn') as HTMLButtonElement | null;
  const forgotSpinner = document.getElementById('forgot-spinner');
  const forgotBtnText = document.getElementById('forgot-btn-text');

  // Toggle to Forgot Password Form
  forgotBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    if (errBox) errBox.style.display = 'none';
    if (succBox) succBox.style.display = 'none';

    if (loginForm) loginForm.style.display = 'none';
    if (forgotForm) forgotForm.style.display = 'flex';
    if (authSwitchBox) authSwitchBox.style.display = 'none';

    if (authTitle) authTitle.textContent = 'Reset Password';
    if (authDesc) authDesc.textContent = 'Enter your registered email address and we will send you a password recovery link.';

    if (emailInput && forgotEmailInput && emailInput.value.trim()) {
      forgotEmailInput.value = emailInput.value.trim();
    }
    forgotEmailInput?.focus();
  });

  // Toggle back to Login Form
  backToLoginBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    if (errBox) errBox.style.display = 'none';
    if (succBox) succBox.style.display = 'none';

    if (forgotForm) forgotForm.style.display = 'none';
    if (loginForm) loginForm.style.display = 'flex';
    if (authSwitchBox) authSwitchBox.style.display = 'flex';

    if (authTitle) authTitle.textContent = 'Sign In to TeraWala';
    if (authDesc) authDesc.textContent = 'Enter your credentials to access your daily quota and Premium features';
  });

  // Handle Login submission
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!emailInput || !pwInput) return;

    if (errBox) errBox.style.display = 'none';
    if (succBox) succBox.style.display = 'none';

    // Verify Cloudflare Turnstile token
    const turnstileObj = (window as any).turnstile;
    if (turnstileObj && loginTurnstileWidgetId !== null) {
      const token = turnstileObj.getResponse(loginTurnstileWidgetId);
      if (!token) {
        if (errBox) {
          errBox.textContent = 'Please complete the Cloudflare security verification to sign in.';
          errBox.style.display = 'block';
        }
        return;
      }

      // Verify token on server-side
      const isTokenValid = await verifyTurnstileToken(token);
      if (!isTokenValid) {
        if (errBox) {
          errBox.textContent = 'Cloudflare security challenge verification failed. Please try again.';
          errBox.style.display = 'block';
        }
        try { turnstileObj.reset(loginTurnstileWidgetId); } catch {}
        return;
      }
    }

    if (submitBtn) submitBtn.disabled = true;
    if (spinner) spinner.style.display = 'inline-block';

    try {
      await signInWithEmail(emailInput.value.trim(), pwInput.value);
      if (succBox) {
        succBox.textContent = 'Signed in successfully! Redirecting...';
        succBox.style.display = 'block';
      }
      setTimeout(() => {
        window.location.href = targetUrl;
      }, 600);
    } catch (err: any) {
      if (errBox) {
        errBox.textContent = err.message || 'Invalid email or password.';
        errBox.style.display = 'block';
      }
      if (turnstileObj && loginTurnstileWidgetId !== null) {
        try { turnstileObj.reset(loginTurnstileWidgetId); } catch {}
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (spinner) spinner.style.display = 'none';
    }
  });

  // Handle Forgot Password submission
  forgotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!forgotEmailInput) return;

    const email = forgotEmailInput.value.trim();
    if (!email) return;

    if (errBox) errBox.style.display = 'none';
    if (succBox) succBox.style.display = 'none';

    if (forgotSubmitBtn) forgotSubmitBtn.disabled = true;
    if (forgotSpinner) forgotSpinner.style.display = 'inline-block';
    if (forgotBtnText) forgotBtnText.textContent = 'Sending Link...';

    try {
      await sendPasswordResetEmail(email);
      if (succBox) {
        succBox.textContent = `✨ Password reset email sent to ${email}! Check your inbox and spam folder for instructions.`;
        succBox.style.display = 'block';
      }

      // 60-second cooldown on resending
      let cooldown = 60;
      if (forgotBtnText) forgotBtnText.textContent = `Resend in ${cooldown}s`;
      const timer = setInterval(() => {
        cooldown--;
        if (cooldown <= 0) {
          clearInterval(timer);
          if (forgotSubmitBtn) forgotSubmitBtn.disabled = false;
          if (forgotBtnText) forgotBtnText.textContent = 'Send Password Reset Link';
        } else if (forgotBtnText) {
          forgotBtnText.textContent = `Resend in ${cooldown}s`;
        }
      }, 1000);
    } catch (err: any) {
      if (forgotSubmitBtn) forgotSubmitBtn.disabled = false;
      if (forgotBtnText) forgotBtnText.textContent = 'Send Password Reset Link';
      if (errBox) {
        errBox.textContent = err.message || 'Could not send reset email. Please verify the address and try again.';
        errBox.style.display = 'block';
      }
    } finally {
      if (forgotSpinner) forgotSpinner.style.display = 'none';
    }
  });
</script>
