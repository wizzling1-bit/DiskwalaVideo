---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_CONFIG } from '../utils/config';
---

<BaseLayout 
  title="404 — Page Not Found | Diskwala Video Downloader" 
  description="The requested page could not be found. Head back to Diskwala Video Downloader to check, stream, or download video links."
  canonicalUrl="https://diskwalavideodownloader.com/404"
>
  <section class="error-404-section">
    <div class="container container-hero">
      <div class="error-card card-obsidian">
        <div class="error-badge">
          <span class="error-code">404</span>
          <span class="error-dot"></span>
          <span class="error-label">PAGE NOT FOUND</span>
        </div>

        <h1 class="error-title">
          Lost in the <span class="text-gradient-green">Cloud Stream?</span>
        </h1>

        <p class="error-desc">
          The link or route you followed does not exist. Jump back to the homepage to check links, watch previews, or access our official Telegram bot.
        </p>

        <div class="error-actions">
          <a href="/" class="btn-primary">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <polygon points="6 4 19 12 6 20 6 4"></polygon>
            </svg>
            <span>Back to Downloader</span>
          </a>

          <a 
            href={APP_CONFIG.telegramBotUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-secondary"
          >
            <span>Open Telegram Bot</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-404-section {
    padding: 80px 0 100px;
    min-height: calc(100vh - 280px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-card {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
    padding: 56px 40px;
    background: linear-gradient(180deg, rgba(16, 22, 24, 0.92) 0%, rgba(9, 12, 14, 0.98) 100%);
    border: 1px solid rgba(16, 185, 129, 0.2);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 40px rgba(16, 185, 129, 0.08);
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    margin-bottom: 24px;
  }

  .error-code {
    font-weight: 850;
    color: var(--color-primary);
    font-size: var(--text-sm);
  }

  .error-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
  }

  .error-label {
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.7);
  }

  .error-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 850;
    line-height: 1.2;
    margin-bottom: 16px;
    letter-spacing: -0.025em;
  }

  .error-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.65;
    max-width: 520px;
    margin: 0 auto 36px;
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .error-404-section {
      padding: 40px 0 60px;
    }

    .error-card {
      padding: 36px 20px;
    }

    .error-actions {
      flex-direction: column;
      width: 100%;
    }

    .error-actions a {
      width: 100%;
    }
  }
</style>
