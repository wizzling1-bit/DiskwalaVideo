  }
  :root[data-theme="light"] .search-input,
  :root[data-theme="light"] .setting-input,
  :root[data-theme="light"] .setting-number-input,
  :root[data-theme="light"] .setting-text-input,
  :root[data-theme="light"] .setting-textarea {
