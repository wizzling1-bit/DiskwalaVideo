    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.06) !important;
  }
  :root[data-theme="light"] .table-card-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .admin-data-table th {
    border-bottom-color: #e2e8f0 !important;
