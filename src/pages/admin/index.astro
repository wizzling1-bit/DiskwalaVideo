        const currLimit = btn.getAttribute('data-current-limit') || '5';
        const input = prompt('Enter new daily free link limit:', currLimit);
        if (input !== null) {
          const num = parseInt(input, 10);
          if (isNaN(num) || num < 0) return showAdminToast('Invalid quota number entered.', true);

          try {
            await sb.rpc('admin_update_user', {
              target_user_id: userId,
              new_role: null,
              new_tier: null,
              new_daily_limit: num
            });
            showAdminToast(`Daily link limit set to ${num} links/day`);
            await loadUsers();
          } catch (err: any) {
            showAdminToast('Error updating limit: ' + err.message, true);
          }
        }
      });
    });

    // Delete User
    document.querySelectorAll('[data-delete-user]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-delete-user');
        const userEmail = btn.getAttribute('data-user-email') || 'this user';

        if (currentAdminUser && currentAdminUser.id === userId) {
          showAdminToast('You cannot delete your own logged-in admin account.', true);
          return;
        }

        if (!confirm(`Are you sure you want to permanently delete user account "${userEmail}"?\n\nThis will remove their profile and all associated data.`)) {
          return;
        }

        try {
          // Attempt clean up of any associated link usage records
          try {
            await sb.from('link_usage').delete().eq('user_id', userId);
          } catch (e) {}

          const { error } = await sb.from('profiles').delete().eq('id', userId);
          if (error) throw error;

          showAdminToast(`User account ${userEmail} permanently deleted.`);
          allUsersList = allUsersList.filter(u => u.id !== userId);
          if (admTotalUsers) {
            const count = parseInt(admTotalUsers.textContent || '0', 10);
            if (count > 0) admTotalUsers.textContent = (count - 1).toString();
          }
          renderUsers(allUsersList);
        } catch (err: any) {
          console.error('Delete user error:', err);
          showAdminToast('Failed to delete user: ' + (err.message || 'Unknown error'), true);
        }
      });
    });
  }

