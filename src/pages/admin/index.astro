  /* Settings Grid */
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .settings-card {
    background: rgba(11, 17, 19, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .settings-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .settings-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .setting-input-row {
    display: flex;
    gap: 10px;
  }
  .setting-input-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .setting-number-input,
  .setting-text-input {
    flex: 1;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-sm);
  }
  .setting-textarea {
    width: 100%;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-xs);
    resize: vertical;
  }
  .btn-save-setting {
    padding: 10px 16px;
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 750;
    cursor: pointer;
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .admin-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .admin-topbar {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 16px;
    }
    .topbar-right {
      justify-content: space-between;
      width: 100%;
    }
    .admin-tabs-nav {
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .admin-tabs-nav::-webkit-scrollbar {
      display: none;
    }
    .admin-tab-btn {
      white-space: nowrap;
      flex-shrink: 0;
      padding: 8px 14px;
    }
    .table-card-header {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .table-actions {
      flex-direction: column;
      width: 100%;
    }
    .search-input {
      width: 100%;
    }
    .setting-input-row {
      flex-direction: column;
    }
    .btn-save-setting {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .admin-metrics-grid {
      grid-template-columns: 1fr;
    }
    .table-card {
      padding: 16px 12px;
    }
    .table-responsive {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 0 -4px;
    }
    .admin-data-table {
      min-width: 580px;
    }
    .admin-data-table th, .admin-data-table td {
      padding: 10px 8px;
    }
  }

  @media (max-width: 480px) {
    .admin-console-section {
      padding: 16px 10px 40px;
    }
    .admin-gate-card {
      padding: 24px 14px 20px;
      border-radius: var(--radius-lg);
    }
    .admin-gate-title {
      font-size: 1.4rem;
    }
    .gate-input {
      font-size: 16px !important;
      height: 48px;
    }
    .gate-submit-btn {
      min-height: 48px;
      font-size: 15px;
    }
    .admin-topbar {
      padding: 12px 14px;
      border-radius: var(--radius-lg);
    }
    .topbar-title {
      font-size: 1.15rem;
    }
  }

  /* Light Mode Styling for Admin Console */
  :root[data-theme="light"] .admin-topbar {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important;
  }
  :root[data-theme="light"] .topbar-title {
