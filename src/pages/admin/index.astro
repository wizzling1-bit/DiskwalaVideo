<script>
  import { getCurrentUser, getUserProfile, getSupabase, signOutUser } from '../../utils/supabase';
  import { APP_CONFIG } from '../../utils/config';

  const checkingEl = document.getElementById('admin-auth-checking');
  const gateCard = document.getElementById('admin-gate-card');
  const gateMsg = document.getElementById('admin-gate-msg');
  const mainPanel = document.getElementById('admin-main-panel');
  const errorBanner = document.getElementById('gate-error-banner');

  const admTotalUsers = document.getElementById('adm-total-users');
  const admVipUsers = document.getElementById('adm-vip-users');
  const admTotalLinks = document.getElementById('adm-total-links');
  const admTodayLinks = document.getElementById('adm-today-links');
  const admTotalRev = document.getElementById('adm-total-rev');

  const usersTbody = document.getElementById('admin-users-tbody');
  const paymentsTbody = document.getElementById('admin-payments-tbody');
  const linksTbody = document.getElementById('admin-links-tbody');

  // Viral TeraBox Hub Elements
  const tbvStatTotal = document.getElementById('tbv-stat-total');
  const tbvStatTrending = document.getElementById('tbv-stat-trending');
  const tbvStatViews = document.getElementById('tbv-stat-views');
  const tbvStatHd = document.getElementById('tbv-stat-hd');
  const tbvVideosTbody = document.getElementById('tbv-videos-tbody');
  const tbvTableCountSub = document.getElementById('tbv-table-count-sub');

  const tbvBulkForm = document.getElementById('tbv-bulk-form') as HTMLFormElement | null;
  const tbvBulkTextarea = document.getElementById('tbv-bulk-textarea') as HTMLTextAreaElement | null;
  const tbvBulkCategory = document.getElementById('tbv-bulk-category') as HTMLSelectElement | null;
  const tbvBulkQuality = document.getElementById('tbv-bulk-quality') as HTMLSelectElement | null;
  const tbvBulkImportBtn = document.getElementById('tbv-bulk-import-btn') as HTMLButtonElement | null;
  const tbvBulkResolveBtn = document.getElementById('tbv-bulk-resolve-btn') as HTMLButtonElement | null;
  const tbvBulkProgress = document.getElementById('tbv-bulk-progress');
  const tbvProgressBar = document.getElementById('tbv-progress-bar');
  const tbvProgressText = document.getElementById('tbv-progress-text');

  const tbvSingleForm = document.getElementById('tbv-single-form') as HTMLFormElement | null;
  const tbvSingleUrl = document.getElementById('tbv-single-url') as HTMLInputElement | null;
  const tbvSingleFetchBtn = document.getElementById('tbv-single-fetch-btn') as HTMLButtonElement | null;
  const tbvSingleTitle = document.getElementById('tbv-single-title') as HTMLInputElement | null;
  const tbvSingleThumb = document.getElementById('tbv-single-thumb') as HTMLInputElement | null;
  const tbvSingleQuality = document.getElementById('tbv-single-quality') as HTMLSelectElement | null;
  const tbvSingleCategory = document.getElementById('tbv-single-category') as HTMLSelectElement | null;
  const tbvSingleDuration = document.getElementById('tbv-single-duration') as HTMLInputElement | null;
  const tbvSingleSize = document.getElementById('tbv-single-size') as HTMLInputElement | null;
  const tbvSingleSubmitBtn = document.getElementById('tbv-single-submit-btn') as HTMLButtonElement | null;

  const tbvSearchInput = document.getElementById('tbv-search-input') as HTMLInputElement | null;
  const tbvCategoryFilter = document.getElementById('tbv-category-filter') as HTMLSelectElement | null;

  let allUsersList: any[] = [];
  let allTeraboxVideos: any[] = [];

  const DEFAULT_VIDEO_THUMBNAIL = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" fill="%230e1517"><rect width="100%" height="100%" fill="%23090e10"/><circle cx="320" cy="180" r="44" fill="%2310b981" fill-opacity="0.18"/><polygon points="310,162 338,180 310,198" fill="%2310b981"/><text x="320" y="250" text-anchor="middle" fill="%23718096" font-family="sans-serif" font-size="14" font-weight="600">TeraBox Video Preview</text></svg>';

  async function checkAdminState() {
    try {
      const user = await getCurrentUser();
      if (!user) {
        showGate('Please sign in with administrator credentials.');
        return;
      }

      const profile = await getUserProfile(user.id);
      if (!profile || profile.role !== 'admin') {
        showGate('Access Denied: Your account does not have administrator privileges.');
        return;
      }

      // User is verified admin!
      if (checkingEl) checkingEl.style.display = 'none';
      if (gateCard) gateCard.style.display = 'none';
      if (mainPanel) mainPanel.style.display = 'block';

      const emailPill = document.getElementById('adm-current-user-email');
      if (emailPill && user.email) {
        emailPill.textContent = user.email;
      }

      await loadAdminData();
    } catch (err) {
      console.error('Error verifying admin:', err);
      showGate('Error checking admin session.');
    }
  }

  // Theme toggle button handler
  const adminThemeToggle = document.getElementById('admin-theme-toggle');
  if (adminThemeToggle) {
    adminThemeToggle.addEventListener('click', () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light';
      const nextTheme = isLight ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', nextTheme);
      try { localStorage.setItem('theme', nextTheme); } catch {}
    });
  }

  function showGate(message: string) {
    if (checkingEl) checkingEl.style.display = 'none';
    if (gateCard) gateCard.style.display = 'block';
    if (mainPanel) mainPanel.style.display = 'none';
    if (gateMsg) gateMsg.textContent = message;
  }

  async function loadAdminData() {
    const sb = getSupabase();

    // 1. Fetch Overview Stats via RPC
    try {
      const { data: stats, error } = await sb.rpc('get_admin_stats');
      if (!error && stats) {
        if (admTotalUsers) admTotalUsers.textContent = (stats.total_users || 0).toString();
        if (admVipUsers) admVipUsers.textContent = (stats.premium_users || 0).toString();
        if (admTotalLinks) admTotalLinks.textContent = (stats.total_links || 0).toString();
        if (admTodayLinks) admTodayLinks.textContent = `${stats.today_links || 0} processed today`;
        if (admTotalRev) admTotalRev.textContent = `₹${stats.total_revenue || 0}`;
      }
    } catch (err) {
      console.warn('Stats RPC error:', err);
    }

    // 2. Load Users
    await loadUsers();

    // 3. Load Payments
    await loadPayments();

    // 4. Load Links
    await loadLinks();

    // 5. Load Settings
    await loadSettings();

    // 6. Load Viral TeraBox Videos Catalog
    await loadTeraboxVideos();
  }

  async function loadUsers() {
    const sb = getSupabase();
    const { data, error } = await sb.from('profiles').select('*').order('created_at', { ascending: false }).limit(50);
    if (!error && data) {
      allUsersList = data;
      renderUsers(allUsersList);
      if (admVipUsers) {
        const vipCount = allUsersList.filter(u => u.subscription_tier === 'premium' || u.subscription_tier === 'vip' || u.role === 'admin').length;
        if (vipCount > 0 && parseInt(admVipUsers.textContent || '0', 10) === 0) {
          admVipUsers.textContent = vipCount.toString();
        }
      }
    }
  }

  function renderUsers(users: any[]) {
    if (!usersTbody) return;
    usersTbody.innerHTML = '';

    if (users.length === 0) {
      usersTbody.innerHTML = `
        <tr>
          <td colspan="6">
            <div class="tbl-empty-state">
              <div class="tbl-empty-icon">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
              </div>
              <div class="tbl-empty-title">No user accounts found</div>
              <p class="tbl-empty-desc">No registered user profiles matched your search criteria.</p>
            </div>
          </td>
        </tr>
      `;
      return;
    }

    users.forEach((u) => {
      const tr = document.createElement('tr');
      const isVip = u.subscription_tier === 'premium' || u.subscription_tier === 'vip';
      const isAdmin = u.role === 'admin';
      const dateStr = u.created_at ? new Date(u.created_at).toLocaleDateString() : 'N/A';
      const planTitle = u.subscription_plan_name || (isAdmin ? 'Admin VIP' : isVip ? 'Premium VIP' : 'Free Tier');

      tr.innerHTML = `
        <td>
          <div class="user-row-email">${u.email}</div>
          <div class="user-row-sub">${u.full_name || 'Anonymous User'}</div>
        </td>
        <td>
          <span class="${isAdmin ? 'badge-admin' : 'badge-free'}">${u.role}</span>
        </td>
        <td>
          <span class="${isVip ? 'badge-vip' : 'badge-free'}">${planTitle}</span>
        </td>
        <td>
          <span class="user-quota-badge ${isVip ? 'is-unlimited' : ''}">
            ${isVip ? '✨ Unlimited VIP' : `${u.daily_limit || 5} links / day`}
          </span>
        </td>
        <td class="tbl-date-sub">${dateStr}</td>
        <td>
          <div class="tbl-actions-cluster">
            <button type="button" class="btn-tbl-action ${isVip ? 'btn-tbl-neutral' : 'btn-tbl-vip'}" data-toggle-vip="${u.id}" data-current-tier="${u.subscription_tier}" title="${isVip ? 'Revoke VIP tier' : 'Grant VIP tier'}">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="${isVip ? 'none' : 'currentColor'}" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <span>${isVip ? 'Revoke VIP' : 'Grant VIP'}</span>
            </button>
            <button type="button" class="btn-tbl-action ${isAdmin ? 'btn-tbl-danger' : 'btn-tbl-admin'}" data-toggle-admin="${u.id}" data-current-role="${u.role}" title="${isAdmin ? 'Demote from Admin' : 'Promote to Admin'}">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
              <span>${isAdmin ? 'Demote' : 'Make Admin'}</span>
            </button>
            <button type="button" class="btn-tbl-action btn-tbl-limit" data-edit-limit="${u.id}" data-current-limit="${u.daily_limit || 5}" title="Change daily link limit">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
              <span>Set Limit</span>
            </button>
          </div>
        </td>
      `;
      usersTbody.appendChild(tr);
    });

    wireUserActionButtons();
  }

  function wireUserActionButtons() {
    const sb = getSupabase();

    // Toggle VIP
    document.querySelectorAll('[data-toggle-vip]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-toggle-vip');
        const currTier = btn.getAttribute('data-current-tier');
        const newTier = (currTier === 'premium' || currTier === 'vip') ? 'free' : 'premium';
        const newLimit = newTier === 'premium' ? 99999 : 5;

        try {
          await sb.rpc('admin_update_user', {
            target_user_id: userId,
            new_role: null,
            new_tier: newTier,
            new_daily_limit: newLimit
          });
          await loadUsers();
        } catch (err: any) {
          alert('Error: ' + err.message);
        }
      });
    });

    // Toggle Admin
    document.querySelectorAll('[data-toggle-admin]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-toggle-admin');
        const currRole = btn.getAttribute('data-current-role');
        const newRole = currRole === 'admin' ? 'user' : 'admin';

        if (confirm(`Change user role to ${newRole}?`)) {
          try {
            await sb.rpc('admin_update_user', {
              target_user_id: userId,
              new_role: newRole,
              new_tier: null,
              new_daily_limit: null
            });
            await loadUsers();
          } catch (err: any) {
            alert('Error: ' + err.message);
          }
        }
      });
    });

    // Set Limit
    document.querySelectorAll('[data-edit-limit]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-edit-limit');
        const currLimit = btn.getAttribute('data-current-limit') || '5';
        const input = prompt('Enter new daily free link limit:', currLimit);
        if (input !== null) {
          const num = parseInt(input, 10);
          if (isNaN(num) || num < 0) return alert('Invalid number');

          try {
            await sb.rpc('admin_update_user', {
              target_user_id: userId,
              new_role: null,
              new_tier: null,
              new_daily_limit: num
            });
            await loadUsers();
          } catch (err: any) {
            alert('Error: ' + err.message);
          }
        }
      });
    });
  }

  async function loadPayments() {
    const sb = getSupabase();
    const { data, error } = await sb.from('payments').select('*').order('created_at', { ascending: false }).limit(50);
    if (!error && paymentsTbody && data) {
      paymentsTbody.innerHTML = '';
      if (data.length === 0) {
        paymentsTbody.innerHTML = `
          <tr>
            <td colspan="7">
