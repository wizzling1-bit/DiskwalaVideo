      thumbnail_url: thumb,
      quality,
      duration,
      file_size: size,
      views_count: 0,
      category,
      is_vip: true,
      created_at: new Date().toISOString()
    };

    try {
      const { error } = await sb.from('terabox_videos').insert([record]);
      if (error) throw error;
      showAdminToast(`🎉 Video "${title}" successfully published to Viral TeraBox Hub!`);
      tbvSingleForm.reset();
      await loadTeraboxVideos();
    } catch (err: any) {
      showAdminToast('Error publishing video: ' + err.message, true);
    } finally {
      if (tbvSingleSubmitBtn) tbvSingleSubmitBtn.disabled = false;
    }
  });

  // ========================================================
  // ADVANCED BULK TERA-BOX IMPORTER ENGINE
  // ========================================================

  function updateBulkModeVisuals() {
    const isTurbo = tbvModeTurbo?.checked;
    if (isTurbo) {
      tbvModeTurboLabel?.classList.add('is-active');
      tbvModeResolveLabel?.classList.remove('is-active');
      if (tbvBulkBtnText) tbvBulkBtnText.textContent = 'Start Instant Turbo Import (Offline Covers)';
    } else {
      tbvModeResolveLabel?.classList.add('is-active');
      tbvModeTurboLabel?.classList.remove('is-active');
      if (tbvBulkBtnText) tbvBulkBtnText.textContent = 'Start High-Speed Bulk Import (Auto-Resolve)';
    }
  }

  tbvModeResolve?.addEventListener('change', updateBulkModeVisuals);
  tbvModeTurbo?.addEventListener('change', updateBulkModeVisuals);
  tbvModeResolveLabel?.addEventListener('click', () => {
    if (tbvModeResolve) { tbvModeResolve.checked = true; updateBulkModeVisuals(); }
  });
  tbvModeTurboLabel?.addEventListener('click', () => {
    if (tbvModeTurbo) { tbvModeTurbo.checked = true; updateBulkModeVisuals(); }
  });

  const VALID_TERABOX_DOMAINS = [
    'terabox.com', '1024terabox.com', '1024tera.com', 'teraboxapp.com',
    'terabox.app', 'terasharelink.com', 'freeterabox.com', 'mirrobox.com',
    'nephobox.com', '4funbox.com', 'terabox.link', 'diskwala.com', 'flezen.com'
  ];

  function isValidTeraBoxUrl(candidate: string): boolean {
    if (!candidate || typeof candidate !== 'string') return false;
    try {
      const formatted = candidate.startsWith('http://') || candidate.startsWith('https://') 
        ? candidate 
        : `https://${candidate}`;
      const u = new URL(formatted);
      const host = u.hostname.toLowerCase();
      return VALID_TERABOX_DOMAINS.some(d => host === d || host.endsWith('.' + d));
    } catch {
      return false;
    }
  }

  function cleanTeraBoxUrl(raw: string): string {
    try {
      const formatted = raw.startsWith('http://') || raw.startsWith('https://') ? raw : `https://${raw}`;
      const u = new URL(formatted);
      return `${u.origin}${u.pathname}`;
    } catch {
      return raw.trim();
    }
  }

  interface ParsedBulkItem {
    url: string;
    customTitle?: string;
    customQuality?: string;
  }

  function extractBulkItems(rawText: string): { items: ParsedBulkItem[]; totalRaw: number; duplicatesCount: number } {
    if (!rawText) return { items: [], totalRaw: 0, duplicatesCount: 0 };
    const lines = rawText.split('\n').map(l => l.trim()).filter(Boolean);
    const parsedList: ParsedBulkItem[] = [];
    const seenUrls = new Set<string>();
    let duplicatesCount = 0;

    const urlRegex = /(https?:\/\/[^\s<>"'|]+|(?:\b(?:(?:1024)?terabox|1024tera|terasharelink|freeterabox|mirrobox|nephobox|4funbox|diskwala|flezen)\.[a-z.]+\/s\/[^\s<>"'|]+))/gi;

    for (const line of lines) {
      if (line.includes('|')) {
        const parts = line.split('|').map(p => p.trim());
        const matched = parts[0].match(urlRegex);
        const urlCandidate = matched ? matched[0] : parts[0];
        if (isValidTeraBoxUrl(urlCandidate)) {
          const clean = cleanTeraBoxUrl(urlCandidate);
          if (seenUrls.has(clean)) {
            duplicatesCount++;
          } else {
            seenUrls.add(clean);
            parsedList.push({
              url: clean,
              customTitle: parts[1] || undefined,
              customQuality: parts[2] || undefined
            });
          }
          continue;
        }
      }

      // Scan full line for any URLs
      const matches = line.match(urlRegex);
      if (matches && matches.length > 0) {
        for (const m of matches) {
          if (isValidTeraBoxUrl(m)) {
            const clean = cleanTeraBoxUrl(m);
            if (seenUrls.has(clean)) {
              duplicatesCount++;
            } else {
              seenUrls.add(clean);
              parsedList.push({ url: clean });
            }
          }
        }
      } else {
        if (isValidTeraBoxUrl(line)) {
          const clean = cleanTeraBoxUrl(line);
          if (seenUrls.has(clean)) {
            duplicatesCount++;
          } else {
            seenUrls.add(clean);
            parsedList.push({ url: clean });
          }
        }
      }
    }

    return {
      items: parsedList,
      totalRaw: parsedList.length + duplicatesCount,
      duplicatesCount
    };
  }

  function updateBulkDetectionBadge() {
    const text = tbvBulkTextarea?.value || '';
    const { items, duplicatesCount } = extractBulkItems(text);
    if (tbvLinkCounterBadge) {
      tbvLinkCounterBadge.textContent = `🎯 ${items.length} Valid Link${items.length === 1 ? '' : 's'} Detected`;
      if (items.length > 0) {
        tbvLinkCounterBadge.style.color = '#10D6A0';
        tbvLinkCounterBadge.style.borderColor = 'rgba(16, 214, 160, 0.35)';
        tbvLinkCounterBadge.style.background = 'rgba(16, 214, 160, 0.12)';
      } else {
        tbvLinkCounterBadge.style.color = 'var(--color-text-secondary)';
        tbvLinkCounterBadge.style.borderColor = 'rgba(255, 255, 255, 0.1)';
        tbvLinkCounterBadge.style.background = 'rgba(255, 255, 255, 0.06)';
      }
    }
    if (tbvLinkDupBadge) {
      if (duplicatesCount > 0) {
        tbvLinkDupBadge.style.display = 'inline-block';
        tbvLinkDupBadge.textContent = `⚠️ ${duplicatesCount} Duplicate${duplicatesCount === 1 ? '' : 's'}`;
      } else {
        tbvLinkDupBadge.style.display = 'none';
      }
    }
  }

  tbvBulkTextarea?.addEventListener('input', updateBulkDetectionBadge);

  // Paste from Clipboard
  tbvBulkPasteBtn?.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (!text) {
        showAdminToast('Clipboard is empty.', true);
        return;
      }
      if (tbvBulkTextarea) {
        tbvBulkTextarea.value = tbvBulkTextarea.value ? `${tbvBulkTextarea.value}\n${text}` : text;
        updateBulkDetectionBadge();
        showAdminToast('📋 Pasted content from clipboard!');
      }
    } catch {
      showAdminToast('Please paste directly using Ctrl+V.', true);
    }
  });

  // Clear Textarea
  tbvBulkClearBtn?.addEventListener('click', () => {
    if (tbvBulkTextarea) {
      tbvBulkTextarea.value = '';
      updateBulkDetectionBadge();
    }
    if (tbvBulkProgress) tbvBulkProgress.style.display = 'none';
    if (tbvBulkResultsDrawer) tbvBulkResultsDrawer.style.display = 'none';
  });

  // Insert Samples
  tbvBulkSampleBtn?.addEventListener('click', () => {
    const samples = [
      'https://1024terabox.com/s/1jV4tzRwAj_9sTwW7b30sXQ | Kesari (2019) Action Blockbuster | 720P',
      'https://teraboxapp.com/s/1h9Q_xZyLMN89201aB | Mallu Viral Clip.mp4 | 1080P',
      'https://1024tera.com/s/1k8L209xJ991zQ | Trending Binge Stream.mp4 | 1080P'
    ].join('\n');
    if (tbvBulkTextarea) {
      tbvBulkTextarea.value = samples;
      updateBulkDetectionBadge();
      showAdminToast('💡 Loaded sample TeraBox links.');
    }
  });

  // Extract Clean Links helper
  tbvBulkExtractBtn?.addEventListener('click', () => {
    const raw = tbvBulkTextarea?.value || '';
    if (!raw.trim()) {
      showAdminToast('Please paste message text first.', true);
      return;
    }
    const { items } = extractBulkItems(raw);
    if (items.length === 0) {
      showAdminToast('No supported TeraBox links found in the text.', true);
      return;
    }
    if (tbvBulkTextarea) {
      tbvBulkTextarea.value = items.map(it => it.url).join('\n');
      updateBulkDetectionBadge();
      showAdminToast(`✨ Cleanly extracted ${items.length} TeraBox links!`);
    }
  });

  // Cancel in-progress import
  tbvBulkCancelBtn?.addEventListener('click', () => {
    if (isBulkImportRunning) {
      bulkImportAbortSignal = true;
      if (tbvProgressText) tbvProgressText.textContent = 'Cancelling import queue...';
      showAdminToast('Import cancelled by user.');
    }
  });

  // Advanced Bulk Import Form Submit
  tbvBulkForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isBulkImportRunning) return;

    const raw = tbvBulkTextarea?.value || '';
    const { items } = extractBulkItems(raw);
    if (items.length === 0) {
      showAdminToast('Please enter at least one valid TeraBox link.', true);
      tbvBulkTextarea?.focus();
      return;
    }

    // Deduplication check against loaded catalog
    const skipExisting = tbvOptSkipDuplicates?.checked ?? true;
    const existingUrlSet = new Set(allTeraboxVideos.map(v => (v.terabox_url || '').trim()));
    
    let itemsToProcess = items;
    let skippedDuplicatesCount = 0;
    if (skipExisting) {
      itemsToProcess = items.filter(it => {
        if (existingUrlSet.has(it.url)) {
          skippedDuplicatesCount++;
          return false;
        }
        return true;
      });
    }

    if (itemsToProcess.length === 0) {
      showAdminToast(`All ${items.length} links are already published in the catalog. Zero duplicates added.`);
      return;
    }

    // UI state
    isBulkImportRunning = true;
    bulkImportAbortSignal = false;
    if (tbvBulkImportBtn) tbvBulkImportBtn.disabled = true;
    if (tbvBulkCancelBtn) tbvBulkCancelBtn.style.display = 'inline-flex';
    if (tbvBulkProgress) tbvBulkProgress.style.display = 'block';
    if (tbvProgressBar) tbvProgressBar.style.width = '5%';
    if (tbvProgressPct) tbvProgressPct.textContent = '5%';
    if (tbvProgressText) tbvProgressText.textContent = `Starting parallel import of ${itemsToProcess.length} videos...`;

    if (tbvBulkResultsDrawer) {
      tbvBulkResultsDrawer.style.display = 'block';
      if (tbvResultsList) tbvResultsList.innerHTML = '';
      if (tbvResultsCount) tbvResultsCount.textContent = `0 of ${itemsToProcess.length}`;
    }

    const isAutoResolve = tbvModeResolve?.checked ?? true;
    const defaultCat = tbvBulkCategory?.value || 'trending';
    const defaultQuality = tbvBulkQuality?.value || 'auto';
    const seedViews = tbvOptSeedViews?.checked ?? true;
    const categories = ['trending', 'for_you', 'popular', 'latest'];

    if (tbvChipTotal) tbvChipTotal.textContent = `Total: ${itemsToProcess.length}`;
    if (tbvChipSkipped) tbvChipSkipped.textContent = `⏭ Skipped: ${skippedDuplicatesCount}`;
    let resolvedCount = 0;
    let curatedCount = 0;

    const finalRecords: any[] = [];
    const sb = getSupabase();

    // High-speed parallel worker queue (Concurrency = 4)
    const CONCURRENCY = isAutoResolve ? 4 : 8;
    let nextIndex = 0;
    let completedCount = 0;

    async function worker() {
      while (nextIndex < itemsToProcess.length && !bulkImportAbortSignal) {
        const idx = nextIndex++;
        const item = itemsToProcess[idx];

        // Determine category
        let assignedCat = defaultCat;
        if (defaultCat === 'distribute') {
          assignedCat = categories[idx % categories.length];
        }

        // Determine quality
        let assignedQuality = defaultQuality === 'auto' ? '1080P' : defaultQuality;
        let title = item.customTitle || '';
        let thumbnail = '';
        let duration = '--:--';
        let size = '--';

        if (isAutoResolve) {
          try {
            const meta = await fetchTeraBoxMetadata(item.url);
            if (meta) {
              title = item.customTitle || meta.title || meta.name || '';
              thumbnail = meta.thumbnail || '';
              duration = meta.duration || '--:--';
              size = meta.size || '--';
              if (defaultQuality === 'auto' && meta.quality) {
                assignedQuality = meta.quality;
              }
              resolvedCount++;
            }
          } catch {}
        }

        // Fallback for title and thumbnail if empty
        if (!title) {
          try {
            const u = new URL(item.url);
            const slug = u.pathname.split('/').filter(Boolean).pop() || '';
            title = `Viral Clip ${slug.substring(0, 10)}.mp4`;
          } catch {
            title = `Viral Video Clip #${idx + 1}.mp4`;
          }
        }

        if (!thumbnail) {
          thumbnail = getCuratedPoster(idx);
          curatedCount++;
          if (duration === '--:--') {
            const rMin = Math.floor(Math.random() * 8) + 2;
            const rSec = Math.floor(Math.random() * 59);
            duration = `0${rMin}:${rSec < 10 ? '0' : ''}${rSec}`;
          }
          if (size === '--') {
            size = `${(Math.random() * 80 + 35).toFixed(1)} MB`;
          }
        }

        // Random starter views
        let views = 0;
        if (seedViews) {
          views = Math.floor(Math.random() * 7000) + 1200;
        }

        const record = {
          id: generateUUID(),
          title,
          terabox_url: item.url,
          thumbnail_url: thumbnail,
          quality: assignedQuality,
          duration,
          file_size: size,
          views_count: views,
          category: assignedCat,
          is_vip: true,
          created_at: new Date().toISOString()
        };

        finalRecords.push(record);
        completedCount++;

        // Update Progress UI
        const pct = Math.round((completedCount / itemsToProcess.length) * 100);
        if (tbvProgressBar) tbvProgressBar.style.width = `${pct}%`;
        if (tbvProgressPct) tbvProgressPct.textContent = `${pct}%`;
        if (tbvProgressText) tbvProgressText.textContent = `[${completedCount}/${itemsToProcess.length}] Saved "${title.substring(0, 28)}..."`;
        if (tbvChipResolved) tbvChipResolved.textContent = `✓ Resolved: ${resolvedCount}`;
        if (tbvChipCurated) tbvChipCurated.textContent = `⚡ Curated: ${curatedCount}`;

        // Live Preview Item in Drawer
        if (tbvResultsList) {
          const resItem = document.createElement('div');
          resItem.className = 'bulk-result-item';
          const safeTitle = escapeHtml(title);
          const safeThumb = sanitizeUrl(thumbnail || getCuratedPoster(0));
          const safeMeta = `${escapeHtml(assignedQuality)} • ${escapeHtml(duration)} • ${escapeHtml(size)}`;
          const safeCat = escapeHtml(assignedCat);

          resItem.innerHTML = `
            <div class="bulk-result-left">
              <img src="${safeThumb}" class="bulk-result-thumb" alt="${safeTitle}" onerror="this.src='${getCuratedPoster(0)}'"/>
              <div>
                <div class="bulk-result-title" title="${safeTitle}">${safeTitle}</div>
                <div style="font-size: 10px; color: var(--color-text-secondary);">${safeMeta}</div>
              </div>
            </div>
            <span class="upload-badge-pill" style="font-size: 9px; padding: 1px 6px;">${safeCat}</span>
          `;
          tbvResultsList.prepend(resItem);
        }
        if (tbvResultsCount) {
          tbvResultsCount.textContent = `${completedCount} of ${itemsToProcess.length} processed`;
        }
      }
    }

    // Launch concurrent workers
    const workers = Array.from({ length: Math.min(CONCURRENCY, itemsToProcess.length) }, () => worker());
    await Promise.all(workers);

    // Batch insert into Supabase in chunks of 25
    if (finalRecords.length > 0) {
      if (tbvProgressText) tbvProgressText.textContent = `Syncing ${finalRecords.length} records into database...`;
      try {
        for (let i = 0; i < finalRecords.length; i += 25) {
          const chunk = finalRecords.slice(i, i + 25);
          const { error } = await sb.from('terabox_videos').insert(chunk);
          if (error) throw error;
        }

        showAdminToast(`🎉 Successfully imported and published ${finalRecords.length} videos to Viral TeraBox Hub!`);
        if (tbvBulkTextarea) tbvBulkTextarea.value = '';
        updateBulkDetectionBadge();
        await loadTeraboxVideos();
      } catch (dbErr: any) {
        showAdminToast('Error saving to database: ' + dbErr.message, true);
      }
    }

    isBulkImportRunning = false;
    if (tbvBulkImportBtn) tbvBulkImportBtn.disabled = false;
    if (tbvBulkCancelBtn) tbvBulkCancelBtn.style.display = 'none';
    if (tbvProgressText) tbvProgressText.textContent = `Completed! ${finalRecords.length} videos published.`;
  });

  // Table Search and Category Filtering
  tbvSearchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    const cat = tbvCategoryFilter?.value || 'all';
    filterTeraboxTable(q, cat);
  });

  tbvCategoryFilter?.addEventListener('change', (e) => {
    const cat = (e.target as HTMLSelectElement).value;
    const q = tbvSearchInput?.value.toLowerCase().trim() || '';
    filterTeraboxTable(q, cat);
  });

  function filterTeraboxTable(query: string, category: string) {
    const filtered = allTeraboxVideos.filter(v => {
      const matchQuery = !query || 
        (v.title || '').toLowerCase().includes(query) || 
        (v.terabox_url || '').toLowerCase().includes(query);
      const matchCat = category === 'all' || v.category === category;
      return matchQuery && matchCat;
    });
    renderTeraboxVideos(filtered);
  }

  // Robust Tab Switching with Persistence across reloads
  function switchAdminTab(tabId: string, persist = true) {
    if (!tabId) return;
    const targetBtn = document.querySelector(`.admin-tab-btn[data-tab="${tabId}"]`) as HTMLElement | null;
    const targetContent = document.getElementById(tabId);
    if (!targetBtn || !targetContent) return;

    document.querySelectorAll('.admin-tab-btn').forEach(b => b.classList.remove('is-active'));
    document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.remove('is-active'));

    targetBtn.classList.add('is-active');
    targetContent.classList.add('is-active');

    if (persist) {
      try {
        localStorage.setItem('admin_active_tab', tabId);
        history.replaceState(null, '', '#' + tabId);
      } catch (e) {}
    }

    if (tabId === 'tab-terabox-videos') {
      loadTeraboxVideos();
    } else if (tabId === 'tab-payments') {
      loadPayments();
    } else if (tabId === 'tab-links') {
      loadLinks();
    }
  }

  document.querySelectorAll('.admin-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (tabId) {
        switchAdminTab(tabId, true);
      }
    });
  });

  // Restore tab on load: query param -> URL hash -> localStorage -> default 'tab-users'
  function restoreSavedAdminTab() {
    try {
      const searchTab = new URLSearchParams(window.location.search).get('tab');
      const hashTab = window.location.hash ? window.location.hash.replace('#', '') : '';
      const storedTab = localStorage.getItem('admin_active_tab');
      const targetTab = searchTab || hashTab || storedTab || 'tab-users';
      switchAdminTab(targetTab, false);
    } catch (e) {
      switchAdminTab('tab-users', false);
    }
  }

  // Listen for hash changes
  window.addEventListener('hashchange', () => {
    const hash = window.location.hash ? window.location.hash.replace('#', '') : '';
    if (hash) switchAdminTab(hash, false);
  });

  // Run initial restore
  restoreSavedAdminTab();

  // Search filter
  document.getElementById('user-search-input')?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    const filtered = allUsersList.filter(u => 
      (u.email || '').toLowerCase().includes(query) || 
      (u.full_name || '').toLowerCase().includes(query)
    );
    renderUsers(filtered);
  });

  // Refreshes
  document.getElementById('refresh-users-btn')?.addEventListener('click', loadUsers);
  document.getElementById('refresh-payments-btn')?.addEventListener('click', loadPayments);
  document.getElementById('refresh-links-btn')?.addEventListener('click', loadLinks);
  document.getElementById('refresh-tbv-btn')?.addEventListener('click', loadTeraboxVideos);

  // Logout
  document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
    if (confirm('Log out from Admin Console?')) {
      await signOutUser();
      window.location.href = '/';
    }
  });

  // Cloudflare Turnstile explicit render for admin login
  let adminTurnstileWidgetId: any = null;
  function initAdminTurnstile() {
    const container = document.getElementById('admin-turnstile-container');
    if (!container || adminTurnstileWidgetId !== null) return;
    const turnstileObj = (window as any).turnstile;
    if (turnstileObj && typeof turnstileObj.render === 'function') {
      try {
        adminTurnstileWidgetId = turnstileObj.render(container, {
          sitekey: APP_CONFIG.turnstile?.siteKey || '1x00000000000000000000AA',
          theme: 'dark'
        });
      } catch (err) {
        console.warn('Turnstile render warning:', err);
      }
    }
  }

  if (typeof window !== 'undefined') {
    if ((window as any).turnstile) {
      initAdminTurnstile();
    } else {
      const turnstilePoll = setInterval(() => {
        if ((window as any).turnstile) {
          clearInterval(turnstilePoll);
          initAdminTurnstile();
        }
      }, 250);
      setTimeout(() => clearInterval(turnstilePoll), 6000);
    }
  }

  // Admin login form submission
  document.getElementById('admin-login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('admin-email') as HTMLInputElement).value.trim();
    const pw = (document.getElementById('admin-password') as HTMLInputElement).value;
    const sb = getSupabase();

    // Verify Cloudflare Turnstile token
    const turnstileObj = (window as any).turnstile;
    if (turnstileObj && adminTurnstileWidgetId !== null) {
      const token = turnstileObj.getResponse(adminTurnstileWidgetId);
      if (!token) {
        if (errorBanner) {
          errorBanner.textContent = 'Please complete the Cloudflare security verification to sign in.';
          errorBanner.style.display = 'block';
        }
        return;
      }
      const verified = await verifyTurnstileToken(token);
      if (!verified) {
        if (errorBanner) {
          errorBanner.textContent = 'Cloudflare security verification failed or expired. Please try again.';
          errorBanner.style.display = 'block';
        }
        try { turnstileObj.reset(adminTurnstileWidgetId); } catch {}
        return;
      }
    }

    try {
      const { error } = await sb.auth.signInWithPassword({ email, password: pw });
      if (error) throw error;
      window.location.reload();
    } catch (err: any) {
      if (errorBanner) {
        errorBanner.textContent = err.message || 'Login failed.';
        errorBanner.style.display = 'block';
      }
      if (turnstileObj && adminTurnstileWidgetId !== null) {
        try { turnstileObj.reset(adminTurnstileWidgetId); } catch {}
      }
    }
  });

  // Run initial check
  checkAdminState();
</script>
