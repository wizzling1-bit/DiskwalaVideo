    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-admin-theme-toggle:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn-admin-theme-toggle:active {
    transform: scale(0.95);
  }
  .btn-admin-logout {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 650;
    cursor: pointer;
  }
  .btn-admin-logout:hover {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
  }
  .btn-hub-link {
    background: rgba(16, 214, 160, 0.15) !important;
    border-color: rgba(16, 214, 160, 0.4) !important;
    color: #10D6A0 !important;
    text-decoration: none;
    font-weight: 700;
  }
  .btn-hub-link:hover {
    background: #10D6A0 !important;
    color: #070A09 !important;
  }

  /* ========================================================
     ADMIN METRICS GRID (Double-Bezel Hardware Architecture)
     ======================================================== */
  .admin-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 26px;
  }
  .metric-glass-card {
    background: linear-gradient(180deg, rgba(16, 24, 28, 0.8) 0%, rgba(10, 16, 18, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }
  .metric-glass-card:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 185, 129, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 25px rgba(16, 185, 129, 0.08);
  }
  .metric-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .metric-head .label {
    font-size: 0.68rem;
    font-weight: 750;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .icon-circle {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .icon-circle.icon-green { color: #10b981; border-color: rgba(16, 185, 129, 0.25); background: rgba(16, 185, 129, 0.08); }
  .icon-circle.icon-amber { color: #f59e0b; border-color: rgba(245, 158, 11, 0.25); background: rgba(245, 158, 11, 0.08); }
  .icon-circle.icon-blue  { color: #38bdf8; border-color: rgba(56, 189, 248, 0.25); background: rgba(56, 189, 248, 0.08); }
  .icon-circle.icon-emerald { color: #34d399; border-color: rgba(52, 211, 153, 0.25); background: rgba(52, 211, 153, 0.08); }
  .metric-val {
    font-size: 2.3rem;
    font-weight: 850;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    margin-bottom: 6px;
  }
  .metric-note {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    font-weight: 550;
  }

  /* ========================================================
     SEGMENTED CONTROL PILL BAR (Navigation Tabs)
     ======================================================== */
  .admin-tabs-nav {
    display: flex;
    gap: 6px;
    background: rgba(8, 13, 15, 0.75);
    backdrop-filter: blur(12px);
    padding: 6px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 24px;
    overflow-x: auto;
  }
  .admin-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid transparent;
    background: none;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 11px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    white-space: nowrap;
  }
  .admin-tab-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }
  .admin-tab-btn:active {
    transform: scale(0.97);
  }
  .admin-tab-btn.is-active {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(5, 150, 105, 0.15) 100%);
    color: #ffffff;
    border: 1px solid rgba(52, 211, 153, 0.45);
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.15);
  }

  .admin-tab-content {
    display: none;
  }
  .admin-tab-content.is-active {
    display: block;
    animation: admTabIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes admTabIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ========================================================
     VIRAL TERABOX HUB MINI-STAT GRID
     ======================================================== */
  .hub-stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .hub-stat-tile {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 16px 18px;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hub-stat-tile:hover {
    transform: translateY(-2px);
    border-color: rgba(16, 214, 160, 0.3);
  }
  .hub-stat-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .hub-stat-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .dot-emerald { background: #10D6A0; box-shadow: 0 0 8px #10D6A0; }
  .dot-pink { background: #FF2E93; box-shadow: 0 0 8px #FF2E93; }
  .dot-cyan { background: #06b6d4; box-shadow: 0 0 8px #06b6d4; }
  .dot-blue { background: #38bdf8; box-shadow: 0 0 8px #38bdf8; }
  .hub-stat-label {
    font-size: 0.68rem;
    font-weight: 750;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .hub-stat-val {
    font-size: 1.85rem;
    font-weight: 850;
    color: #ffffff;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .val-pink { color: #FF2E93; }
  .val-emerald { color: #10D6A0; }
  .val-blue { color: #38bdf8; }
  .hub-stat-hint {
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  /* ========================================================
     TABLE CARDS & CONTROLS
     ======================================================== */
  .table-card {
    background: linear-gradient(180deg, rgba(13, 20, 23, 0.92) 0%, rgba(9, 14, 16, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 26px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.06);
  }
  .table-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    flex-wrap: wrap;
    gap: 14px;
  }
  .table-card-title {
    font-size: var(--text-lg);
    font-weight: 850;
    color: #ffffff;
    letter-spacing: -0.01em;
  }
  .table-card-sub {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-top: 3px;
  }
  .table-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .search-input-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .search-icon-svg {
    position: absolute;
    left: 12px;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .search-input {
    padding: 8px 14px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: 0.78rem;
    font-family: inherit;
    transition: all 0.2s;
  }
  .search-input.has-icon {
    padding-left: 34px;
    width: 220px;
  }
  .search-input:focus {
    outline: none;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }
  .select-styled {
    cursor: pointer;
  }
  .tbl-badge-counter {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 9999px;
    background: rgba(16, 214, 160, 0.12);
    border: 1px solid rgba(16, 214, 160, 0.35);
    color: #10D6A0;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .btn-subtle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 650;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-subtle:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn-subtle:active {
    transform: scale(0.97);
  }

  /* ========================================================
     DATA TABLE & CELL TYPOGRAPHY
     ======================================================== */
  .table-responsive {
    overflow-x: auto;
    border-radius: 12px;
  }
  .admin-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    text-align: left;
  }
  .admin-data-table th {
    padding: 13px 14px;
    color: var(--color-text-muted);
    font-weight: 750;
    text-transform: uppercase;
    font-size: 0.67rem;
    letter-spacing: 0.06em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.15);
  }
  .admin-data-table td {
    padding: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary);
    vertical-align: middle;
  }
  .admin-data-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Badges */
  .badge-vip {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(16, 185, 129, 0.18);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.4);
  }
  .badge-free {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.07);
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .badge-admin {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(239, 68, 68, 0.18);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  /* ========================================================
     DATA TABLE ACTIONS & PILL CHIPS
     ======================================================== */
  .tbl-actions-cluster {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-wrap: nowrap;
    white-space: nowrap;
  }
  .btn-tbl-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid transparent;
    text-decoration: none;
    font-family: inherit;
    line-height: 1.2;
    white-space: nowrap;
    user-select: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .btn-tbl-action svg {
    flex-shrink: 0;
    pointer-events: none;
  }
  .btn-tbl-action:hover {
    transform: translateY(-1px);
  }
  .btn-tbl-action:active {
    transform: scale(0.96);
  }
  .btn-tbl-play {
    background: linear-gradient(135deg, rgba(16, 214, 160, 0.2) 0%, rgba(5, 150, 105, 0.25) 100%);
    border-color: rgba(16, 214, 160, 0.45);
    color: #10D6A0;
    font-weight: 800;
  }
  .btn-tbl-play:hover {
    background: #10D6A0;
    border-color: #10D6A0;
    color: #070A09;
    box-shadow: 0 4px 16px rgba(16, 214, 160, 0.4);
  }
  .btn-tbl-icon {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--color-text-secondary);
  }
  .btn-tbl-icon:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  .btn-tbl-danger {
    padding: 6px 12px;
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.35);
    color: #f87171;
  }
  .btn-tbl-danger:hover {
    background: #ef4444;
    border-color: #ef4444;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.4);
  }
  .btn-tbl-vip {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(52, 211, 153, 0.4);
    color: #34d399;
  }
  .btn-tbl-vip:hover {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
  }
  .btn-tbl-admin {
    background: rgba(245, 158, 11, 0.14);
    border-color: rgba(245, 158, 11, 0.4);
    color: #fbbf24;
  }
  .btn-tbl-admin:hover {
    background: #f59e0b;
    border-color: #f59e0b;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
  }
  .btn-tbl-limit {
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.3);
    color: #38bdf8;
  }
  .btn-tbl-limit:hover {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.35);
  }
  .btn-tbl-neutral {
    background: rgba(148, 163, 184, 0.12);
    border-color: rgba(148, 163, 184, 0.25);
    color: #94a3b8;
  }
  .btn-tbl-neutral:hover {
    background: rgba(148, 163, 184, 0.25);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  .user-quota-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 750;
    color: #10b981;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .user-quota-badge.is-unlimited {
    color: #38bdf8;
  }

  /* Status Pills */
  .tbl-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(16, 185, 129, 0.14);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.35);
  }
  .status-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
    animation: pulseDot 2s infinite ease-in-out;
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Video Catalog Row Elements */
  .tbl-video-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tbl-thumb-wrap {
    position: relative;
    width: 64px !important;
    height: 40px !important;
    min-width: 64px !important;
    max-width: 64px !important;
    border-radius: 7px;
    overflow: hidden;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }
  .tbl-video-thumb {
    width: 64px !important;
    height: 40px !important;
    min-width: 64px !important;
    max-width: 64px !important;
    object-fit: cover !important;
    display: block !important;
    border-radius: 6px;
    transition: transform 0.25s ease;
  }
  .tbl-thumb-wrap:hover .tbl-video-thumb {
    transform: scale(1.08);
  }
  .tbl-thumb-play-cue {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    color: #ffffff;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .tbl-thumb-wrap:hover .tbl-thumb-play-cue {
    opacity: 1;
  }
  .tbl-video-info {
    min-width: 0;
    max-width: 280px;
  }
  .tbl-video-link {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    text-decoration: none;
    margin-top: 2px;
  }
  .tbl-video-link:hover {
    color: #10D6A0;
    text-decoration: underline;
  }
  .quality-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .q-1080p {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.35);
  }
  .q-2k, .q-4k {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.35);
  }
  .q-720p {
    background: rgba(16, 214, 160, 0.15);
    color: #10D6A0;
    border: 1px solid rgba(16, 214, 160, 0.35);
  }
  .q-480p, .q-360p {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }
  .tbl-cat-select {
    padding: 4px 8px;
    font-size: 0.72rem;
    height: 30px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    cursor: pointer;
  }
  .tbl-file-meta {
    font-size: 0.78rem;
    font-weight: 650;
    color: #ffffff;
  }
  .tbl-date-sub {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  .tbl-views-count {
    font-size: 0.85rem;
    font-weight: 800;
    color: #10D6A0;
    font-variant-numeric: tabular-nums;
  }

  /* Legacy fallback support */
  .btn-action-small {
    padding: 6px 11px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    margin-right: 4px;
    transition: all 0.15s;
  }
  .btn-action-small:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(52, 211, 153, 0.4);
    color: #34d399;
  }

  /* ========================================================
     SETTINGS GRID
     ======================================================== */
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .settings-card {
    background: linear-gradient(180deg, rgba(13, 20, 23, 0.92) 0%, rgba(9, 14, 16, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 24px;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5);
  }
  .settings-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .settings-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .setting-input-row {
    display: flex;
    gap: 10px;
  }
  .setting-input-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .setting-number-input,
  .setting-text-input {
    flex: 1;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-sm);
  }
  .setting-textarea {
    width: 100%;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-xs);
    resize: vertical;
  }
  .btn-save-setting {
    padding: 10px 16px;
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 750;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .btn-save-setting:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    transform: translateY(-1px);
  }

  /* Settings Card Head & Icons */
  .settings-card-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
  }
  .settings-icon {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Hub Upload Grid & Modules */
  .hub-upload-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
    align-items: start;
  }
  .upload-module-card {
    background: linear-gradient(180deg, rgba(13, 20, 23, 0.92) 0%, rgba(9, 14, 16, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 16px;
  }
  .bulk-engine-box {
    margin-bottom: 12px;
    padding: 10px 12px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }
  .tbv-counter-pill {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-secondary);
  }
  .xapi-status-banner {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
  #tbv-thumb-preview-wrap {
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  #tbv-bulk-progress {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(16, 214, 160, 0.25);
  }
  .upload-module-featured {
    border-color: rgba(16, 214, 160, 0.35);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(16, 214, 160, 0.06);
  }
  .upload-module-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    gap: 12px;
  }
  .upload-module-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .upload-module-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .upload-module-icon.icon-emerald {
    color: #10D6A0;
    border-color: rgba(16, 214, 160, 0.3);
    background: rgba(16, 214, 160, 0.08);
  }
  .upload-module-icon.icon-blue {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.3);
    background: rgba(56, 189, 248, 0.08);
  }
  .upload-module-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .upload-module-sub {
    font-size: 0.72rem;
    color: var(--color-text-secondary);
  }
  .upload-badge-pill {
    font-size: 0.68rem;
    font-weight: 750;
    background: rgba(16, 214, 160, 0.12);
    color: #10D6A0;
    border: 1px solid rgba(16, 214, 160, 0.3);
    padding: 3px 10px;
    border-radius: 99px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .upload-desc-text {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-bottom: 14px;
    line-height: 1.5;
  }
  .upload-desc-text code {
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #38bdf8;
  }
  .upload-form-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--color-text-secondary);
    margin-bottom: 5px;
  }
  .upload-grid-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }
  .upload-grid-4col {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 14px;
  }

  /* Advanced Bulk Importer Controls & Cards */
  .btn-bulk-tool {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    font-size: 0.68rem;
    font-weight: 650;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-bulk-tool:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-1px);
  }
  .btn-bulk-tool-danger:hover {
    color: #f87171 !important;
    background: rgba(239, 68, 68, 0.15) !important;
    border-color: rgba(239, 68, 68, 0.35) !important;
  }
  .bulk-mode-card {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bulk-mode-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
  }
  .bulk-mode-card.is-active {
    background: rgba(16, 214, 160, 0.08) !important;
    border-color: rgba(16, 214, 160, 0.45) !important;
    box-shadow: 0 0 16px rgba(16, 214, 160, 0.08);
  }
  .bulk-result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 10px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    font-size: 11px;
    animation: fadeIn 0.2s ease-out;
  }
  .bulk-result-left {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
  }
  .bulk-result-thumb {
    width: 38px;
    height: 24px;
    object-fit: cover;
    border-radius: 4px;
    background: #000;
    flex-shrink: 0;
  }
  .bulk-result-title {
    color: #ffffff;
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }

  /* Table Empty States */
  .tbl-empty-state {
    padding: 40px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .tbl-empty-icon {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .tbl-empty-title {
    font-size: 0.95rem;
    font-weight: 750;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .tbl-empty-desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    max-width: 380px;
    margin: 0 auto;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .admin-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .admin-topbar {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 16px;
    }
    .topbar-right {
      justify-content: space-between;
      width: 100%;
    }
    .admin-tabs-nav {
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .admin-tabs-nav::-webkit-scrollbar {
      display: none;
    }
    .admin-tab-btn {
      white-space: nowrap;
      flex-shrink: 0;
      padding: 8px 14px;
    }
    .table-card-header {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .table-actions {
      flex-direction: column;
      width: 100%;
    }
    .search-input {
      width: 100%;
    }
    .setting-input-row {
      flex-direction: column;
    }
    .btn-save-setting {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .admin-metrics-grid {
      grid-template-columns: 1fr;
    }
    .table-card {
      padding: 16px 12px;
    }
    .table-responsive {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 0 -4px;
    }
    .admin-data-table {
      min-width: 580px;
    }
    .admin-data-table th, .admin-data-table td {
      padding: 10px 8px;
    }
  }

  @media (max-width: 480px) {
    .admin-console-section {
      padding: 16px 10px 40px;
    }
    .admin-gate-card {
      padding: 24px 14px 20px;
      border-radius: var(--radius-lg);
    }
    .admin-gate-title {
      font-size: 1.4rem;
    }
    .gate-input {
      font-size: 16px !important;
      height: 48px;
    }
    .gate-submit-btn {
      min-height: 48px;
      font-size: 15px;
    }
    .admin-topbar {
      padding: 12px 14px;
      border-radius: var(--radius-lg);
    }
    .topbar-title {
      font-size: 1.15rem;
    }
  }

