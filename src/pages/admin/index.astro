  }
  :root[data-theme="light"] .settings-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
  }
  :root[data-theme="light"] .settings-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .settings-desc {
    color: #64748b !important;
  }
  :root[data-theme="light"] .admin-gate-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1) !important;
  }
  :root[data-theme="light"] .admin-gate-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .admin-gate-desc {
    color: #64748b !important;
  }
  :root[data-theme="light"] .admin-field label {
    color: #334155 !important;
  }
  :root[data-theme="light"] .admin-field input {
    background: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }
  :root[data-theme="light"] .admin-field input:focus {
    background: #ffffff !important;
    border-color: #10b981 !important;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15) !important;
  }
</style>

<script>
  import { getCurrentUser, getUserProfile, getSupabase, signOutUser } from '../../utils/supabase';

  const checkingEl = document.getElementById('admin-auth-checking');
  const gateCard = document.getElementById('admin-gate-card');
  const gateMsg = document.getElementById('admin-gate-msg');
  const mainPanel = document.getElementById('admin-main-panel');
  const errorBanner = document.getElementById('gate-error-banner');
  const bootstrapBox = document.getElementById('bootstrap-box');

  const admTotalUsers = document.getElementById('adm-total-users');
  const admVipUsers = document.getElementById('adm-vip-users');
  const admTotalLinks = document.getElementById('adm-total-links');
  const admTodayLinks = document.getElementById('adm-today-links');
  const admTotalRev = document.getElementById('adm-total-rev');

  const usersTbody = document.getElementById('admin-users-tbody');
  const paymentsTbody = document.getElementById('admin-payments-tbody');
  const linksTbody = document.getElementById('admin-links-tbody');

  let allUsersList: any[] = [];

  async function checkAdminState() {
    try {
      const user = await getCurrentUser();
      if (!user) {
        showGate('Please sign in with administrator credentials.');
        return;
      }

      const profile = await getUserProfile(user.id);
      if (!profile || profile.role !== 'admin') {
        showGate('Access Denied: Your account does not have administrator privileges.');
        if (bootstrapBox) bootstrapBox.style.display = 'block';
        return;
      }

      // User is verified admin!
      if (checkingEl) checkingEl.style.display = 'none';
      if (gateCard) gateCard.style.display = 'none';
      if (mainPanel) mainPanel.style.display = 'block';

      await loadAdminData();
    } catch (err) {
      console.error('Error verifying admin:', err);
      showGate('Error checking admin session.');
    }
  }

  function showGate(message: string) {
    if (checkingEl) checkingEl.style.display = 'none';
    if (gateCard) gateCard.style.display = 'block';
    if (mainPanel) mainPanel.style.display = 'none';
    if (gateMsg) gateMsg.textContent = message;
  }

  async function loadAdminData() {
    const sb = getSupabase();

    // 1. Fetch Overview Stats via RPC
    try {
      const { data: stats, error } = await sb.rpc('get_admin_stats');
      if (!error && stats) {
        if (admTotalUsers) admTotalUsers.textContent = (stats.total_users || 0).toString();
        if (admVipUsers) admVipUsers.textContent = (stats.premium_users || 0).toString();
        if (admTotalLinks) admTotalLinks.textContent = (stats.total_links || 0).toString();
        if (admTodayLinks) admTodayLinks.textContent = `${stats.today_links || 0} processed today`;
        if (admTotalRev) admTotalRev.textContent = `₹${stats.total_revenue || 0}`;
      }
    } catch (err) {
      console.warn('Stats RPC error:', err);
    }

    // 2. Load Users
    await loadUsers();

    // 3. Load Payments
    await loadPayments();

    // 4. Load Links
    await loadLinks();

    // 5. Load Settings
    await loadSettings();
  }

  async function loadUsers() {
    const sb = getSupabase();
    const { data, error } = await sb.from('profiles').select('*').order('created_at', { ascending: false }).limit(50);
    if (!error && data) {
      allUsersList = data;
      renderUsers(allUsersList);
      if (admVipUsers) {
        const vipCount = allUsersList.filter(u => u.subscription_tier === 'premium' || u.subscription_tier === 'vip' || u.role === 'admin').length;
        if (vipCount > 0 && parseInt(admVipUsers.textContent || '0', 10) === 0) {
          admVipUsers.textContent = vipCount.toString();
        }
      }
    }
  }

  function renderUsers(users: any[]) {
    if (!usersTbody) return;
    usersTbody.innerHTML = '';

    users.forEach((u) => {
      const tr = document.createElement('tr');
      const isVip = u.subscription_tier === 'premium' || u.subscription_tier === 'vip';
      const isAdmin = u.role === 'admin';
      const dateStr = u.created_at ? new Date(u.created_at).toLocaleDateString() : 'N/A';
      const planTitle = u.subscription_plan_name || (isAdmin ? 'Admin VIP' : isVip ? 'Premium VIP' : 'Free Tier');

      tr.innerHTML = `
        <td>
          <div class="user-row-email">${u.email}</div>
          <div class="user-row-sub">${u.full_name || 'No name'}</div>
        </td>
        <td>
          <span class="${isAdmin ? 'badge-admin' : 'badge-free'}">${u.role}</span>
        </td>
        <td>
          <span class="${isVip ? 'badge-vip' : 'badge-free'}">${planTitle}</span>
        </td>
        <td style="font-weight: 700; color: #10b981;">
          ${isVip ? 'Unlimited' : `${u.daily_limit || 5} links`}
        </td>
        <td style="font-size: 11px;">${dateStr}</td>
        <td>
          <button type="button" class="btn-action-small" data-toggle-vip="${u.id}" data-current-tier="${u.subscription_tier}">
            ${isVip ? 'Revoke VIP' : 'Grant VIP'}
          </button>
          <button type="button" class="btn-action-small" data-toggle-admin="${u.id}" data-current-role="${u.role}">
            ${isAdmin ? 'Demote' : 'Make Admin'}
          </button>
          <button type="button" class="btn-action-small" data-edit-limit="${u.id}" data-current-limit="${u.daily_limit || 5}">
            Set Limit
          </button>
        </td>
      `;
      usersTbody.appendChild(tr);
    });

    wireUserActionButtons();
  }

  function wireUserActionButtons() {
    const sb = getSupabase();

    // Toggle VIP
    document.querySelectorAll('[data-toggle-vip]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-toggle-vip');
        const currTier = btn.getAttribute('data-current-tier');
        const newTier = (currTier === 'premium' || currTier === 'vip') ? 'free' : 'premium';
        const newLimit = newTier === 'premium' ? 99999 : 5;

        try {
          await sb.rpc('admin_update_user', {
            target_user_id: userId,
            new_role: null,
            new_tier: newTier,
            new_daily_limit: newLimit
          });
          await loadUsers();
        } catch (err: any) {
          alert('Error: ' + err.message);
        }
      });
    });

    // Toggle Admin
    document.querySelectorAll('[data-toggle-admin]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-toggle-admin');
        const currRole = btn.getAttribute('data-current-role');
        const newRole = currRole === 'admin' ? 'user' : 'admin';

        if (confirm(`Change user role to ${newRole}?`)) {
          try {
            await sb.rpc('admin_update_user', {
              target_user_id: userId,
              new_role: newRole,
              new_tier: null,
              new_daily_limit: null
            });
            await loadUsers();
          } catch (err: any) {
            alert('Error: ' + err.message);
          }
        }
      });
    });

    // Set Limit
    document.querySelectorAll('[data-edit-limit]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-edit-limit');
        const currLimit = btn.getAttribute('data-current-limit') || '5';
        const input = prompt('Enter new daily free link limit:', currLimit);
        if (input !== null) {
          const num = parseInt(input, 10);
          if (isNaN(num) || num < 0) return alert('Invalid number');

          try {
            await sb.rpc('admin_update_user', {
              target_user_id: userId,
              new_role: null,
              new_tier: null,
              new_daily_limit: num
            });
            await loadUsers();
          } catch (err: any) {
            alert('Error: ' + err.message);
          }
        }
      });
    });
  }

  async function loadPayments() {
    const sb = getSupabase();
    const { data, error } = await sb.from('payments').select('*').order('created_at', { ascending: false }).limit(50);
    if (!error && paymentsTbody && data) {
      paymentsTbody.innerHTML = '';
      if (data.length === 0) {
        paymentsTbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px; color:var(--color-text-muted);">No payment records yet.</td></tr>';
        return;
      }
      data.forEach((p) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="payment-row-id" style="font-family: monospace; font-size: 11px;">${p.razorpay_payment_id || p.id.slice(0, 8)}</td>
          <td>${p.user_email || 'User'}</td>
          <td style="font-weight: 700;">${p.plan_name}</td>
          <td style="color: #10b981; font-weight: 800;">₹${p.amount}</td>
          <td><span class="badge-vip">${p.status}</span></td>
          <td style="font-size: 11px;">${p.valid_until ? new Date(p.valid_until).toLocaleDateString() : 'N/A'}</td>
          <td style="font-size: 11px;">${p.created_at ? new Date(p.created_at).toLocaleString() : ''}</td>
        `;
        paymentsTbody.appendChild(tr);
      });
    }
  }

  async function loadLinks() {
    const sb = getSupabase();
    const { data, error } = await sb.from('link_usage').select('*').order('created_at', { ascending: false }).limit(50);
    if (!error && linksTbody && data) {
      linksTbody.innerHTML = '';
      if (data.length === 0) {
        linksTbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:20px; color:var(--color-text-muted);">No links processed yet.</td></tr>';
        return;
      }
      data.forEach((l) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>
            <div class="link-row-title" style="max-width: 240px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${l.link_url}">
              ${l.file_name || l.link_url}
            </div>
          </td>
          <td><span class="badge-vip" style="background:rgba(59,130,246,0.18); color:#60a5fa;">${l.provider}</span></td>
          <td>${l.user_email || 'Guest / Anon'}</td>
          <td><span style="color:#10b981; font-weight:700;">● ${l.status}</span></td>
          <td style="font-size: 11px;">${l.created_at ? new Date(l.created_at).toLocaleString() : ''}</td>
        `;
        linksTbody.appendChild(tr);
      });
    }
  }

  async function loadSettings() {
    const sb = getSupabase();
    const { data, error } = await sb.from('site_settings').select('*');
    if (!error && data) {
      data.forEach((s) => {
        if (s.key === 'free_daily_limit') {
          const inp = document.getElementById('setting-free-limit') as HTMLInputElement | null;
          if (inp) inp.value = s.value;
        } else if (s.key === 'announcement') {
          const ta = document.getElementById('setting-announcement-text') as HTMLTextAreaElement | null;
          if (ta) ta.value = typeof s.value === 'object' ? s.value.message : s.value;
        } else if (s.key === 'telegram_channel') {
          const inp = document.getElementById('setting-telegram-url') as HTMLInputElement | null;
          if (inp) inp.value = typeof s.value === 'string' ? s.value : 'https://telegram.me/terawala_official';
        }
      });
    }
  }

  // Setting Save Handlers
  document.getElementById('save-limit-btn')?.addEventListener('click', async () => {
    const val = parseInt((document.getElementById('setting-free-limit') as HTMLInputElement).value, 10);
    const sb = getSupabase();
    await sb.rpc('admin_update_setting', { p_key: 'free_daily_limit', p_value: val });
    alert('Daily Free Limit updated to ' + val);
  });

  document.getElementById('save-announcement-btn')?.addEventListener('click', async () => {
    const msg = (document.getElementById('setting-announcement-text') as HTMLTextAreaElement).value;
    const sb = getSupabase();
    await sb.rpc('admin_update_setting', { p_key: 'announcement', p_value: { enabled: true, message: msg } });
    alert('Global announcement updated!');
  });

  document.getElementById('save-tg-btn')?.addEventListener('click', async () => {
    const url = (document.getElementById('setting-telegram-url') as HTMLInputElement).value;
    const sb = getSupabase();
    await sb.rpc('admin_update_setting', { p_key: 'telegram_channel', p_value: url });
    alert('Telegram channel updated to ' + url);
  });

  // Tab Switching
  document.querySelectorAll('.admin-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.admin-tab-btn').forEach(b => b.classList.remove('is-active'));
      document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.remove('is-active'));

      btn.classList.add('is-active');
      const tabId = btn.getAttribute('data-tab');
      if (tabId) document.getElementById(tabId)?.classList.add('is-active');
    });
  });

  // Search filter
  document.getElementById('user-search-input')?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    const filtered = allUsersList.filter(u => 
      (u.email || '').toLowerCase().includes(query) || 
      (u.full_name || '').toLowerCase().includes(query)
    );
    renderUsers(filtered);
  });

  // Refreshes
  document.getElementById('refresh-users-btn')?.addEventListener('click', loadUsers);
  document.getElementById('refresh-payments-btn')?.addEventListener('click', loadPayments);
  document.getElementById('refresh-links-btn')?.addEventListener('click', loadLinks);

  // Logout
  document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
    if (confirm('Log out from Admin Console?')) {
      await signOutUser();
      window.location.href = '/';
    }
  });

  // Claim first admin if needed
  document.getElementById('btn-claim-admin')?.addEventListener('click', async () => {
    const user = await getCurrentUser();
    if (!user) return;
    const sb = getSupabase();
    const { error } = await sb.from('profiles').update({ role: 'admin' }).eq('id', user.id);
    if (!error) {
      alert('Congratulations! Your account is now Admin. Refreshing...');
      window.location.reload();
    } else {
      alert('Could not set admin: ' + error.message);
    }
  });

  // Admin login form submission
  document.getElementById('admin-login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('admin-email') as HTMLInputElement).value.trim();
    const pw = (document.getElementById('admin-password') as HTMLInputElement).value;
    const sb = getSupabase();

    try {
      const { error } = await sb.auth.signInWithPassword({ email, password: pw });
      if (error) throw error;
      window.location.reload();
    } catch (err: any) {
      if (errorBanner) {
        errorBanner.textContent = err.message || 'Login failed.';
        errorBanner.style.display = 'block';
      }
    }
  });

  // Run initial check
  checkAdminState();
</script>
