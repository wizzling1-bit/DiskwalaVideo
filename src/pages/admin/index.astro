  function wireTeraboxTableEvents() {
    const sb = getSupabase();

    // Inline category changer
    document.querySelectorAll('.js-cat-selector').forEach(sel => {
      sel.addEventListener('change', async (e) => {
        const videoId = sel.getAttribute('data-video-id');
        const newCat = (e.target as HTMLSelectElement).value;
        if (!videoId) return;

        try {
          const { error } = await sb.from('terabox_videos').update({ category: newCat }).eq('id', videoId);
          if (error) throw error;
          // Update local list
          const target = allTeraboxVideos.find(v => v.id === videoId);
          if (target) target.category = newCat;
          updateTeraboxMetrics(allTeraboxVideos);
          showAdminToast('Category updated to ' + newCat);
        } catch (err: any) {
          showAdminToast('Error updating category: ' + err.message, true);
        }
      });
    });

    // Copy link button
    document.querySelectorAll('.js-copy-link-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const url = btn.getAttribute('data-url');
        if (url) {
          try {
            await navigator.clipboard.writeText(url);
            showAdminToast('Copied link: ' + url);
          } catch {
            prompt('Copy link:', url);
          }
        }
      });
    });

    // Delete button
    document.querySelectorAll('.js-delete-video-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const videoId = btn.getAttribute('data-id');
        if (!videoId) return;
        if (confirm('Delete this video from Viral TeraBox Hub?')) {
          try {
            const { error } = await sb.from('terabox_videos').delete().eq('id', videoId);
            if (error) throw error;
            allTeraboxVideos = allTeraboxVideos.filter(v => v.id !== videoId);
            updateTeraboxMetrics(allTeraboxVideos);
            renderTeraboxVideos(allTeraboxVideos);
            showAdminToast('Video deleted successfully.');
          } catch (err: any) {
            showAdminToast('Error deleting video: ' + err.message, true);
          }
        }
      });
    });
  }

