  }
  .user-row-email,
  .payment-row-id,
  .link-row-title {
    font-weight: 700;
    color: #ffffff;
  }
  .user-row-sub {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  :root[data-theme="light"] .user-row-email,
  :root[data-theme="light"] .payment-row-id,
  :root[data-theme="light"] .link-row-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .user-row-sub {
