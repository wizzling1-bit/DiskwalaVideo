  function updateSingleThumbPreview(url: string) {
    if (!tbvThumbPreviewImg || !tbvThumbPreviewPlaceholder) return;
    const clean = (url || '').trim();
    if (clean && !clean.startsWith('data:image/svg')) {
      tbvThumbPreviewImg.src = clean;
      tbvThumbPreviewImg.style.display = 'block';
      tbvThumbPreviewPlaceholder.style.display = 'none';
      tbvThumbPreviewImg.onerror = () => {
        tbvThumbPreviewImg.style.display = 'none';
        tbvThumbPreviewPlaceholder.style.display = 'block';
        tbvThumbPreviewPlaceholder.textContent = 'ERR';
      };
    } else {
      tbvThumbPreviewImg.style.display = 'none';
      tbvThumbPreviewPlaceholder.style.display = 'block';
      tbvThumbPreviewPlaceholder.textContent = 'NO IMG';
    }
  }

  tbvSingleThumb?.addEventListener('input', () => {
    updateSingleThumbPreview(tbvSingleThumb?.value || '');
  });

