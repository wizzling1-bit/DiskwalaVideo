    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: 0.78rem;
    font-family: inherit;
    transition: all 0.2s;
  }
  .search-input.has-icon {
    padding-left: 34px;
    width: 220px;
  }
  .search-input:focus {
    outline: none;
    border-color: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }
  .select-styled {
    cursor: pointer;
  }
  .tbl-badge-counter {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 9999px;
    background: rgba(16, 214, 160, 0.12);
    border: 1px solid rgba(16, 214, 160, 0.35);
    color: #10D6A0;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .btn-subtle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 650;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-subtle:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn-subtle:active {
    transform: scale(0.97);
  }

  /* ========================================================
     DATA TABLE & CELL TYPOGRAPHY
     ======================================================== */
  .table-responsive {
    overflow-x: auto;
    border-radius: 12px;
  }
  .admin-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    text-align: left;
  }
  .admin-data-table th {
    padding: 13px 14px;
    color: var(--color-text-muted);
    font-weight: 750;
    text-transform: uppercase;
    font-size: 0.67rem;
    letter-spacing: 0.06em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.15);
  }
  .admin-data-table td {
    padding: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary);
    vertical-align: middle;
  }
  .admin-data-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Badges */
  .badge-vip {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(16, 185, 129, 0.18);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.4);
  }
  .badge-free {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.07);
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .badge-admin {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: rgba(239, 68, 68, 0.18);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
  }

  /* Action Buttons Cluster in Tables */
  .tbl-actions-cluster {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .btn-tbl-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 6px 11px;
    border-radius: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid transparent;
    text-decoration: none;
    font-family: inherit;
    line-height: 1;
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--color-text-secondary);
  }
  .btn-tbl-action:active {
    transform: scale(0.96);
  }
  .btn-tbl-play {
    background: rgba(16, 214, 160, 0.14);
    border-color: rgba(16, 214, 160, 0.35);
    color: #10D6A0;
  }
  .btn-tbl-play:hover {
    background: #10D6A0;
    color: #070A09;
    box-shadow: 0 4px 14px rgba(16, 214, 160, 0.35);
  }
  .btn-tbl-icon {
    padding: 6px 9px;
  }
  .btn-tbl-icon:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }
  .btn-tbl-danger {
    padding: 6px 9px;
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.3);
    color: #f87171;
  }
  .btn-tbl-danger:hover {
    background: #ef4444;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(239, 68, 68, 0.35);
  }
  .btn-tbl-vip {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(52, 211, 153, 0.35);
    color: #34d399;
  }
  .btn-tbl-vip:hover {
    background: #10b981;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
  }
  .btn-tbl-admin {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    color: #fbbf24;
  }
  .btn-tbl-admin:hover {
    background: #f59e0b;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.3);
  }
  .btn-tbl-limit {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--color-text-secondary);
  }
  .btn-tbl-limit:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }
  .btn-tbl-neutral {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    color: #94a3b8;
  }
  .btn-tbl-neutral:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }
  .user-quota-badge {
    font-weight: 750;
    color: #10b981;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
  .user-quota-badge.is-unlimited {
    color: #38bdf8;
  }

  /* Video Catalog Row Elements */
  .tbl-video-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .tbl-thumb-wrap {
    position: relative;
    width: 64px !important;
    height: 40px !important;
    min-width: 64px !important;
    max-width: 64px !important;
    border-radius: 7px;
    overflow: hidden;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }
  .tbl-video-thumb {
    width: 64px !important;
    height: 40px !important;
    min-width: 64px !important;
    max-width: 64px !important;
    object-fit: cover !important;
    display: block !important;
    border-radius: 6px;
    transition: transform 0.25s ease;
  }
  .tbl-thumb-wrap:hover .tbl-video-thumb {
    transform: scale(1.08);
  }
  .tbl-thumb-play-cue {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    color: #ffffff;
    font-size: 11px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .tbl-thumb-wrap:hover .tbl-thumb-play-cue {
    opacity: 1;
  }
  .tbl-video-info {
    min-width: 0;
    max-width: 280px;
  }
  .tbl-video-link {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    text-decoration: none;
    margin-top: 2px;
  }
  .tbl-video-link:hover {
    color: #10D6A0;
    text-decoration: underline;
  }
  .quality-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .q-1080p {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.35);
  }
  .q-2k, .q-4k {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.35);
  }
  .q-720p {
    background: rgba(16, 214, 160, 0.15);
    color: #10D6A0;
    border: 1px solid rgba(16, 214, 160, 0.35);
  }
  .q-480p, .q-360p {
    background: rgba(148, 163, 184, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }
  .tbl-cat-select {
    padding: 4px 8px;
    font-size: 0.72rem;
    height: 30px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    cursor: pointer;
  }
  .tbl-file-meta {
    font-size: 0.78rem;
    font-weight: 650;
    color: #ffffff;
  }
  .tbl-date-sub {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  .tbl-views-count {
    font-size: 0.85rem;
    font-weight: 800;
    color: #10D6A0;
    font-variant-numeric: tabular-nums;
  }

  /* Legacy fallback support */
  .btn-action-small {
    padding: 6px 11px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    margin-right: 4px;
    transition: all 0.15s;
  }
  .btn-action-small:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: rgba(52, 211, 153, 0.4);
    color: #34d399;
  }

  /* ========================================================
     SETTINGS GRID
     ======================================================== */
  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .settings-card {
    background: linear-gradient(180deg, rgba(13, 20, 23, 0.92) 0%, rgba(9, 14, 16, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 24px;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5);
  }
  .settings-title {
    font-size: var(--text-base);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .settings-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .setting-input-row {
    display: flex;
    gap: 10px;
  }
  .setting-input-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .setting-number-input,
  .setting-text-input {
    flex: 1;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-sm);
  }
  .setting-textarea {
    width: 100%;
    padding: 10px 14px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-xs);
    resize: vertical;
  }
  .btn-save-setting {
    padding: 10px 16px;
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border: 1px solid rgba(52, 211, 153, 0.4);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 750;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .btn-save-setting:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    transform: translateY(-1px);
  }

  /* Settings Card Head & Icons */
  .settings-card-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 16px;
  }
  .settings-icon {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Hub Upload Grid & Modules */
  .hub-upload-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }
  .upload-module-card {
    background: linear-gradient(180deg, rgba(13, 20, 23, 0.92) 0%, rgba(9, 14, 16, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .upload-module-featured {
    border-color: rgba(16, 214, 160, 0.35);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(16, 214, 160, 0.06);
  }
  .upload-module-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    gap: 12px;
  }
  .upload-module-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .upload-module-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .upload-module-icon.icon-emerald {
    color: #10D6A0;
    border-color: rgba(16, 214, 160, 0.3);
    background: rgba(16, 214, 160, 0.08);
  }
  .upload-module-icon.icon-blue {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.3);
    background: rgba(56, 189, 248, 0.08);
  }
  .upload-module-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .upload-module-sub {
    font-size: 0.72rem;
    color: var(--color-text-secondary);
  }
  .upload-badge-pill {
    font-size: 0.68rem;
    font-weight: 750;
    background: rgba(16, 214, 160, 0.12);
    color: #10D6A0;
    border: 1px solid rgba(16, 214, 160, 0.3);
    padding: 3px 10px;
    border-radius: 99px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .upload-desc-text {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-bottom: 14px;
    line-height: 1.5;
  }
  .upload-desc-text code {
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #38bdf8;
  }
  .upload-form-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 650;
    color: var(--color-text-secondary);
    margin-bottom: 5px;
  }
  .upload-grid-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
  }
  .upload-grid-4col {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 14px;
  }

  /* Table Empty States */
  .tbl-empty-state {
    padding: 40px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .tbl-empty-icon {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .tbl-empty-title {
    font-size: 0.95rem;
    font-weight: 750;
    color: #ffffff;
    margin-bottom: 4px;
  }
  .tbl-empty-desc {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    max-width: 380px;
    margin: 0 auto;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .admin-metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .admin-topbar {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 16px;
    }
    .topbar-right {
      justify-content: space-between;
      width: 100%;
    }
    .admin-tabs-nav {
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .admin-tabs-nav::-webkit-scrollbar {
      display: none;
    }
    .admin-tab-btn {
      white-space: nowrap;
      flex-shrink: 0;
      padding: 8px 14px;
    }
    .table-card-header {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .table-actions {
      flex-direction: column;
      width: 100%;
    }
    .search-input {
      width: 100%;
    }
    .setting-input-row {
      flex-direction: column;
    }
    .btn-save-setting {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .admin-metrics-grid {
      grid-template-columns: 1fr;
    }
    .table-card {
      padding: 16px 12px;
    }
    .table-responsive {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin: 0 -4px;
    }
    .admin-data-table {
      min-width: 580px;
    }
    .admin-data-table th, .admin-data-table td {
      padding: 10px 8px;
    }
  }

  @media (max-width: 480px) {
    .admin-console-section {
      padding: 16px 10px 40px;
    }
    .admin-gate-card {
      padding: 24px 14px 20px;
      border-radius: var(--radius-lg);
    }
    .admin-gate-title {
      font-size: 1.4rem;
    }
    .gate-input {
      font-size: 16px !important;
      height: 48px;
    }
    .gate-submit-btn {
      min-height: 48px;
      font-size: 15px;
    }
    .admin-topbar {
      padding: 12px 14px;
      border-radius: var(--radius-lg);
    }
    .topbar-title {
      font-size: 1.15rem;
    }
  }

  /* Light Mode Styling for Admin Console */
  :root[data-theme="light"] .admin-topbar {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important;
  }
  :root[data-theme="light"] .topbar-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .metric-glass-card {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05), inset 0 1px 0 #ffffff !important;
  }
  :root[data-theme="light"] .metric-val {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .icon-circle {
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
  }
  :root[data-theme="light"] .admin-tabs-nav {
    background: #f1f5f9 !important;
    border-color: #e2e8f0 !important;
  }
  :root[data-theme="light"] .admin-tab-btn {
    color: #475569 !important;
  }
  :root[data-theme="light"] .admin-tab-btn:hover {
    color: #0f172a !important;
    background: #e2e8f0 !important;
  }
  :root[data-theme="light"] .admin-tab-btn.is-active {
    background: #ffffff !important;
    color: #059669 !important;
    border-color: rgba(16, 185, 129, 0.4) !important;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06) !important;
  }
  :root[data-theme="light"] .table-card {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.06), inset 0 1px 0 #ffffff !important;
  }
  :root[data-theme="light"] .table-card-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .admin-data-table th {
    background: #f8fafc !important;
    border-bottom-color: #e2e8f0 !important;
    color: #64748b !important;
  }
  :root[data-theme="light"] .admin-data-table td {
    border-bottom-color: #f1f5f9 !important;
    color: #334155 !important;
  }
  :root[data-theme="light"] .admin-data-table tr:hover td {
    background: #f8fafc !important;
  }
  :root[data-theme="light"] .hub-stat-tile {
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
  }
  :root[data-theme="light"] .hub-stat-tile:hover {
