  // Bulk Link Upload: Instant Import
  tbvBulkForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const text = tbvBulkTextarea?.value.trim();
    if (!text) return;

    const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    if (lines.length === 0) return;

    if (tbvBulkImportBtn) tbvBulkImportBtn.disabled = true;
    if (tbvBulkProgress) tbvBulkProgress.style.display = 'block';
    if (tbvProgressBar) tbvProgressBar.style.width = '20%';
    if (tbvProgressText) tbvProgressText.textContent = `Preparing ${lines.length} videos...`;

    const defaultCat = tbvBulkCategory?.value || 'trending';
    const defaultQuality = tbvBulkQuality?.value || '1080P';
    const sb = getSupabase();

    const records = lines.map((line, idx) => {
      let url = line;
      let title = '';
      let quality = defaultQuality;

      if (line.includes('|')) {
        const parts = line.split('|').map(p => p.trim());
        url = parts[0];
        if (parts[1]) title = parts[1];
        if (parts[2]) quality = parts[2];
      }

      if (!title) {
        // Generate nice clean title from URL or numbered
        try {
          const u = new URL(url);
          const slug = u.pathname.split('/').filter(Boolean).pop() || '';
          title = `Viral Clip ${slug.substring(0, 10)}.mp4`;
        } catch {
          title = `Viral Video Clip #${idx + 1}.mp4`;
        }
      }

      const thumb = DEFAULT_VIDEO_THUMBNAIL;

      return {
        id: 'tbv_bulk_' + Date.now() + '_' + idx + '_' + Math.random().toString(36).substring(2, 5),
        title,
        terabox_url: url,
        thumbnail_url: thumb,
        quality,
        duration: '--:--',
        file_size: '--',
        views_count: 0,
        category: defaultCat,
        is_vip: true,
        created_at: new Date().toISOString()
      };
    });

    if (tbvProgressBar) tbvProgressBar.style.width = '70%';
    if (tbvProgressText) tbvProgressText.textContent = `Saving ${records.length} videos to database...`;

    try {
      const { error } = await sb.from('terabox_videos').insert(records);
      if (error) throw error;

      if (tbvProgressBar) tbvProgressBar.style.width = '100%';
      if (tbvProgressText) tbvProgressText.textContent = `Completed! ${records.length} videos published.`;

      showAdminToast(`⚡ Successfully imported and published ${records.length} videos!`);
      tbvBulkForm.reset();
      await loadTeraboxVideos();
    } catch (err: any) {
      showAdminToast('Bulk import error: ' + err.message, true);
    } finally {
      if (tbvBulkImportBtn) tbvBulkImportBtn.disabled = false;
      setTimeout(() => {
        if (tbvBulkProgress) tbvBulkProgress.style.display = 'none';
      }, 2500);
    }
  });

  // Bulk Link Upload: Deep Resolve via API
  tbvBulkResolveBtn?.addEventListener('click', async () => {
    const text = tbvBulkTextarea?.value.trim();
    if (!text) {
      showAdminToast('Please paste TeraBox links in the bulk textarea first.', true);
      tbvBulkTextarea?.focus();
      return;
    }

    const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0);
    if (lines.length === 0) return;

    if (tbvBulkResolveBtn) tbvBulkResolveBtn.disabled = true;
    if (tbvBulkProgress) tbvBulkProgress.style.display = 'block';

    const defaultCat = tbvBulkCategory?.value || 'trending';
    const defaultQuality = tbvBulkQuality?.value || '1080P';
    const sb = getSupabase();
    const resolvedRecords: any[] = [];

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      let url = line.includes('|') ? line.split('|')[0].trim() : line;
      const pct = Math.round(((i + 1) / lines.length) * 100);

      if (tbvProgressBar) tbvProgressBar.style.width = `${pct}%`;
      if (tbvProgressText) tbvProgressText.textContent = `Resolving link ${i + 1} of ${lines.length} via TeraBox API...`;

      let title = '';
      let thumb = '';
      let size = '';
      let duration = '';

      try {
        const meta = await fetchTeraBoxMetadata(url);
        if (meta) {
          title = meta.file_name || '';
          thumb = meta.thumb || meta.image || '';
          size = formatBytes(meta.size);
          if (meta.duration) {
            const sec = parseInt(meta.duration, 10);
            if (!isNaN(sec)) {
              duration = `0${Math.floor(sec / 60)}:${sec % 60 < 10 ? '0' : ''}${sec % 60}`;
            }
          }
        }
      } catch {}

      if (!title) {
        try {
          const u = new URL(url);
          const slug = u.pathname.split('/').filter(Boolean).pop() || '';
          title = `Viral Video ${slug.substring(0, 10)}.mp4`;
        } catch {
          title = `Viral Video Clip #${i + 1}.mp4`;
        }
      }

      if (!thumb) {
        thumb = DEFAULT_VIDEO_THUMBNAIL;
      }
      if (!size) size = '--';
      if (!duration) duration = '--:--';

      resolvedRecords.push({
        id: 'tbv_res_' + Date.now() + '_' + i + '_' + Math.random().toString(36).substring(2, 5),
        title,
        terabox_url: url,
        thumbnail_url: thumb,
        quality: defaultQuality,
        duration,
        file_size: size,
        views_count: 0,
        category: defaultCat,
        is_vip: true,
        created_at: new Date().toISOString()
      });

      // Small pause to avoid hitting rate limits
      await new Promise(r => setTimeout(r, 200));
    }

    if (tbvProgressText) tbvProgressText.textContent = `Saving ${resolvedRecords.length} resolved records to database...`;

    try {
      const { error } = await sb.from('terabox_videos').insert(resolvedRecords);
      if (error) throw error;

      showAdminToast(`✨ Deep Resolve Complete! Successfully published ${resolvedRecords.length} videos.`);
      if (tbvBulkTextarea) tbvBulkTextarea.value = '';
      await loadTeraboxVideos();
    } catch (err: any) {
      showAdminToast('Error saving resolved videos: ' + err.message, true);
    } finally {
      if (tbvBulkResolveBtn) tbvBulkResolveBtn.disabled = false;
      setTimeout(() => {
        if (tbvBulkProgress) tbvBulkProgress.style.display = 'none';
      }, 2500);
    }
  });

  // Table Search and Category Filtering
  tbvSearchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    const cat = tbvCategoryFilter?.value || 'all';
    filterTeraboxTable(q, cat);
  });

  tbvCategoryFilter?.addEventListener('change', (e) => {
    const cat = (e.target as HTMLSelectElement).value;
    const q = tbvSearchInput?.value.toLowerCase().trim() || '';
    filterTeraboxTable(q, cat);
  });

  function filterTeraboxTable(query: string, category: string) {
    const filtered = allTeraboxVideos.filter(v => {
      const matchQuery = !query || 
        (v.title || '').toLowerCase().includes(query) || 
        (v.terabox_url || '').toLowerCase().includes(query);
      const matchCat = category === 'all' || v.category === category;
      return matchQuery && matchCat;
    });
    renderTeraboxVideos(filtered);
  }

  // Tab Switching
  document.querySelectorAll('.admin-tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.admin-tab-btn').forEach(b => b.classList.remove('is-active'));
      document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.remove('is-active'));

      btn.classList.add('is-active');
      const tabId = btn.getAttribute('data-tab');
      if (tabId) {
        document.getElementById(tabId)?.classList.add('is-active');
        if (tabId === 'tab-terabox-videos') {
          loadTeraboxVideos();
        }
      }
    });
  });

  // Support URL hash or query param for direct tab access (e.g. /admin/#tab-terabox-videos or /admin/?tab=tab-terabox-videos)
  const hashTab = window.location.hash ? window.location.hash.replace('#', '') : '';
  const searchTab = new URLSearchParams(window.location.search).get('tab');
  const targetTabId = searchTab || hashTab;
  if (targetTabId) {
    const targetBtn = document.querySelector(`.admin-tab-btn[data-tab="${targetTabId}"]`) as HTMLElement | null;
    if (targetBtn) {
      setTimeout(() => targetBtn.click(), 120);
    }
  }

  // Search filter
  document.getElementById('user-search-input')?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    const filtered = allUsersList.filter(u => 
      (u.email || '').toLowerCase().includes(query) || 
      (u.full_name || '').toLowerCase().includes(query)
    );
    renderUsers(filtered);
  });

  // Refreshes
  document.getElementById('refresh-users-btn')?.addEventListener('click', loadUsers);
  document.getElementById('refresh-payments-btn')?.addEventListener('click', loadPayments);
  document.getElementById('refresh-links-btn')?.addEventListener('click', loadLinks);
  document.getElementById('refresh-tbv-btn')?.addEventListener('click', loadTeraboxVideos);

  // Logout
  document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
    if (confirm('Log out from Admin Console?')) {
      await signOutUser();
      window.location.href = '/';
    }
  });

  // Cloudflare Turnstile explicit render for admin login
  let adminTurnstileWidgetId: any = null;
  function initAdminTurnstile() {
    const container = document.getElementById('admin-turnstile-container');
    if (!container || adminTurnstileWidgetId !== null) return;
    const turnstileObj = (window as any).turnstile;
    if (turnstileObj && typeof turnstileObj.render === 'function') {
      try {
        adminTurnstileWidgetId = turnstileObj.render(container, {
          sitekey: APP_CONFIG.turnstile?.siteKey || '1x00000000000000000000AA',
          theme: 'dark'
        });
      } catch (err) {
        console.warn('Turnstile render warning:', err);
      }
    }
  }

  if (typeof window !== 'undefined') {
    if ((window as any).turnstile) {
      initAdminTurnstile();
    } else {
      const turnstilePoll = setInterval(() => {
        if ((window as any).turnstile) {
          clearInterval(turnstilePoll);
          initAdminTurnstile();
        }
      }, 250);
      setTimeout(() => clearInterval(turnstilePoll), 6000);
    }
  }

  // Admin login form submission
  document.getElementById('admin-login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('admin-email') as HTMLInputElement).value.trim();
    const pw = (document.getElementById('admin-password') as HTMLInputElement).value;
    const sb = getSupabase();

    // Verify Cloudflare Turnstile token
    const turnstileObj = (window as any).turnstile;
    if (turnstileObj && adminTurnstileWidgetId !== null) {
      const token = turnstileObj.getResponse(adminTurnstileWidgetId);
      if (!token) {
        if (errorBanner) {
          errorBanner.textContent = 'Please complete the Cloudflare security verification to sign in.';
          errorBanner.style.display = 'block';
        }
        return;
      }
    }

    try {
      const { error } = await sb.auth.signInWithPassword({ email, password: pw });
      if (error) throw error;
      window.location.reload();
    } catch (err: any) {
      if (errorBanner) {
        errorBanner.textContent = err.message || 'Login failed.';
        errorBanner.style.display = 'block';
      }
      if (turnstileObj && adminTurnstileWidgetId !== null) {
        try { turnstileObj.reset(adminTurnstileWidgetId); } catch {}
      }
    }
  });

  // Run initial check
  checkAdminState();
</script>
