---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { APP_CONFIG } from '../../utils/config';

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Admin Console", href: "/admin/" }
];
---

<BaseLayout 
  title="Admin Console & Management Dashboard — TeraWala" 
  description="Manage users, subscriptions, Razorpay transactions, daily link quotas, and site settings."
  noindex={true}
>
  <div class="admin-wrapper">
    <div class="container container-admin">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Checking Admin Authorization State -->
      <div id="admin-auth-checking" class="admin-state-box">
        <div class="admin-spinner"></div>
        <p>Verifying admin security credentials...</p>
      </div>

      <!-- Access Denied / Admin Login Form -->
      <div id="admin-gate-card" class="admin-gate-card" style="display: none;">
        <div class="admin-shield-icon">
          <img src="/logo.svg" alt="TeraWala Admin" width="56" height="56" class="admin-gate-logo" />
        </div>
        <h1 class="admin-gate-title">TeraWala Admin Console</h1>
        <p class="admin-gate-desc" id="admin-gate-msg">
          Sign in with an administrator account to access platform metrics, users, and financial logs.
        </p>

        <div id="gate-error-banner" class="gate-error-banner" style="display: none;"></div>

        <form id="admin-login-form" class="admin-login-form">
          <div class="admin-field">
            <label for="admin-email">Admin Email</label>
            <input type="email" id="admin-email" required placeholder="admin@terawala.com" />
          </div>

          <div class="admin-field">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <label for="admin-password" style="margin-bottom: 0;">Password</label>
              <a href="/login/" id="admin-forgot-pw-link" style="font-size: 0.72rem; color: #10D6A0; text-decoration: none;">Forgot password?</a>
            </div>
            <input type="password" id="admin-password" required placeholder="••••••••" />
          </div>

          <!-- Cloudflare Turnstile Verification -->
          <div id="admin-turnstile-container" style="display: flex; justify-content: center; margin: 16px 0; min-height: 65px;"></div>

          <button type="submit" class="btn-admin-submit" id="admin-login-btn">
            <span>Unlock Admin Console</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </form>
      </div>

      <!-- MAIN ADMIN DASHBOARD -->
      <div id="admin-main-panel" class="admin-main-panel" style="display: none;">
        
        <!-- Top Nav / Bar -->
        <div class="admin-topbar">
          <div class="topbar-left">
            <img src="/logo.svg" alt="TeraWala" width="34" height="34" class="topbar-brand-logo" />
            <div>
              <h1 class="topbar-title">TeraWala Control Hub</h1>
              <span class="topbar-sub">Super Admin Management & Analytics</span>
            </div>
          </div>

          <div class="topbar-right">
            <div class="admin-user-pill">
              <span class="admin-user-dot"></span>
              <span id="adm-current-user-email">Administrator</span>
            </div>
            <div class="system-status-chip">
              <span class="status-dot"></span>
              <span>Supabase & Razorpay Active</span>
            </div>
            <button type="button" class="btn-admin-theme-toggle" id="admin-theme-toggle" title="Toggle Light/Dark Theme" aria-label="Toggle Theme">
              <svg class="theme-icon-sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            </button>
            <button type="button" class="btn-admin-logout" id="admin-logout-btn">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              <span>Sign Out</span>
            </button>
          </div>
        </div>

        <!-- 4 Metric Cards -->
        <div class="admin-metrics-grid">
          <!-- Total Users -->
          <div class="metric-glass-card">
            <div class="metric-head">
              <span class="label">Total Users</span>
              <div class="icon-circle icon-green">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
            </div>
            <div class="metric-val" id="adm-total-users">0</div>
            <span class="metric-note">Registered profiles</span>
          </div>

          <!-- VIP Subscribers -->
          <div class="metric-glass-card">
            <div class="metric-head">
              <span class="label">Premium Subscribers</span>
              <div class="icon-circle icon-amber">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path></svg>
              </div>
            </div>
            <div class="metric-val" id="adm-vip-users">0</div>
            <span class="metric-note">Active premium tier</span>
          </div>

          <!-- Total Links -->
          <div class="metric-glass-card">
            <div class="metric-head">
              <span class="label">Links Processed</span>
              <div class="icon-circle icon-blue">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              </div>
            </div>
            <div class="metric-val" id="adm-total-links">0</div>
            <span class="metric-note" id="adm-today-links">0 today</span>
          </div>

          <!-- Total Revenue -->
          <div class="metric-glass-card">
            <div class="metric-head">
              <span class="label">Revenue (Razorpay)</span>
              <div class="icon-circle icon-emerald">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
              </div>
            </div>
            <div class="metric-val" id="adm-total-rev">₹0</div>
            <span class="metric-note">Live Gross Transactions</span>
          </div>
        </div>

        <!-- Tab Switcher -->
        <div class="admin-tabs-nav" role="tablist">
          <button type="button" class="admin-tab-btn is-active" data-tab="tab-users">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            <span>Users</span>
          </button>
          <button type="button" class="admin-tab-btn" data-tab="tab-payments">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            <span>Razorpay Payments</span>
          </button>
          <button type="button" class="admin-tab-btn" data-tab="tab-links">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            <span>Link Stream Logs</span>
          </button>
          <button type="button" class="admin-tab-btn" data-tab="tab-settings">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            <span>Site Settings</span>
          </button>
          <button type="button" class="admin-tab-btn" data-tab="tab-terabox-videos" style="color: #10D6A0; border-color: rgba(16, 214, 160, 0.35);">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Viral TeraBox Hub</span>
          </button>
        </div>

        <!-- TAB 1: USER MANAGEMENT -->
        <section id="tab-users" class="admin-tab-content is-active">
          <div class="table-card">
            <div class="table-card-header">
              <div>
                <h2 class="table-card-title">User Accounts</h2>
                <p class="table-card-sub">Manage membership tiers, roles, and daily quotas</p>
              </div>
              <div class="table-actions">
                <div class="search-input-wrap">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="search-icon-svg" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <input type="text" id="user-search-input" placeholder="Search email or name..." class="search-input has-icon" />
                </div>
                <button type="button" class="btn-subtle" id="refresh-users-btn">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M23 4v6h-6"></path><path d="M1 20v-6h6"></path><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                  <span>Refresh</span>
                </button>
              </div>
            </div>

            <div class="table-responsive">
              <table class="admin-data-table">
                <thead>
                  <tr>
                    <th style="min-width: 220px;">User</th>
                    <th style="width: 100px;">Role</th>
                    <th style="width: 130px;">Tier</th>
                    <th style="width: 150px;">Daily Quota</th>
                    <th style="width: 120px;">Joined</th>
                    <th style="min-width: 270px;">Actions</th>
                  </tr>
                </thead>
                <tbody id="admin-users-tbody">
                  <!-- Populated via script -->
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- TAB 2: RAZORPAY PAYMENTS -->
        <section id="tab-payments" class="admin-tab-content">
          <div class="table-card">
            <div class="table-card-header">
              <div>
                <h2 class="table-card-title">Razorpay Transaction Records</h2>
                <p class="table-card-sub">Live log of verified subscriptions and payments</p>
              </div>
              <button type="button" class="btn-subtle" id="refresh-payments-btn">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"></path><path d="M1 20v-6h6"></path><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                <span>Refresh</span>
              </button>
            </div>

            <div class="table-responsive">
              <table class="admin-data-table">
                <thead>
                  <tr>
                    <th style="min-width: 160px;">Payment ID</th>
                    <th style="min-width: 200px;">User Email</th>
                    <th style="width: 130px;">Plan</th>
                    <th style="width: 110px;">Amount</th>
                    <th style="width: 110px;">Status</th>
                    <th style="width: 120px;">Valid Until</th>
                    <th style="width: 150px;">Date</th>
                  </tr>
                </thead>
                <tbody id="admin-payments-tbody">
                  <!-- Populated via script -->
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- TAB 3: LINK ACTIVITY STREAM -->
        <section id="tab-links" class="admin-tab-content">
          <div class="table-card">
            <div class="table-card-header">
              <div>
                <h2 class="table-card-title">Live Link Processing Feed</h2>
                <p class="table-card-sub">Real-time log of Terabox and Diskwala links resolved across TeraWala</p>
              </div>
              <button type="button" class="btn-subtle" id="refresh-links-btn">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"></path><path d="M1 20v-6h6"></path><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                <span>Refresh</span>
              </button>
            </div>

            <div class="table-responsive">
              <table class="admin-data-table">
                <thead>
                  <tr>
                    <th style="min-width: 280px;">File / URL</th>
                    <th style="width: 110px;">Provider</th>
                    <th style="min-width: 180px;">User / Guest</th>
                    <th style="width: 120px;">Status</th>
                    <th style="width: 160px;">Time</th>
                  </tr>
                </thead>
                <tbody id="admin-links-tbody">
                  <!-- Populated via script -->
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- TAB 4: SITE SETTINGS -->
        <section id="tab-settings" class="admin-tab-content">
          <div class="settings-grid">
            <!-- Setting 1: Free Daily Quota -->
            <div class="settings-card">
              <div class="settings-card-head">
                <div class="settings-icon icon-emerald">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path></svg>
                </div>
                <div>
                  <h3 class="settings-title">Free Daily Link Limit</h3>
                  <p class="settings-desc">Set the maximum free video links allowed per day for unregistered/free tier users.</p>
                </div>
              </div>
              <div class="setting-input-row">
                <input type="number" id="setting-free-limit" min="1" max="100" class="setting-number-input" />
                <button type="button" class="btn-save-setting" id="save-limit-btn">Update Limit</button>
              </div>
            </div>

            <!-- Setting 2: Global Announcement -->
            <div class="settings-card">
              <div class="settings-card-head">
                <div class="settings-icon icon-amber">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                </div>
                <div>
                  <h3 class="settings-title">Global Banner Announcement</h3>
                  <p class="settings-desc">Broadcast a message banner to all visitors at the top of the platform.</p>
                </div>
              </div>
              <div class="setting-input-col">
                <textarea id="setting-announcement-text" rows="3" class="setting-textarea" placeholder="Welcome to TeraWala!"></textarea>
                <button type="button" class="btn-save-setting" id="save-announcement-btn">Save Announcement</button>
              </div>
            </div>

            <!-- Setting 3: Telegram Community URL -->
            <div class="settings-card">
              <div class="settings-card-head">
                <div class="settings-icon icon-blue">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </div>
                <div>
                  <h3 class="settings-title">Official Telegram Channel</h3>
                  <p class="settings-desc">URL linked across floating buttons and Telegram call-to-actions.</p>
                </div>
              </div>
              <div class="setting-input-row">
                <input type="url" id="setting-telegram-url" class="setting-text-input" value="https://telegram.me/terawala_official" />
                <button type="button" class="btn-save-setting" id="save-tg-btn">Update Telegram</button>
              </div>
            </div>
          </div>
        </section>

        <!-- TAB 5: VIRAL TERABOX VIDEOS HUB -->
        <section id="tab-terabox-videos" class="admin-tab-content">
          <!-- Hub Header Card -->
          <div class="table-card" style="margin-bottom: 24px;">
            <div class="table-card-header">
              <div>
                <h2 class="table-card-title" style="display: flex; align-items: center; gap: 8px;">
                  <span style="color: #FF2E93;">🔥</span>
                  <span>Viral TeraBox Videos Hub Manager</span>
                </h2>
                <p class="table-card-sub">Upload single or bulk TeraBox links, auto-extract metadata, and manage the live video stream for TeraViralHub.</p>
              </div>
              <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <a href="http://localhost:4322/" target="_blank" rel="noopener noreferrer" class="btn-subtle btn-hub-link">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                  <span>Open TeraViralHub (Port 4322)</span>
                </a>
                <button type="button" class="btn-subtle" id="refresh-tbv-btn">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"></path><path d="M1 20v-6h6"></path><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                  <span>Refresh Videos</span>
                </button>
              </div>
            </div>

            <!-- Hub Mini Metrics -->
            <div class="hub-stat-grid">
              <div class="hub-stat-tile">
                <div class="hub-stat-head">
                  <span class="hub-stat-dot dot-emerald"></span>
                  <span class="hub-stat-label">Total Published</span>
                </div>
                <div class="hub-stat-val" id="tbv-stat-total">0</div>
                <span class="hub-stat-hint">Active in database</span>
              </div>
              <div class="hub-stat-tile">
                <div class="hub-stat-head">
                  <span class="hub-stat-dot dot-pink"></span>
                  <span class="hub-stat-label">Trending Stream</span>
                </div>
                <div class="hub-stat-val val-pink" id="tbv-stat-trending">0</div>
                <span class="hub-stat-hint">Viral spotlight feed</span>
              </div>
              <div class="hub-stat-tile">
                <div class="hub-stat-head">
                  <span class="hub-stat-dot dot-cyan"></span>
                  <span class="hub-stat-label">Total Stream Views</span>
                </div>
                <div class="hub-stat-val val-emerald" id="tbv-stat-views">0</div>
                <span class="hub-stat-hint">Global playback logs</span>
              </div>
              <div class="hub-stat-tile">
                <div class="hub-stat-head">
                  <span class="hub-stat-dot dot-blue"></span>
                  <span class="hub-stat-label">1080p Full HD Items</span>
                </div>
                <div class="hub-stat-val val-blue" id="tbv-stat-hd">0</div>
                <span class="hub-stat-hint">High fidelity bitrates</span>
              </div>
            </div>
          </div>

          <!-- Video Upload Modules Grid -->
          <div class="hub-upload-grid">
            
            <!-- Module 1: Bulk Link Upload -->
            <div class="upload-module-card upload-module-featured">
              <div class="upload-module-header">
                <div class="upload-module-title-wrap">
                  <div class="upload-module-icon icon-emerald">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                  </div>
                  <div>
                    <h3 class="upload-module-title">Bulk TeraBox Link Upload</h3>
                    <span class="upload-module-sub">Mass import and batch queue</span>
                  </div>
                </div>
                <span class="upload-badge-pill">BULK IMPORT</span>
              </div>
              <p class="upload-desc-text">
                Paste multiple TeraBox video links (one per line). Format can be <code>URL</code> or <code>URL | Custom Title | Quality</code>.
              </p>

              <form id="tbv-bulk-form">
                <textarea 
                  id="tbv-bulk-textarea" 
                  rows="5" 
                  class="search-input" 
                  style="width: 100%; font-family: var(--font-mono); font-size: 0.78rem; resize: vertical; margin-bottom: 12px; padding: 10px;"
                  placeholder="https://1024terabox.com/s/1jV4tzRwAj_9sTwW7b30sXQ&#10;https://teraboxapp.com/s/1h9Q_xZyLMN89201aB | Mallu Viral Clip.mp4 | 720P&#10;https://1024tera.com/s/1k8L209xJ991zQ"
                  required
                ></textarea>

                <div class="upload-grid-2col">
                  <div>
                    <label class="upload-form-label">Default Category</label>
                    <select id="tbv-bulk-category" class="search-input select-styled" style="width: 100%;">
                      <option value="trending">🔥 Trending</option>
                      <option value="for_you">🧭 For You</option>
                      <option value="popular">👑 Popular</option>
