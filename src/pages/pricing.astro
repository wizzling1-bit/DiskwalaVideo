---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { APP_CONFIG } from '../utils/config';

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Buy Premium", href: "/pricing/" }
];
---

<BaseLayout
  title="Buy Premium — TeraWala Unlimited Terabox & Diskwala Downloads"
  description="Buy TeraWala Premium. Get unlimited daily link resolution, 4K video stream, direct high-speed MP4 downloads, and zero wait time from ₹9."
>
  <div class="pricing-page-wrapper">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Hero Header -->
      <section class="pricing-hero">
        <div class="hero-badge-pill">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="display:inline-block; margin-right:5px;" aria-hidden="true">
            <path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path>
          </svg>
          <span>Buy Premium Cloud Access</span>
        </div>
        <h1 class="pricing-headline">
          Simple, Transparent <span class="text-gradient-green">Pricing for Everyone</span>
        </h1>
        <p class="pricing-subtext">
          Free users enjoy 5 links every day. Need more? Buy Premium for unlimited high-speed downloads, dedicated CDN proxies, and 4K online playback.
        </p>

        <!-- Dynamic Quota Alert Banner -->
        <div id="pricing-quota-banner" class="pricing-quota-banner" style="display: none;">
          <div class="quota-banner-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          </div>
          <div class="quota-banner-content">
            <strong>Daily Free Limit Reached</strong>
            <span>You have used your 5 free links for today. Select a VIP plan below for instant unlimited downloads and zero wait queues!</span>
          </div>
        </div>
      </section>

      <!-- 3 Tier Cards -->
      <div class="pricing-cards-container">
        {APP_CONFIG.plans.map(p => (
          <div class={`plan-col-card ${p.badge ? 'is-best' : ''}`}>
            {p.badge && <span class="floating-plan-pill">{p.badge}</span>}
            <div class="card-head">
              <h2 class="card-plan-title">{p.name}</h2>
              <p class="card-plan-desc">{p.description}</p>
              <div class="card-price-display">
                <span class="currency">₹</span>
                <span class="amount">{p.price}</span>
                <span class="period">/ {p.period}</span>
              </div>
            </div>

            <div class="card-features">
              <span class="features-title">What's included:</span>
              <ul class="features-list">
                {p.features.map(f => (
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>

            <button 
              type="button" 
              class={`btn-purchase-plan ${p.badge ? 'btn-popular' : ''}`}
              data-pricing-plan-id={p.id}
            >
              <span>Get Started with {p.name}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>
        ))}
      </div>

      <!-- Comparison Matrix Table -->
      <section class="comparison-section">
        <h2 class="comparison-title">Compare Free vs Premium</h2>
        <div class="table-scroll">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th>Free Tier</th>
                <th>Premium Plan</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Daily Download / Stream Limit</td>
                <td><span class="free-text">5 Links / Day</span></td>
                <td><span class="vip-highlight">Unlimited Links</span></td>
              </tr>
              <tr>
                <td>Maximum Video Resolution</td>
                <td>Standard HD (720p / 1080p)</td>
                <td><span class="vip-highlight">4K UHD & 1080p 60fps</span></td>
              </tr>
              <tr>
                <td>Server Speed & CDN Pipeline</td>
                <td>Standard Bandwidth</td>
                <td><span class="vip-highlight">Dedicated Premium High-Speed CDN</span></td>
              </tr>
              <tr>
                <td>Direct MP4 File Handoff</td>
                <td>Included</td>
                <td><span class="vip-highlight">Priority Zero-Wait Link</span></td>
              </tr>
              <tr>
                <td>Advertisement Experience</td>
                <td>Standard Clean</td>
                <td><span class="vip-highlight">100% Ad-Free Experience</span></td>
              </tr>
              <tr>
                <td>Batch Multi-file Folders</td>
                <td>Limited</td>
                <td><span class="vip-highlight">Full Folder Playlists</span></td>
              </tr>
              <tr>
                <td>Customer Support</td>
                <td>Community Telegram</td>
                <td><span class="vip-highlight">Priority Premium Support 24/7</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="pricing-faq-section">
        <h2 class="faq-section-title">Frequently Asked Questions</h2>
        <div class="faq-grid">
          <div class="faq-box">
            <h3>How does the daily 5 link limit work?</h3>
            <p>Every visitor receives 5 free video link resolutions each day. The quota resets every night at midnight. You don't need a credit card to use your 5 daily links.</p>
          </div>
          <div class="faq-box">
            <h3>What payment methods are supported?</h3>
            <p>We process payments securely via Razorpay, supporting UPI (Google Pay, PhonePe, Paytm, BHIM), Indian & International Debit/Credit Cards, and NetBanking.</p>
          </div>
          <div class="faq-box">
            <h3>Is my subscription activated immediately?</h3>
            <p>Yes! As soon as your Razorpay transaction completes, our automated server webhook immediately upgrades your account to Premium with zero delay.</p>
          </div>
          <div class="faq-box">
            <h3>Can I use my Premium account on multiple devices?</h3>
            <p>Yes. You can log into your TeraWala Premium account from your Android, iPhone, tablet, and PC browser simultaneously.</p>
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  .pricing-page-wrapper {
    padding: 30px 16px 80px;
  }
  .pricing-hero {
    text-align: center;
    max-width: 780px;
    margin: 20px auto 44px;
  }
  .hero-badge-pill {
    display: inline-flex;
    padding: 6px 16px;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(52, 211, 153, 0.35);
    color: #34d399;
    font-size: var(--text-xs);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 14px;
  }
  .pricing-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 850;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .pricing-subtext {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }
  .pricing-cards-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 60px;
  }
  .plan-col-card {
    background: rgba(11, 17, 19, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: 32px 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .plan-col-card:hover {
    transform: translateY(-4px);
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(16, 185, 129, 0.15);
  }
  .plan-col-card.is-best {
    background: linear-gradient(180deg, rgba(14, 30, 28, 0.95) 0%, rgba(8, 15, 17, 0.98) 100%);
    border: 1.5px solid rgba(16, 185, 129, 0.65);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), 0 0 35px rgba(16, 185, 129, 0.25);
  }
  .floating-plan-pill {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #10b981;
    color: #ffffff;
    padding: 4px 14px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.45);
  }
  .card-plan-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }
  .card-plan-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin-bottom: 16px;
    min-height: 34px;
  }
  .card-price-display {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 22px;
  }
  .card-price-display .currency {
    font-size: var(--text-xl);
    color: #10b981;
    font-weight: 750;
  }
  .card-price-display .amount {
    font-size: 2.5rem;
    font-weight: 850;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .card-price-display .period {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .card-features {
    margin-bottom: 26px;
    flex-grow: 1;
  }
  .features-title {
    display: block;
    font-size: 11px;
    font-weight: 750;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--text-xs);
    color: #e2e8f0;
    line-height: 1.4;
  }
  .btn-purchase-plan {
    width: 100%;
    padding: 13px 18px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 750;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s;
    font-family: inherit;
  }
  .btn-purchase-plan:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-1px);
  }
  .btn-purchase-plan.btn-popular {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border-color: rgba(52, 211, 153, 0.45);
    box-shadow: 0 4px 18px rgba(16, 185, 129, 0.35);
  }
  .btn-purchase-plan.btn-popular:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    box-shadow: 0 6px 24px rgba(16, 185, 129, 0.5);
  }

  /* Comparison Section */
  .comparison-section {
    background: rgba(10, 16, 18, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 38px 30px;
    margin-bottom: 60px;
  }
  .comparison-title {
    font-size: var(--text-2xl);
    font-weight: 850;
    color: #ffffff;
    text-align: center;
    margin-bottom: 26px;
  }
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .comparison-table {
    width: 100%;
    min-width: 460px;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }
  .comparison-table th {
    padding: 14px 16px;
    color: #ffffff;
    font-weight: 750;
    border-bottom: 2px solid rgba(255, 255, 255, 0.12);
  }
  .comparison-table td {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--color-text-secondary);
  }
  .free-text {
    color: #cbd5e1;
    font-weight: 600;
  }
  .vip-highlight {
    color: #34d399;
    font-weight: 750;
  }

  /* FAQ */
  .pricing-faq-section {
    margin-bottom: 40px;
  }
  .faq-section-title {
    font-size: var(--text-2xl);
    font-weight: 850;
    color: #ffffff;
    text-align: center;
    margin-bottom: 30px;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .faq-box {
    background: rgba(10, 15, 17, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .faq-box h3 {
    font-size: var(--text-base);
    font-weight: 750;
    color: #ffffff;
    margin-bottom: 8px;
  }
  .faq-box p {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 1080px) {
    .pricing-cards-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .pricing-cards-container {
      grid-template-columns: 1fr;
    }
    .pricing-headline {
      font-size: 1.75rem;
    }
    .plan-col-card {
      padding: 22px 16px;
    }
    .btn-plan-select {
      min-height: 48px;
      font-size: 15px;
    }
    .comparison-section {
      padding: 22px 14px;
    }
    .comparison-table th, .comparison-table td {
      padding: 12px 10px;
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 480px) {
    .pricing-headline {
      font-size: 1.55rem;
    }
    .pricing-sub {
      font-size: var(--text-xs);
    }
    .plan-col-card {
      padding: 18px 14px;
      border-radius: var(--radius-lg);
    }
    .comparison-section {
      padding: 18px 12px;
      border-radius: var(--radius-lg);
    }
    .comparison-title {
      font-size: 1.35rem;
      margin-bottom: 18px;
    }
    .faq-box {
      padding: 18px 14px;
    }
  }

  /* Light Mode Styling for Pricing */
  :root[data-theme="light"] .pricing-headline {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .plan-col-card {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
  }
  :root[data-theme="light"] .plan-col-card.is-best {
    background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%) !important;
    border-color: rgba(5, 150, 105, 0.5) !important;
  }
  :root[data-theme="light"] .card-plan-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .card-price-display .amount {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .features-list li {
    color: #334155 !important;
  }
  :root[data-theme="light"] .btn-plan-select {
    background: #ffffff !important;
    border: 1.5px solid #059669 !important;
    color: #047857 !important;
    font-weight: 800 !important;
    box-shadow: 0 2px 6px rgba(5, 150, 105, 0.08) !important;
  }
  :root[data-theme="light"] .btn-plan-select:hover {
    background: #059669 !important;
    color: #ffffff !important;
    box-shadow: 0 6px 18px rgba(5, 150, 105, 0.25) !important;
    transform: translateY(-1px) !important;
  }
  :root[data-theme="light"] .btn-plan-select.btn-highlight {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
    border: 1.5px solid #059669 !important;
    color: #ffffff !important;
    box-shadow: 0 4px 16px rgba(5, 150, 105, 0.3) !important;
  }
  :root[data-theme="light"] .btn-plan-select.btn-highlight:hover {
    background: linear-gradient(135deg, #047857 0%, #059669 100%) !important;
    box-shadow: 0 8px 22px rgba(5, 150, 105, 0.4) !important;
  }
  :root[data-theme="light"] .comparison-section {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.06) !important;
  }
  :root[data-theme="light"] .comparison-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .comparison-table th {
    color: #0f172a !important;
    border-bottom-color: #e2e8f0 !important;
  }
  :root[data-theme="light"] .comparison-table td {
    border-bottom-color: #f1f5f9 !important;
    color: #475569 !important;
  }
  :root[data-theme="light"] .faq-box {
    background: #ffffff !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
  }
  .pricing-quota-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 680px;
    margin: 20px auto 0;
    padding: 14px 20px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: var(--radius-lg);
    color: #fef3c7;
    text-align: left;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    animation: fadeIn 0.3s ease;
  }
  .quota-banner-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quota-banner-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: var(--text-xs);
    line-height: 1.45;
  }
  .quota-banner-content strong {
    color: #fbbf24;
    font-size: var(--text-sm);
    font-weight: 800;
  }

  :root[data-theme="light"] .pricing-quota-banner {
    background: #fffbeb !important;
    border-color: #fde68a !important;
    color: #92400e !important;
  }
  :root[data-theme="light"] .quota-banner-content strong {
    color: #b45309 !important;
  }
</style>

<script>
  import { startRazorpayCheckout } from '../utils/razorpay';
  import { APP_CONFIG } from '../utils/config';

  // Check URL params for quota redirect
  const params = new URLSearchParams(window.location.search);
  if (params.get('reason') === 'quota') {
    const quotaBanner = document.getElementById('pricing-quota-banner');
    if (quotaBanner) {
      quotaBanner.style.display = 'flex';
      quotaBanner.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  document.querySelectorAll('[data-pricing-plan-id]').forEach(btn => {
    btn.addEventListener('click', () => {
      const planId = btn.getAttribute('data-pricing-plan-id');
      const plan = APP_CONFIG.plans.find(p => p.id === planId);
      if (!plan) return;

      startRazorpayCheckout(plan as any, {
        onSuccess: () => {
          window.location.href = '/dashboard/?upgraded=true';
        }
      });
    });
  });
</script>
