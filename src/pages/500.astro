---
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_CONFIG } from '../utils/config';
---

<BaseLayout
  title="500 — Server Error | TeraWala"
  description="Something went wrong on our end. Head back to TeraWala to continue streaming and downloading Terabox & Diskwala videos."
  canonicalUrl="https://terawala.com/500"
  noindex={true}
>
  <section class="error-section">
    <div class="container container-hero">
      <div class="error-card card-obsidian">
        <div class="error-badge">
          <span class="error-code">500</span>
          <span class="error-dot"></span>
          <span class="error-label">SERVER ERROR</span>
        </div>

        <h1 class="error-title">
          Something Went <span class="text-gradient-green">Wrong</span>
        </h1>

        <p class="error-desc">
          We're experiencing a temporary issue. Please try again in a moment, or head back to the homepage to continue using TeraWala.
        </p>

        <div class="error-actions">
          <a href="/" class="btn-primary">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <polygon points="6 4 19 12 6 20 6 4"></polygon>
            </svg>
            <span>Back to TeraWala</span>
          </a>

          <a
            href={APP_CONFIG.telegramBotUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            <span>Use Telegram Bot Instead</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    padding: 80px 0 100px;
    min-height: calc(100vh - 280px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-card {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
    padding: 56px 40px;
    background: linear-gradient(180deg, rgba(16, 22, 24, 0.92) 0%, rgba(9, 12, 14, 0.98) 100%);
    border: 1px solid rgba(239, 68, 68, 0.2);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 40px rgba(239, 68, 68, 0.08);
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.28);
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    margin-bottom: 24px;
  }

  .error-code {
    font-weight: 850;
    color: var(--color-error);
    font-size: var(--text-sm);
  }

  .error-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
  }

  .error-label {
    font-size: var(--text-xs);
    font-weight: 750;
    color: rgba(239, 68, 68, 0.9);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .error-title {
    font-size: var(--text-3xl);
    font-weight: 850;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .error-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 500px;
    margin: 0 auto 30px;
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .error-card { padding: 36px 22px; }
    .error-title { font-size: var(--text-2xl); }
    .error-actions { flex-direction: column; }
  }
</style>
