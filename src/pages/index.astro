---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkForm from '../components/LinkForm.astro';
import MediaResult from '../components/MediaResult.astro';
import GuideSection from '../components/GuideSection.astro';
import OnlinePlayerSection from '../components/OnlinePlayerSection.astro';
import StepList from '../components/StepList.astro';
import TelegramBotGuide from '../components/TelegramBotGuide.astro';
import LinkOpenerSection from '../components/LinkOpenerSection.astro';
import MobileDesktopTips from '../components/MobileDesktopTips.astro';
import TypoVariations from '../components/TypoVariations.astro';
import PrivacySecurityCard from '../components/PrivacySecurityCard.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
---

<BaseLayout>
  <!-- Hero Section with Form and Action Cards -->
  <LinkForm />

  <!-- Unlocked Media Player & Download Result -->
  <MediaResult />

  <!-- Content & SEO Guide: The Ultimate Diskwala Guide & Bento Cards -->
  <GuideSection />

  <!-- Online Video Player Features Grid -->
  <OnlinePlayerSection />

  <!-- Step by Step Download Guide -->
  <StepList />

  <!-- Telegram Bot Integration Guide -->
  <TelegramBotGuide />

  <!-- Link Opener Engine Overview -->
  <LinkOpenerSection />

  <!-- Mobile vs Desktop Platform Usage -->
  <MobileDesktopTips />

  <!-- Common Search Typo Variations Tag Cloud -->
  <TypoVariations />

  <!-- Privacy, Zero-Log and Security Commitment -->
  <PrivacySecurityCard />

  <!-- Frequently Asked Questions Accordion -->
  <FaqAccordion />
</BaseLayout>
