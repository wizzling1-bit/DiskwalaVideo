---
// Pricing & Razorpay Upgrade Modal Component
import { APP_CONFIG } from '../utils/config';
const plans = APP_CONFIG.plans;
---

<div 
  class="pricing-modal-overlay" 
  id="pricing-modal" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="pricing-modal-title" 
  style="display: none;"
>
  <div class="pricing-modal-card" id="pricing-modal-card">
    <!-- Close Button -->
    <button type="button" class="pricing-close-btn" id="pricing-close-btn" aria-label="Close Upgrade Dialog">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Header -->
    <div class="pricing-modal-header">
      <div class="pricing-glow-badge">
        <img src="/logo.svg" alt="TeraWala" width="18" height="18" class="pricing-brand-icon" />
        <span>TeraWala Buy Premium</span>
      </div>
      <h2 class="pricing-modal-title" id="pricing-modal-title">
        Upgrade to <span class="text-gradient-green">Unlimited Downloads</span>
      </h2>
      <p class="pricing-modal-subtitle" id="pricing-modal-desc">
        Bypass daily limits, unlock 4K & 1080p high-speed cloud streams, and download original files directly.
      </p>
    </div>

    <!-- Alert / Trigger reason -->
    <div class="pricing-trigger-reason" id="pricing-trigger-reason" style="display: none;">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#f59e0b" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span id="pricing-reason-text">You have reached the free limit of 5 daily links.</span>
    </div>

    <!-- Pricing Grid -->
    <div class="pricing-grid">
      {plans.map((p) => (
        <div class={`pricing-card ${p.badge ? 'is-featured' : ''}`}>
          {p.badge && <div class="pricing-featured-badge">{p.badge}</div>}
          <div class="card-plan-header">
            <h3 class="plan-name">{p.name}</h3>
            <div class="plan-price-row">
              <span class="currency-symbol">₹</span>
              <span class="price-amount">{p.price}</span>
              <span class="price-period">/ {p.period}</span>
            </div>
            <p class="plan-desc">{p.description}</p>
          </div>

          <div class="plan-features-list">
            {p.features.map((feat) => (
              <div class="plan-feature-item">
                <svg viewBox="0 0 24 24" class="feat-check" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{feat}</span>
              </div>
            ))}
          </div>

          <button 
            type="button" 
            class={`plan-cta-btn ${p.badge ? 'btn-popular' : ''}`}
            data-plan-id={p.id}
            data-plan-price={p.price}
            data-plan-name={p.name}
            data-plan-days={p.days}
            data-plan-period={p.period}
          >
            <span>Activate {p.name}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      ))}
    </div>

    <!-- Trust & Payment Security Footer -->
    <div class="pricing-trust-bar">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Secured by Razorpay (UPI, Cards, NetBanking)</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Instant Automated Activation</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>100% Encrypted & Safe</span>
      </div>
    </div>
  </div>
</div>

<style>
  .pricing-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(3, 5, 5, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    overflow-y: auto;
  }

  .pricing-modal-overlay.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .pricing-modal-card {
    background: linear-gradient(180deg, rgba(13, 20, 22, 0.98) 0%, rgba(7, 10, 11, 0.99) 100%);
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 1140px;
    padding: 38px 28px 30px;
    position: relative;
    box-shadow: 
      0 30px 90px rgba(0, 0, 0, 0.9),
      0 0 60px rgba(16, 185, 129, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transform: scale(0.96);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    margin: auto;
  }

  .pricing-modal-overlay.is-active .pricing-modal-card {
    transform: scale(1);
  }

  .pricing-close-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .pricing-close-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .pricing-modal-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 24px;
  }

  .pricing-glow-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 9999px;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(52, 211, 153, 0.4);
    color: #34d399;
    font-size: var(--text-xs);
    font-weight: 750;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pricing-modal-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 850;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .pricing-modal-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .pricing-trigger-reason {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 600px;
    margin: 0 auto 24px;
    padding: 10px 18px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: var(--radius-md);
    color: #fde68a;
    font-size: var(--text-xs);
    font-weight: 650;
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 26px;
  }

  .pricing-card {
    background: rgba(10, 16, 18, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 25px rgba(16, 185, 129, 0.15);
  }

  .pricing-card.is-featured {
    background: linear-gradient(180deg, rgba(16, 32, 30, 0.95) 0%, rgba(9, 17, 18, 0.98) 100%);
    border: 1.5px solid rgba(16, 185, 129, 0.6);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 30px rgba(16, 185, 129, 0.22);
  }

  .pricing-featured-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    color: #ffffff;
    padding: 3px 12px;
    border-radius: 9999px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 3px 10px rgba(16, 185, 129, 0.5);
  }

  .plan-name {
    font-size: var(--text-lg);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .plan-price-row {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 8px;
  }

  .currency-symbol {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
  }

  .price-amount {
    font-size: 2.2rem;
    font-weight: 850;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .price-period {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .plan-desc {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin-bottom: 18px;
    min-height: 38px;
  }

  .plan-features-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .plan-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-xs);
    color: #e2e8f0;
    line-height: 1.4;
  }

  .feat-check {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .plan-cta-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-md);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 750;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
    font-family: inherit;
  }

  .plan-cta-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .plan-cta-btn.btn-popular {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    border-color: rgba(52, 211, 153, 0.4);
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35);
  }

  .plan-cta-btn.btn-popular:hover {
    background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    box-shadow: 0 6px 22px rgba(16, 185, 129, 0.5);
  }

  .pricing-trust-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .trust-item svg {
    color: var(--color-primary);
  }

  @media (max-width: 1040px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .pricing-modal-card {
      padding: 30px 20px 22px;
    }
  }

  @media (max-width: 600px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .pricing-modal-card {
      padding: 24px 14px 18px;
    }
  }

  @media (max-width: 540px) {
    .pricing-modal-overlay {
      padding: max(12px, env(safe-area-inset-top, 12px)) 10px max(24px, env(safe-area-inset-bottom, 24px));
      align-items: flex-start;
    }

    .pricing-modal-card {
      padding: 24px 14px 18px;
      border-radius: var(--radius-lg);
    }

    .pricing-close-btn {
      top: 12px;
      right: 12px;
      width: 40px;
      height: 40px;
    }

    .pricing-modal-title {
      font-size: 1.45rem;
    }

    .pricing-modal-subtitle {
      font-size: var(--text-xs);
    }

    .btn-select-plan {
      min-height: 48px;
      font-size: 15px;
    }

    .trust-badges-row {
      flex-direction: column;
      gap: 6px;
      align-items: center;
    }
  }

  /* Light Mode Styling for Pricing Modal */
  :root[data-theme="light"] .pricing-modal-card {
    background: #ffffff !important;
    border-color: rgba(15, 23, 42, 0.08) !important;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.15), 0 0 50px rgba(16, 185, 129, 0.1) !important;
  }
  :root[data-theme="light"] .pricing-modal-title {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .pricing-modal-subtitle {
    color: #64748b !important;
  }
  :root[data-theme="light"] .pricing-close-btn {
    background: #f1f5f9 !important;
    border-color: #e2e8f0 !important;
    color: #64748b !important;
  }
  :root[data-theme="light"] .pricing-close-btn:hover {
    color: #0f172a !important;
    background: #e2e8f0 !important;
  }
  :root[data-theme="light"] .pricing-card {
    background: #ffffff !important;
    border-color: #e2e8f0 !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04) !important;
  }
  :root[data-theme="light"] .pricing-card.is-featured {
    background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%) !important;
    border-color: rgba(5, 150, 105, 0.4) !important;
  }
  :root[data-theme="light"] .plan-name,
  :root[data-theme="light"] .price-amount {
    color: #0f172a !important;
  }
  :root[data-theme="light"] .plan-desc {
    color: #64748b !important;
  }
  :root[data-theme="light"] .plan-feature-item span {
    color: #334155 !important;
  }
  :root[data-theme="light"] .plan-cta-btn {
    background: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }
  :root[data-theme="light"] .plan-cta-btn.btn-popular {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%) !important;
    border-color: rgba(52, 211, 153, 0.4) !important;
    color: #ffffff !important;
  }
  :root[data-theme="light"] .pricing-trust-bar {
    border-top-color: #e2e8f0 !important;
    color: #64748b !important;
  }
</style>

<script>
  import { startRazorpayCheckout, type RazorpayPlan } from '../utils/razorpay';
  import { APP_CONFIG } from '../utils/config';

  const modal = document.getElementById('pricing-modal');
  const closeBtn = document.getElementById('pricing-close-btn');
  const reasonBox = document.getElementById('pricing-trigger-reason');
  const reasonText = document.getElementById('pricing-reason-text');

  function openPricingModal(reasonMessage?: string) {
    if (!modal) return;
    if (reasonBox && reasonText) {
      if (reasonMessage) {
        reasonText.textContent = reasonMessage;
        reasonBox.style.display = 'flex';
      } else {
        reasonBox.style.display = 'none';
      }
    }
    modal.style.display = 'flex';
    requestAnimationFrame(() => {
      modal?.classList.add('is-active');
    });
  }

  function closePricingModal() {
    if (!modal) return;
    modal.classList.remove('is-active');
    setTimeout(() => {
      if (modal) modal.style.display = 'none';
    }, 250);
  }

  closeBtn?.addEventListener('click', closePricingModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePricingModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-active')) {
      closePricingModal();
    }
  });

  // Listen for global upgrade trigger
  window.addEventListener('terawala:open-pricing', (e: any) => {
    const reason = e.detail?.reason;
    openPricingModal(reason);
  });

  // Wiring CTA buttons to start Razorpay checkout
  const planButtons = document.querySelectorAll('.plan-cta-btn');
  planButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const planId = btn.getAttribute('data-plan-id');
      const plan = APP_CONFIG.plans.find((p) => p.id === planId);
      if (!plan) return;

      closePricingModal();

      startRazorpayCheckout(plan as RazorpayPlan, {
        onSuccess: (resp) => {
          window.location.href = '/dashboard/?upgraded=true';
        },
        onError: (err) => {
          console.error(err);
        }
      });
    });
  });
</script>
