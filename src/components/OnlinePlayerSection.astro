---
---

<section class="section section-emerald" id="player">
  <div class="container">
    <div class="player-guide-card card-obsidian">
      <div class="eyebrow eyebrow-green">ONLINE PLAYER</div>
      <h2 class="section-title-left">
        Using the <span class="text-gradient-green">Diskwala Online Video Player</span>
      </h2>
      <p class="section-intro-text">
        One of the most convenient features of our platform is the in-browser online video player. If all you need is to watch a video immediately, downloading the entire multi-gigabyte file to your phone or laptop is unnecessary and consumes valuable storage.
      </p>

      <!-- 4 Features 2x2 Grid Matching Reference -->
      <div class="features-2x2-grid">
        <div class="player-feature-item">
          <div class="feature-item-header">
            <span class="feature-bullet-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <h3 class="feature-item-title">No App Install</h3>
          </div>
          <p class="feature-item-desc">
            The checker and demo preview run in modern browsers like Chrome, Safari, Firefox, and Edge. Your file itself is delivered through the Telegram bot.
          </p>
        </div>

        <div class="player-feature-item">
          <div class="feature-item-header">
            <span class="feature-bullet-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <h3 class="feature-item-title">Demo Preview</h3>
          </div>
          <p class="feature-item-desc">
            Try the sample player on this page to see the layout. Use the bot link for your actual video's quality options.
          </p>
        </div>

        <div class="player-feature-item">
          <div class="feature-item-header">
            <span class="feature-bullet-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <h3 class="feature-item-title">Quick Check</h3>
          </div>
          <p class="feature-item-desc">
            Paste a link to confirm it uses a supported host (diskwala.com or flezen.com) before opening the bot.
          </p>
        </div>

        <div class="player-feature-item">
          <div class="feature-item-header">
            <span class="feature-bullet-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <h3 class="feature-item-title">Simple Controls</h3>
          </div>
          <p class="feature-item-desc">
            The demo player uses standard browser controls: play/pause, seek, volume, and fullscreen.
          </p>
        </div>
      </div>

      <!-- Emerald Highlight Box -->
      <div class="callout-box-emerald">
        <h4 class="callout-title">
          <span class="callout-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </span>
          <span>Preview Without Downloading</span>
        </h4>
        <p class="callout-text">
          This page includes a <strong class="callout-strong">demo player</strong> with a sample video so you can try the controls. To watch or save your own link, paste it above and open the Telegram bot result.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .player-guide-card {
    background: linear-gradient(180deg, rgba(16, 22, 24, 0.9) 0%, rgba(9, 12, 14, 0.96) 100%);
    border: 1px solid rgba(16, 185, 129, 0.22);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 45px rgba(16, 185, 129, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.09);
    padding: 44px 48px;
    border-radius: var(--radius-xl);
  }

  .section-title-left {
    font-size: var(--text-3xl);
    font-weight: 850;
    margin-bottom: 18px;
    letter-spacing: -0.025em;
  }

  .section-intro-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.72;
    margin-bottom: 34px;
    max-width: 860px;
  }

  .features-2x2-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 32px;
  }

  .player-feature-item {
    background: rgba(14, 19, 21, 0.8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 26px 28px;
    transition: border-color 0.25s, transform 0.25s;
  }

  .player-feature-item:hover {
    border-color: var(--color-amber-border);
    transform: translateY(-2px);
  }

  .feature-item-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .feature-bullet-icon {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: var(--color-amber-soft);
    border: 1px solid var(--color-amber-border);
    color: var(--color-amber);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-item-title {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-text);
  }

  .feature-item-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .callout-box-emerald {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(16, 185, 129, 0.02) 100%);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    box-shadow: 0 0 30px rgba(16, 185, 129, 0.08);
  }

  .callout-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-base);
    font-weight: 750;
    color: var(--color-primary);
    margin-bottom: 10px;
  }

  .callout-icon {
    display: inline-flex;
    align-items: center;
  }

  .callout-text {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .callout-strong {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .player-guide-card {
      padding: 22px 14px;
      border-radius: var(--radius-xl);
    }

    .section-title-left {
      font-size: var(--text-2xl);
      margin-bottom: 12px;
    }

    .section-intro-text {
      font-size: var(--text-sm);
      line-height: 1.6;
      margin-bottom: 22px;
    }

    .features-2x2-grid {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 22px;
    }

    .player-feature-item {
      padding: 20px 16px;
      border-radius: var(--radius-lg);
    }

    .feature-item-title {
      font-size: var(--text-base);
    }

    .feature-item-desc {
      font-size: var(--text-sm);
    }

    .callout-box-emerald {
      padding: 18px 16px;
      border-radius: var(--radius-lg);
    }

    .callout-title {
      font-size: var(--text-sm);
    }

    .callout-text {
      font-size: var(--text-xs);
      line-height: 1.55;
    }
  }

  @media (max-width: 380px) {
    .player-guide-card {
      padding: 16px 12px;
    }

    .player-feature-item {
      padding: 16px 12px;
    }
  }
</style>
