---
interface FaqItem {
  num: string;
  question: string;
  paragraphs: string[];
}

const faqs: FaqItem[] = [
  {
    num: '01',
    question: 'What is TeraWala and how does it work?',
    paragraphs: [
      'TeraWala (terawala.com) is a free, high-speed online video player and link downloader designed for Terabox and Diskwala / Flezen cloud links.',
      'Paste your video link into the search bar, click "Play & Download", and TeraWala sanitizes tracking parameters to provide an instant in-browser video player stream or direct handoff to our official Telegram bot for high-speed MP4 downloads.'
    ]
  },
  {
    num: '02',
    question: 'How to convert Diskwala link to Terabox link online?',
    paragraphs: [
      'Direct URL conversion between Diskwala and TeraBox is not technically possible because they are separate hosting platforms with independent file servers and tokens.',
      'However, you do not need to convert links to access your content. TeraWala provides unified playback and downloading for both Diskwala and TeraBox links on a single platform. Simply paste either link into the box above to stream or download directly.'
    ]
  },
  {
    num: '03',
    question: 'How to download Terabox videos without app?',
    paragraphs: [
      'You can download Terabox videos without installing the TeraBox app or APK directly through terawala.com on Chrome, Safari, Edge, or Firefox from any Android, iPhone, Windows, or Mac device.',
      'Paste the Terabox link into the search box and click "Play & Download". You can preview the video directly in your browser or open the official Telegram bot to download the original full HD video with uncapped speeds.'
    ]
  },
  {
    num: '04',
    question: 'How to download Diskwala videos without app?',
    paragraphs: [
      'You can download Diskwala videos without installing any APK or mobile application directly through your web browser. Open terawala.com on Chrome, Safari, Edge, or Firefox from any Android, iPhone, Windows, or Mac device.',
      'Paste the Diskwala link into the search box and click "Play & Download". Our system extracts the raw MP4 video stream so you can save the file straight to your local device storage completely ad-free and without bloatware.'
    ]
  },
  {
    num: '05',
    question: 'How to watch Terabox & Diskwala videos online without app?',
    paragraphs: [
      'To watch Terabox or Diskwala videos without installing an app, use the built-in TeraWala online video player. Paste your video URL into the input field on terawala.com and tap "Play & Download".',
      'Our responsive HTML5 web player launches immediately with fullscreen support, playback speed controls, and picture-in-picture streaming right in your browser, eliminating the need for MX Player or mobile APKs.'
    ]
  },
  {
    num: '06',
    question: 'How to open Diskwala link without app?',
    paragraphs: [
      'Standard Diskwala links typically force users through deceptive redirect loops and aggressive app install prompts. To open a Diskwala link without the app, bypass those barriers by pasting the URL into terawala.com.',
      'Our cloud resolver opens the link in an isolated environment, extracts the media parameters, and gives you clean, immediate access to stream or download the file directly in your browser.'
    ]
  },
  {
    num: '07',
    question: 'Is TeraWala safe to use?',
    paragraphs: [
      'Using TeraWala is completely safe: we strip dangerous redirects and popup ads, never ask you to install suspicious apps or APKs, enforce a strict zero-log privacy policy, and route all traffic through encrypted HTTPS and verified Telegram bot connections.'
    ]
  },
  {
    num: '08',
    question: 'How to play Diskwala video online without app?',
    paragraphs: [
      'Playing a Diskwala video online without an app is fast and simple: copy your Diskwala video URL, paste it into the search box on terawala.com, and click "Play & Download".',
      'The video starts streaming instantly in your browser with zero buffer delay, no mandatory signups, and full compatibility across iOS, Android, macOS, and Windows.'
    ]
  },
  {
    num: '09',
    question: 'Why is my Terabox or Diskwala link not working?',
    paragraphs: [
      'If your link is not working, the most common causes include: (1) ISP DNS blocking of cloud hosting domains, (2) the original uploader removed the video, or (3) expired media tokens.',
      'You can solve this by pasting your link into terawala.com or utilizing our official Telegram Bot handoff, which bypasses local ISP bans and retrieves the file from active cloud mirrors.'
    ]
