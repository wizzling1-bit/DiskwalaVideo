<section class="section section-amber" id="how-to-download">
  <div class="container">
    <div class="steps-guide-card card-obsidian">
      <div class="eyebrow eyebrow-amber">STEP BY STEP</div>
      <h2 class="section-title-left">
        How to Process a <span class="text-gradient-amber">Diskwala Video Download</span>
      </h2>
      <p class="section-intro-text">
        If you plan to travel, work offline, or keep long-term media archives, having a local copy of your video files is essential. Our <strong class="highlight-text">diskwala video downloader</strong> turns what was once an ad-heavy, confusing process into three easy steps:
      </p>

      <!-- 3 Steps Stack with Amber Badges Matching Reference -->
      <div class="steps-stack">
        <!-- Step 1 -->
        <div class="step-card">
          <div class="step-badge-amber">1</div>
          <div class="step-content">
            <h3 class="step-title">Copy the Diskwala Link</h3>
            <p class="step-desc">
              Locate the Diskwala or Flezen share link in your browser address bar, community forum, messaging thread, or Telegram channel. Copy the entire URL to your clipboard.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="step-card">
          <div class="step-badge-amber">2</div>
          <div class="step-content">
            <h3 class="step-title">Paste & Click Unlock Video</h3>
            <p class="step-desc">
              Paste the URL into our tool's input box at the top of this page and tap <strong class="highlight-text">Unlock Video</strong>. We check the link format and show your next options.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="step-card">
          <div class="step-badge-amber">3</div>
          <div class="step-content">
            <h3 class="step-title">Open Bot and Enjoy</h3>
            <p class="step-desc">
              Open the Telegram bot link we show you, send your link there if asked, then use the playback or <strong class="highlight-text">Download File</strong> option the bot provides.
            </p>
          </div>
        </div>
      </div>

      <div class="steps-footer-tip">
        <p>
          <strong class="highlight-text">Tip:</strong> Keep the original share link handy — if a download pauses, restart it from your browser's download list.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .steps-guide-card {
    background: linear-gradient(180deg, rgba(16, 20, 24, 0.9) 0%, rgba(9, 11, 14, 0.96) 100%);
    border: 1px solid var(--color-amber-border);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 45px rgba(245, 158, 11, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.09);
    padding: 44px 48px;
    border-radius: var(--radius-xl);
  }

  .section-title-left {
    font-size: var(--text-3xl);
    font-weight: 850;
    margin-bottom: 18px;
    letter-spacing: -0.025em;
  }

  .section-intro-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.72;
    margin-bottom: 34px;
    max-width: 860px;
  }

  .highlight-text {
    color: var(--color-text);
    font-weight: 700;
  }

  .steps-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 26px;
  }

  .step-card {
    display: flex;
    align-items: flex-start;
    gap: 22px;
    background: rgba(14, 19, 21, 0.8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 26px 30px;
    transition: border-color 0.25s, transform 0.25s;
  }

  .step-card:hover {
    border-color: var(--color-amber-border);
    transform: translateX(4px);
  }

  .step-badge-amber {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, var(--color-amber), #d97706);
    color: #050606;
    font-weight: 850;
    font-size: var(--text-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 18px rgba(245, 158, 11, 0.45);
  }

  .step-content {
    flex: 1;
  }

  .step-title {
    font-size: var(--text-xl);
    font-weight: 800;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .step-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .steps-footer-tip {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .steps-guide-card {
      padding: 22px 14px;
      border-radius: var(--radius-xl);
    }

    .section-title-left {
      font-size: var(--text-2xl);
      margin-bottom: 12px;
    }

    .section-intro-text {
      font-size: var(--text-sm);
      line-height: 1.6;
      margin-bottom: 22px;
    }

    .step-card {
      gap: 12px;
      padding: 16px 14px;
      border-radius: var(--radius-lg);
    }

    .step-badge-amber {
      width: 30px;
      height: 30px;
      font-size: var(--text-sm);
    }

    .step-title {
      font-size: var(--text-base);
    }

    .step-desc {
      font-size: var(--text-xs);
      line-height: 1.55;
    }

    .steps-footer-tip {
      padding: 14px 16px;
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 380px) {
    .steps-guide-card {
      padding: 16px 12px;
    }

    .step-card {
      padding: 14px 12px;
    }
  }
</style>
