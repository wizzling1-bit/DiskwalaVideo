  }

  :root[data-theme="light"] .title-red {
    color: #dc2626 !important;
  }

  :root[data-theme="light"] .sub-red {
    color: #ef4444 !important;
  }

  :root[data-theme="light"] .menu-divider {
    background: #e2e8f0 !important;
  }

  :root[data-theme="light"] .floating-nav-island {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(15, 23, 42, 0.1);
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  :root[data-theme="light"] .floating-nav-island.is-scrolled {
    background: rgba(255, 255, 255, 0.97);
    border-color: rgba(5, 150, 105, 0.35);
    box-shadow: 0 16px 45px rgba(15, 23, 42, 0.1), 0 2px 6px rgba(15, 23, 42, 0.05);
  }

  :root[data-theme="light"] .vip-nav-pill {
    background: rgba(5, 150, 105, 0.08) !important;
    border-color: rgba(5, 150, 105, 0.3) !important;
    color: #059669 !important;
  }

  :root[data-theme="light"] .mobile-drawer-backdrop {
    background: rgba(15, 23, 42, 0.45);
  }

  :root[data-theme="light"] .mobile-nav-drawer {
    background: rgba(255, 255, 255, 0.96) !important;
    border-left: 1px solid rgba(15, 23, 42, 0.08) !important;
    box-shadow: -20px 0 60px rgba(15, 23, 42, 0.14) !important;
  }

  :root[data-theme="light"] .drawer-header {
    border-bottom-color: rgba(15, 23, 42, 0.08) !important;
  }

  :root[data-theme="light"] .drawer-close-btn {
    background: #f1f5f9 !important;
    border-color: #e2e8f0 !important;
    color: #0f172a !important;
  }

  :root[data-theme="light"] .drawer-vip-card {
    background: #fffbeb !important;
    border-color: rgba(217, 119, 6, 0.3) !important;
  }

  :root[data-theme="light"] .drawer-nav-link {
    color: #334155 !important;
  }

  :root[data-theme="light"] .drawer-nav-link:hover,
  :root[data-theme="light"] .drawer-nav-link:active {
    color: #0f172a !important;
    background: #f1f5f9 !important;
  }

  :root[data-theme="light"] .drawer-lang-section,
  :root[data-theme="light"] .drawer-actions {
    border-top-color: rgba(15, 23, 42, 0.08) !important;
  }

  :root[data-theme="light"] .mobile-lang-chip {
    background: #f8fafc !important;
    border-color: #e2e8f0 !important;
    color: #475569 !important;
  }

  :root[data-theme="light"] .mobile-lang-chip.is-active {
    background: rgba(5, 150, 105, 0.12) !important;
    border-color: rgba(5, 150, 105, 0.3) !important;
    color: #059669 !important;
  }
</style>

<script>
  import { getCurrentUser, getUserProfile, signOutUser } from '../utils/supabase';

  // Theme Switcher Toggle Logic
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  if (themeToggleBtn) {
    themeToggleBtn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('terawala_theme', next);
      } catch (e) {}
      window.dispatchEvent(new CustomEvent('terawala:theme-changed', { detail: { theme: next } }));
    });
  }

  // Scroll Animations for Fixed Navbar
  const headerWrapper = document.querySelector('.header-wrapper');
  const navIsland = document.getElementById('nav-island');
  function handleNavScroll() {
    const isScrolled = window.scrollY > 20;
    headerWrapper?.classList.toggle('is-scrolled', isScrolled);
    navIsland?.classList.toggle('is-scrolled', isScrolled);
  }
  window.addEventListener('scroll', handleNavScroll, { passive: true });
  handleNavScroll();

  // Mobile Glass Drawer Open / Close Logic
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const backdrop = document.getElementById('mobile-drawer-backdrop');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');

  function openDrawer() {
    toggleBtn?.setAttribute('aria-expanded', 'true');
    toggleBtn?.classList.add('is-active');
    drawer?.classList.add('is-open');
    drawer?.setAttribute('aria-hidden', 'false');
    backdrop?.classList.add('is-open');
    backdrop?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    toggleBtn?.setAttribute('aria-expanded', 'false');
    toggleBtn?.classList.remove('is-active');
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    backdrop?.classList.remove('is-open');
    backdrop?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  toggleBtn?.addEventListener('click', () => {
    const isOpen = drawer?.classList.contains('is-open');
    if (isOpen) closeDrawer(); else openDrawer();
  });

  drawerCloseBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);

  drawer?.querySelectorAll('a, button:not(#drawer-close-btn)').forEach(el => {
    el.addEventListener('click', () => {
      closeDrawer();
    });
  });

  // Mobile Language Picker Switcher inside Drawer
  document.querySelectorAll('.drawer-lang-grid [data-lang-switch]').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang-switch');
      if (lang) {
        window.dispatchEvent(new CustomEvent('terawala:locale-changed', { detail: { locale: lang } }));
      }
    });
  });

  // Header Auth State & VIP Badge Display
  const authWrapper = document.getElementById('user-auth-wrapper');
  const authBtn = document.getElementById('header-auth-btn');
  const authText = document.getElementById('header-auth-text');
  const avatarCircle = document.getElementById('header-avatar-circle');
  const profileMenu = document.getElementById('user-profile-menu');
  const menuUserName = document.getElementById('menu-user-name');
  const menuUserBadge = document.getElementById('menu-user-badge');
  const headerAdminLink = document.getElementById('header-admin-link');
  const headerSignoutBtn = document.getElementById('header-signout-btn');
  const mobileAuthBtn = document.getElementById('mobile-auth-action-btn');
  const mobileSheetDashLink = document.getElementById('mobile-sheet-dash-link');
  const headerVipPill = document.getElementById('header-buy-vip-pill');
  const upgradeItem = document.getElementById('header-upgrade-item');
  const drawerVipStatus = document.getElementById('drawer-vip-status');
  const drawerVipSub = document.getElementById('drawer-vip-sub');
  const mobileVipLink = document.getElementById('mobile-vip-link');
  const mobileVipText = document.getElementById('mobile-vip-text');

  let currentUser: any = null;

  async function checkUserHeader() {
    try {
      currentUser = await getCurrentUser();
      if (currentUser) {
        if (authWrapper) authWrapper.classList.add('is-logged-in');
        if (mobileSheetDashLink) mobileSheetDashLink.style.display = 'flex';

        const profile = await getUserProfile(currentUser.id);
        const name = profile?.full_name || currentUser.user_metadata?.full_name || currentUser.email?.split('@')[0] || 'User';
        const isAdmin = profile?.role === 'admin' || 
                        currentUser.user_metadata?.role === 'admin' || 
                        currentUser.app_metadata?.role === 'admin' ||
                        currentUser.email === 'sohanmandal2005@gmail.com' ||
                        currentUser.email?.startsWith('admin@');
        const isVip = profile?.subscription_tier === 'premium' || 
                      profile?.subscription_tier === 'vip' || 
                      currentUser.user_metadata?.subscription_tier === 'premium' ||
                      isAdmin;
        const initial = name.charAt(0).toUpperCase();

        if (authText) authText.textContent = name;
        if (avatarCircle) avatarCircle.textContent = initial;

        const menuAvatarLetter = document.getElementById('menu-avatar-letter');
        if (menuAvatarLetter) menuAvatarLetter.textContent = initial;

        const tierTag = document.getElementById('header-auth-tier-tag');
        const planName = profile?.subscription_plan_name || 
          (profile?.subscription_tier === 'vip_turbo' ? 'Turbo 24h VIP' :
           profile?.subscription_tier === 'vip_pro' ? 'Pro Monthly VIP' :
           profile?.subscription_tier === 'vip_ultra' ? 'Ultra Quarterly VIP' :
           profile?.subscription_tier === 'vip_elite' ? 'Elite Annual VIP' :
           isVip ? 'VIP Member' : 'Free Member');

        if (tierTag) {
          if (isAdmin) {
            tierTag.textContent = 'ADMIN';
            tierTag.className = 'auth-btn-tier-tag is-admin';
            tierTag.style.display = 'inline-flex';
          } else if (isVip) {
            tierTag.textContent = planName.replace(' VIP', '').trim() || 'VIP';
            tierTag.className = 'auth-btn-tier-tag';
            tierTag.style.display = 'inline-flex';
          } else {
            tierTag.style.display = 'none';
          }
        }

        if (menuUserBadge) {
          if (isAdmin) {
            menuUserBadge.innerHTML = `<svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" style="margin-right:4px"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>SUPER ADMIN`;
            menuUserBadge.className = 'menu-user-badge is-admin is-premium';
          } else if (isVip) {
            menuUserBadge.innerHTML = `<svg viewBox="0 0 24 24" width="11" height="11" fill="#fbbf24" style="margin-right:4px"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>${planName.toUpperCase()}`;
            menuUserBadge.className = 'menu-user-badge is-premium';
          } else {
            menuUserBadge.textContent = 'FREE MEMBER';
            menuUserBadge.className = 'menu-user-badge';
          }
        }

        if (headerAdminLink && isAdmin) {
          headerAdminLink.style.display = 'flex';
        }

        if (mobileAuthBtn) {
          mobileAuthBtn.textContent = `My Account (${name})`;
        }

        // Handle VIP Active Mode: No need to show Buy Premium buttons to VIP users!
        if (isVip) {
          if (headerVipPill) {
            headerVipPill.setAttribute('href', '/dashboard/');
            headerVipPill.innerHTML = `
              <svg viewBox="0 0 24 24" width="14" height="14" fill="#fbbf24" class="nav-crown-icon" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
              <span>VIP Active</span>
            `;
            headerVipPill.classList.add('is-vip-active');
          }

          if (upgradeItem) {
            upgradeItem.setAttribute('href', '/dashboard/');
            upgradeItem.innerHTML = `
              <div class="menu-item-icon icon-gold">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="#fbbf24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                </svg>
              </div>
              <div class="menu-item-texts">
                <span class="menu-item-title title-gold">${isAdmin ? 'Super Admin Active' : `${planName} Active`}</span>
                <span class="menu-item-sub sub-gold">Unlimited downloads unlocked</span>
              </div>
            `;
          }

          if (drawerVipStatus) drawerVipStatus.textContent = isAdmin ? 'Super Admin Active' : `${planName} Active`;
          if (drawerVipSub) drawerVipSub.textContent = 'Unlimited Downloads Unlocked';
          if (mobileVipLink) {
            mobileVipLink.setAttribute('href', '/dashboard/');
            mobileVipLink.classList.add('is-vip-active');
            if (mobileVipText) mobileVipText.textContent = `${planName} (Dashboard)`;
          }
        } else {
          // Free user
          if (headerVipPill) {
            headerVipPill.setAttribute('href', '/pricing/');
            headerVipPill.innerHTML = `
              <svg viewBox="0 0 24 24" width="14" height="14" fill="#fbbf24" class="nav-crown-icon" aria-hidden="true">
                <path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path>
              </svg>
              <span>Buy Premium</span>
            `;
            headerVipPill.classList.remove('is-vip-active');
          }

          if (drawerVipStatus) drawerVipStatus.textContent = 'Free Member (5/day)';
          if (drawerVipSub) drawerVipSub.textContent = 'Upgrade for Unlimited Downloads';
          if (mobileVipLink) {
            mobileVipLink.setAttribute('href', '/pricing/');
            mobileVipLink.classList.remove('is-vip-active');
            if (mobileVipText) mobileVipText.textContent = 'Buy Premium';
          }
        }
      } else {
        if (authWrapper) authWrapper.classList.remove('is-logged-in');
        if (mobileSheetDashLink) mobileSheetDashLink.style.display = 'none';

        if (authText) authText.textContent = 'Sign In';
        if (avatarCircle) {
          avatarCircle.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>';
        }
        if (mobileAuthBtn) {
          mobileAuthBtn.textContent = 'Sign In / Register';
        }
        if (drawerVipStatus) drawerVipStatus.textContent = 'Free Member (5/day)';
        if (drawerVipSub) drawerVipSub.textContent = 'Upgrade for Unlimited Downloads';
      }
    } catch (err) {
      console.warn('Header user check error:', err);
    }
  }

  let menuHoverTimer: any = null;

  function openProfileMenu() {
    if (menuHoverTimer) clearTimeout(menuHoverTimer);
    if (profileMenu) {
      profileMenu.classList.add('is-open');
      authBtn?.setAttribute('aria-expanded', 'true');
    }
  }

  function closeProfileMenu() {
    if (menuHoverTimer) clearTimeout(menuHoverTimer);
    if (profileMenu) {
      profileMenu.classList.remove('is-open');
      authBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  // Smooth hover with debounce on desktop (prevents accidental overlay popups)
  authWrapper?.addEventListener('mouseenter', () => {
    if (window.innerWidth >= 769 && currentUser) {
      if (menuHoverTimer) clearTimeout(menuHoverTimer);
      menuHoverTimer = setTimeout(openProfileMenu, 120);
    }
  });

  authWrapper?.addEventListener('mouseleave', () => {
    if (window.innerWidth >= 769 && currentUser) {
      if (menuHoverTimer) clearTimeout(menuHoverTimer);
      menuHoverTimer = setTimeout(closeProfileMenu, 220);
    }
  });

  authBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!currentUser) {
      window.location.href = '/login/';
    } else {
      if (window.innerWidth < 769) {
        window.location.href = '/dashboard/';
        return;
      }
      if (profileMenu?.classList.contains('is-open')) {
        closeProfileMenu();
      } else {
        openProfileMenu();
      }
    }
  });

  // Upgrade to Premium item trigger — navigate cleanly to /pricing/
  upgradeItem?.addEventListener('click', () => {
    closeProfileMenu();
  });

  mobileAuthBtn?.addEventListener('click', () => {
    if (!currentUser) {
      window.location.href = '/login/';
    } else {
      window.location.href = '/dashboard/';
    }
  });

  document.addEventListener('click', (e) => {
    if (profileMenu && !profileMenu.contains(e.target as Node) && !authWrapper?.contains(e.target as Node)) {
      closeProfileMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeProfileMenu();
    }
  });

  headerSignoutBtn?.addEventListener('click', async () => {
    await signOutUser();
    window.location.reload();
  });

  checkUserHeader();
  window.addEventListener('terawala:auth-changed', checkUserHeader);
</script>
