  }

  :root[data-theme="light"] .menu-item-icon.icon-shield,
  :root[data-theme="light"] .menu-item-icon.icon-red {
    background: #fee2e2 !important;
    color: #dc2626 !important;
  }

  :root[data-theme="light"] .menu-item-title {
