<style>
  .seo-guide-card {
    background: linear-gradient(180deg, rgba(14, 20, 22, 0.94) 0%, rgba(8, 11, 13, 0.98) 100%);
    border: 1px solid rgba(16, 185, 129, 0.22);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.8), 0 0 45px rgba(16, 185, 129, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    padding: 56px 52px;
    border-radius: var(--radius-xl);
    text-align: left;
  }

  .seo-header {
    margin-bottom: 44px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 32px;
  }

  .seo-main-title {
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    font-weight: 850;
    line-height: 1.22;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
    color: var(--color-text);
  }

  .seo-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.8;
    max-width: 900px;
  }

  .seo-lead strong {
    color: var(--color-text);
  }

  .seo-body-content {
    display: flex;
    flex-direction: column;
    gap: 38px;
  }

  .seo-block {
    border-left: 2px solid rgba(16, 185, 129, 0.35);
    padding-left: 24px;
    margin-left: 4px;
  }

  .seo-block-title {
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 14px;
    letter-spacing: -0.015em;
    display: flex;
    align-items: baseline;
    gap: 12px;
    line-height: 1.35;
  }

  .block-num {
    font-size: 0.85rem;
    font-weight: 850;
    color: var(--color-primary);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .seo-block p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.78;
    margin-bottom: 14px;
  }

  .seo-block p:last-child {
    margin-bottom: 0;
  }

  .seo-block strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .seo-block code {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 2px 7px;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.9em;
    color: #34d399;
  }

  /* Feature Lists */
  .seo-feature-list {
    list-style: none;
    padding: 0;
    margin: 16px 0 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .seo-feature-list li {
    position: relative;
    padding-left: 24px;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .seo-feature-list li::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-primary);
    font-size: 0.9rem;
  }

  .seo-feature-list li strong {
    color: var(--color-text);
  }

  /* Comparison Grid */
  .seo-comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: 20px 0;
  }

  .comparison-card {
    border-radius: var(--radius-lg);
    padding: 24px 22px;
  }

  .comp-danger {
    background: rgba(244, 63, 94, 0.06);
    border: 1px solid rgba(244, 63, 94, 0.25);
  }

  .comp-danger .comp-title {
    color: #fda4af;
    font-size: var(--text-base);
    font-weight: 800;
    margin-bottom: 12px;
  }

  .comp-danger ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .comp-danger li {
    font-size: var(--text-sm);
    color: #fecdd3;
    line-height: 1.55;
    position: relative;
    padding-left: 20px;
  }

  .comp-danger li::before {
    content: "✕";
    position: absolute;
    left: 0;
    color: #f43f5e;
    font-weight: 800;
  }

  .comp-success {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .comp-success .comp-title {
    color: #34d399;
    font-size: var(--text-base);
    font-weight: 800;
    margin-bottom: 12px;
  }

  .comp-success ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .comp-success li {
    font-size: var(--text-sm);
    color: #d1fae5;
    line-height: 1.55;
    position: relative;
    padding-left: 20px;
  }

  .comp-success li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #10b981;
    font-weight: 800;
  }

  /* Steps Ordered List */
  .seo-steps-ordered {
    list-style: none;
    counter-reset: step-counter;
    padding: 0;
    margin: 18px 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .seo-steps-ordered li {
    counter-increment: step-counter;
    position: relative;
    padding-left: 38px;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .seo-steps-ordered li::before {
    content: counter(step-counter);
    position: absolute;
    left: 0;
    top: 2px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
    font-size: 0.8rem;
    font-weight: 850;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .seo-steps-ordered li strong {
    color: var(--color-text);
  }

  /* Footer CTA */
  .seo-article-footer {
    margin-top: 48px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 32px;
  }

  .footer-callout-inner {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 26px 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .callout-h4 {
    font-size: var(--text-lg);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .callout-sub {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .seo-cta-btn {
    flex-shrink: 0;
    white-space: nowrap;
    text-decoration: none;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .seo-guide-card {
      padding: 32px 20px;
      border-radius: var(--radius-lg);
    }

    .seo-comparison-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .seo-block {
      padding-left: 16px;
    }

    .footer-callout-inner {
      flex-direction: column;
      text-align: center;
      padding: 22px 18px;
    }

    .seo-cta-btn {
      width: 100%;
    }
  }
</style>
