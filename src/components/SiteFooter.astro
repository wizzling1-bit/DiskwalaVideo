---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Brand Mark Centered -->
    <a href="/" class="footer-brand" aria-label="TeraWala Home">
      <div class="footer-double-bezel">
        <div class="footer-brand-icon">
          <svg viewBox="0 0 24 24" fill="none" class="play-svg" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 6H20M12 6V20M12 11L18 15L12 19" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <span class="footer-brand-text">Tera<span class="brand-accent">Wala</span></span>
    </a>

    <!-- Non-Affiliation Disclaimer -->
    <p class="footer-disclaimer" data-i18n="footer.disclaimer">
      We are not affiliated with TeraBox, Diskwala, or Flezen. All trademarks, registered logos, and brand names belong exclusively to their respective owners. TeraWala is an independent online utility designed for authorized personal media streaming and backup verification.
    </p>

    <!-- Footer Provider Links Row -->
    <div class="footer-tools-row">
      <span class="footer-group-label">Tools:</span>
      <a href="/terabox-downloader/" class="footer-link-btn">TeraBox Downloader</a>
      <span class="footer-sep">•</span>
      <a href="/diskwala-video-downloader/" class="footer-link-btn">Diskwala Downloader</a>
      <span class="footer-sep">•</span>
      <a href="/flezen-video-downloader/" class="footer-link-btn">Flezen Downloader</a>
    </div>

    <!-- Footer Policy Links -->
    <div class="footer-links-row">
      <a href="/about-us/" class="footer-link-btn">About Us</a>
      <span class="footer-sep">•</span>
      <a href="/contact-us/" class="footer-link-btn">Contact</a>
      <span class="footer-sep">•</span>
      <a href="/privacy-policy/" class="footer-link-btn">Privacy Policy</a>
      <span class="footer-sep">•</span>
      <a href="/terms-and-conditions/" class="footer-link-btn">Terms of Service</a>
      <span class="footer-sep">•</span>
      <a href="/disclaimer/" class="footer-link-btn">Disclaimer</a>
      <span class="footer-sep">•</span>
      <a href="/dmca/" class="footer-link-btn">DMCA</a>
      <span class="footer-sep">•</span>
      <a href="/sitemap.xml" class="footer-link-btn">Sitemap</a>
    </div>

    <!-- Language Selector Support -->
    <div class="footer-lang-row">
      <span class="footer-lang-label">Language:</span>
      <button type="button" class="footer-lang-btn is-active" data-lang-switch="en">English (US)</button>
      <span class="footer-sep">•</span>
      <button type="button" class="footer-lang-btn" data-lang-switch="hi">हिंदी</button>
      <span class="footer-sep">•</span>
      <button type="button" class="footer-lang-btn" data-lang-switch="bn">বাংলা</button>
      <span class="footer-sep">•</span>
      <button type="button" class="footer-lang-btn" data-lang-switch="id">Indonesia</button>
      <span class="footer-sep">•</span>
      <button type="button" class="footer-lang-btn" data-lang-switch="es">Español</button>
      <span class="footer-sep">•</span>
      <button type="button" class="footer-lang-btn" data-lang-switch="ru">Русский</button>
    </div>

    <!-- Copyright -->
    <div class="footer-copyright">
      <p>© 2026 TeraWala (terawala.com). <span data-i18n="footer.rights">All rights reserved.</span></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #030505;
    border-top: 1px solid var(--color-border-subtle);
    padding: 60px 0 40px;
    margin-top: 50px;
    text-align: center;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--text-xl);
    font-weight: 850;
    color: var(--color-text);
    margin-bottom: 20px;
    text-decoration: none;
  }

  .footer-double-bezel {
    padding: 2px;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-md);
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.25);
  }

  .footer-brand-icon {
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-svg {
    width: 16px;
    height: 16px;
  }

  .brand-accent {
    color: var(--color-primary);
  }

  .footer-disclaimer {
    max-width: 680px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 26px;
  }

  .footer-tools-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .footer-group-label,
  .footer-lang-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .footer-lang-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
    font-size: var(--text-xs);
  }

  .footer-lang-btn {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 3px 6px;
    border-radius: var(--radius-sm);
    font-family: inherit;
  }

  .footer-lang-btn:hover {
    color: var(--color-primary-hover);
    background: rgba(255, 255, 255, 0.05);
  }

  .footer-lang-btn.is-active {
    color: var(--color-primary);
    font-weight: 700;
    background: rgba(16, 185, 129, 0.12);
  }

  .footer-link-btn {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s;
    padding: 4px 6px;
    text-decoration: none;
  }

  .footer-link-btn:hover {
    color: var(--color-primary-hover);
  }

  .footer-sep {
    color: var(--color-border-strong);
    font-size: var(--text-xs);
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 24px;
    width: 100%;
    max-width: 680px;
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 36px 0 28px;
      margin-top: 36px;
    }

    .footer-brand {
      font-size: var(--text-lg);
      margin-bottom: 14px;
    }

    .footer-disclaimer {
      font-size: var(--text-xs);
      line-height: 1.55;
      margin-bottom: 20px;
    }

    .footer-links-row {
      gap: 8px 14px;
      margin-bottom: 20px;
    }

    .footer-sep {
      display: none;
    }

    .footer-link-btn {
      font-size: var(--text-xs);
      padding: 4px 8px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: var(--radius-sm);
    }

    .footer-copyright {
      padding-top: 18px;
      font-size: var(--text-xs);
    }
  }
</style>
