    padding: 44px 48px;
    border-radius: var(--radius-xl);
  }

  .guide-main-heading {
    font-size: var(--text-3xl);
    font-weight: 850;
    margin-bottom: 20px;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

