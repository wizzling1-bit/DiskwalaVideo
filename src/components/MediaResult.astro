---
import { APP_CONFIG } from '../utils/config';
---

<div class="result-container" id="media-result-panel" style="display: none;" aria-live="polite">
  <div class="container container-hero">
    <div class="result-card" id="media-result-card">
      <!-- Result Card Header -->
      <div class="result-card-top">
        <div class="result-status-badge">
          <span class="status-dot"></span>
          <span id="result-status-text">Video Stream & Direct Download Ready</span>
        </div>
        <span class="provider-tag" id="result-provider-tag">TeraBox Cloud</span>
      </div>

      <!-- File Details -->
      <div class="result-meta-info">
        <h2 class="result-video-title" id="result-video-title">
          Loading video...
        </h2>

        <div class="meta-badges-row">
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
            <span id="meta-format">MP4 Video</span>
          </span>

          <span class="meta-pill meta-pill-green">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
              <line x1="7" y1="2" x2="7" y2="22"></line>
              <line x1="17" y1="2" x2="17" y2="22"></line>
            </svg>
            <span id="meta-resolution">HD Quality</span>
          </span>

          <span class="meta-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
            <span id="meta-size">Calculating size...</span>
          </span>

          <span class="meta-pill" id="meta-duration-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span id="meta-speed">Instant Stream</span>
          </span>
        </div>
      </div>

      <!-- Quality Stream Switcher Bar (Appears when qualities or fast streams exist) -->
      <div class="quality-switcher-wrap" id="quality-switcher-wrap" style="display: none;">
        <span class="quality-label">Stream Mode:</span>
        <div class="quality-pills-row" id="quality-pills-row">
          <!-- Dynamically populated buttons -->
        </div>
      </div>

      <!-- Premium Player Cinema Controls Bar -->
      <div class="player-cinema-bar" id="player-cinema-bar">
        <div class="cinema-stream-info">
          <span class="live-stream-dot"></span>
          <span class="cinema-stream-label">High-Speed Cloud Stream</span>
          <span class="stream-hd-chip">1080p HD</span>
        </div>

        <div class="cinema-controls-cluster">
          <!-- -10s Seek -->
          <button type="button" class="cinema-tool-btn" id="player-seek-back-btn" title="Rewind 10 Seconds (Left Arrow)" aria-label="Rewind 10 seconds">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M11 17l-5-5 5-5M18 17l-5-5 5-5"/>
            </svg>
            <span>-10s</span>
          </button>

          <!-- +10s Seek -->
          <button type="button" class="cinema-tool-btn" id="player-seek-fwd-btn" title="Forward 10 Seconds (Right Arrow)" aria-label="Forward 10 seconds">
            <span>+10s</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M13 17l5-5-5-5M6 17l5-5-5-5"/>
            </svg>
          </button>

          <!-- Speed Switcher Dropdown/Cycle -->
          <div class="player-speed-pill-group" id="player-speed-group">
            <button type="button" class="speed-chip is-active" data-speed="1">1x</button>
            <button type="button" class="speed-chip" data-speed="1.25">1.25x</button>
            <button type="button" class="speed-chip" data-speed="1.5">1.5x</button>
            <button type="button" class="speed-chip" data-speed="2">2x</button>
          </div>

          <!-- Picture in Picture -->
          <button type="button" class="cinema-tool-btn icon-only" id="player-pip-btn" title="Picture in Picture" aria-label="Picture in picture">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <rect x="12" y="10" width="8" height="6" rx="1" fill="currentColor" opacity="0.4"></rect>
            </svg>
          </button>

          <!-- Theater Mode Toggle -->
          <button type="button" class="cinema-tool-btn icon-only" id="player-theater-btn" title="Theater Mode" aria-label="Theater Mode">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="2" y1="9" x2="22" y2="9"></line>
            </svg>
          </button>

          <!-- Fullscreen Toggle -->
          <button type="button" class="cinema-tool-btn icon-only" id="player-fs-btn" title="Fullscreen (F)" aria-label="Fullscreen">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- In-Browser Video Player Section -->
      <div class="video-player-wrapper" id="video-wrapper">
        <video 
          id="embedded-video-player" 
          class="embedded-video-player" 
          controls 
          playsinline 
          preload="metadata"
        >
          <source id="video-source" src="" type="video/mp4" />
          Your browser does not support HTML5 video streaming.
        </video>

        <!-- Buffering Glass Overlay -->
        <div class="player-buffering-overlay" id="player-buffering-overlay" style="display: none;">
          <div class="buffering-spinner"></div>
          <span class="buffering-text">Buffering High-Speed Stream...</span>
        </div>
      </div>

      <!-- Cinema Keyboard Shortcut Hints -->
      <div class="cinema-keyboard-bar">
        <span class="shortcut-tip"><kbd>Space</kbd> Play/Pause</span>
        <span class="shortcut-tip"><kbd>←</kbd> <kbd>→</kbd> Seek 10s</span>
        <span class="shortcut-tip"><kbd>F</kbd> Fullscreen</span>
        <span class="shortcut-tip"><kbd>T</kbd> Theater Mode</span>
        <span class="shortcut-tip"><kbd>M</kbd> Mute</span>
      </div>

      <!-- Multi-file Playlist / Folder Section (Visible only when link contains multiple files) -->
      <div class="multi-files-section" id="multi-files-section" style="display: none;">
        <h3 class="multi-files-heading">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
          </svg>
          <span id="multi-files-count">Folder Files (1)</span>
        </h3>
        <div class="multi-files-list" id="multi-files-list">
          <!-- Dynamically rendered file rows -->
        </div>
      </div>

      <!-- Action Buttons Grid -->
      <div class="result-actions-grid">
        <!-- Direct High-Speed Download Button -->
        <a 
          href="#" 
          class="btn-primary result-btn-download"
          id="direct-download-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span id="download-btn-text">Download Direct MP4</span>
        </a>

        <!-- Copy Direct Link Button -->
        <button type="button" class="btn-secondary result-btn-copy" id="copy-stream-link-btn" title="Copy stream/download link to clipboard">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="copy-btn-label">Copy Direct Link</span>
        </button>

        <!-- Optional Subtitle Download Button -->
        <a 
          href="#" 
          class="btn-secondary result-btn-subtitle" 
          id="download-subtitle-btn"
          target="_blank"
          rel="noopener noreferrer"
          style="display: none;"
          title="Download Subtitles"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M6 10h4"></path>
            <path d="M6 14h8"></path>
          </svg>
          <span>Subtitles</span>
        </a>

        <!-- Telegram Alternative CTA -->
        <a 
          href={APP_CONFIG.telegramBotUrl} 
          class="btn-secondary result-btn-tg" 
          id="result-open-bot-btn"
          target="_blank" 
          rel="noopener noreferrer"
          title="Open in Telegram Bot"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
          <span>Telegram Bot</span>
        </a>

        <!-- Reset Button -->
        <button type="button" class="btn-secondary result-btn-reset" id="reset-result-btn" title="Process a new link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          <span>Process Another</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .result-container {
    padding-top: 20px;
    padding-bottom: 40px;
    animation: fadeInSlide 0.4s ease forwards;
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-card {
    background: linear-gradient(180deg, rgba(14, 20, 22, 0.98) 0%, rgba(8, 12, 13, 0.99) 100%);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding: 36px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 24px 70px rgba(0, 0, 0, 0.75), 0 0 45px rgba(16, 185, 129, 0.14);
  }

  .result-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .result-status-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
  }

  .status-dot {
    width: 9px;
    height: 9px;
    background: var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--color-primary);
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.2);
    }
  }

  .provider-tag {
    background: var(--color-primary-soft);
    border: 1px solid var(--color-primary-border);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .result-meta-info {
    margin-bottom: 20px;
  }

  .result-video-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 12px;
    word-break: break-word;
    line-height: 1.35;
  }

  .meta-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }

  .meta-pill-green {
    color: var(--color-primary);
    border-color: var(--color-primary-border);
    background: var(--color-primary-soft);
    font-weight: 700;
  }

  /* Quality Selector Row */
  .quality-switcher-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    padding: 10px 14px;
    background: rgba(18, 26, 24, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .quality-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .quality-pills-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(.quality-pill-btn) {
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all var(--motion-fast) ease;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  :global(.quality-pill-btn:hover) {
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  :global(.quality-pill-btn.is-active) {
    background: var(--color-primary);
    color: var(--color-text-btn);
    border-color: var(--color-primary);
    font-weight: 700;
    box-shadow: 0 0 14px rgba(16, 214, 160, 0.35);
  }

  /* Cinema Chrome Header Bar */
  .player-cinema-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(14, 20, 18, 0.95);
    border: 1px solid var(--color-border);
    border-bottom: none;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .cinema-stream-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .live-stream-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: pulseDot 2s infinite ease-in-out;
  }

  .cinema-stream-label {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text);
  }

  .stream-hd-chip {
    font-size: 10px;
    font-weight: 800;
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 2px 7px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }

  .cinema-controls-cluster {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cinema-tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-text-secondary);
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .cinema-tool-btn:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .cinema-tool-btn.icon-only {
    padding: 5px 8px;
  }

  .player-speed-pill-group {
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-pill);
    padding: 2px 4px;
  }

  .speed-chip {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
  }

  .speed-chip:hover {
    color: var(--color-text);
  }

  .speed-chip.is-active {
    background: var(--color-primary);
    color: var(--color-text-btn);
  }

  .video-player-wrapper {
    position: relative;
    width: 100%;
    background: #000000;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    margin-bottom: 12px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--color-border-strong);
    border-top: none;
  }

  .embedded-video-player {
    width: 100%;
    max-height: 540px;
    aspect-ratio: 16 / 9;
    display: block;
    background: #000;
  }

  /* Buffering Overlay */
  .player-buffering-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    z-index: 10;
  }

  .buffering-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(16, 214, 160, 0.2);
    border-top-color: #10D6A0;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .buffering-text {
    font-size: var(--text-sm);
    font-weight: 650;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  /* Keyboard shortcut hint bar */
  .cinema-keyboard-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    padding: 8px 12px;
    margin-bottom: 24px;
    background: rgba(18, 26, 24, 0.4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .shortcut-tip {
    font-size: 11px;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .shortcut-tip kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  /* Theater Mode */
  .result-card.is-theater {
    max-width: 1360px;
    margin: 0 auto;
    border-color: rgba(16, 214, 160, 0.45);
  }

  .result-card.is-theater .embedded-video-player {
    max-height: 720px;
  }


  /* Multi-files / Folder Playlist */
  .multi-files-section {
    margin-bottom: 24px;
    background: rgba(18, 26, 24, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .multi-files-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .multi-files-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 220px;
    overflow-y: auto;
  }

  :global(.playlist-file-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--motion-fast) ease;
    text-align: left;
    width: 100%;
  }

  :global(.playlist-file-item:hover) {
    border-color: var(--color-primary-border);
    background: var(--color-surface-3);
  }

  :global(.playlist-file-item.is-active) {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  :global(.playlist-item-info) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  :global(.playlist-item-name) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.playlist-item-meta) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  :global(.playlist-item-badge) {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: rgba(16, 214, 160, 0.12);
  }

  /* Action Buttons Grid */
  .result-actions-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .result-btn-download {
    flex: 2 1 240px;
    padding: 14px 22px;
    font-size: var(--text-sm);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .result-btn-copy, 
  .result-btn-subtitle,
  .result-btn-tg,
  .result-btn-reset {
    flex: 1 1 140px;
    padding: 14px 18px;
    font-size: var(--text-sm);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
