---
import { APP_CONFIG } from '../utils/config';
---

<div class="result-container" id="media-result-panel" style="display: none;" aria-live="polite">
  <div class="container container-hero">
    <div class="result-card" id="media-result-card">
      <!-- Result Card Header -->
      <div class="result-card-top">
        <div class="result-status-badge">
          <span class="status-dot"></span>
          <span id="result-status-text">Video Stream & Direct Download Ready</span>
        </div>
        <span class="provider-tag" id="result-provider-tag">TeraBox Cloud</span>
      </div>

      <!-- File Details -->
      <div class="result-meta-info">
        <h2 class="result-video-title" id="result-video-title">
          Loading video...
        </h2>

        <div class="meta-badges-row">
          <span class="meta-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
            <span id="meta-format">MP4 Video</span>
          </span>

          <span class="meta-pill meta-pill-green">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
              <line x1="7" y1="2" x2="7" y2="22"></line>
              <line x1="17" y1="2" x2="17" y2="22"></line>
            </svg>
            <span id="meta-resolution">HD Quality</span>
          </span>

          <span class="meta-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            </svg>
            <span id="meta-size">Calculating size...</span>
          </span>

          <span class="meta-pill" id="meta-duration-pill">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span id="meta-speed">Instant Stream</span>
          </span>
        </div>
      </div>

      <!-- Quality Stream Switcher Bar (Appears when qualities or fast streams exist) -->
      <div class="quality-switcher-wrap" id="quality-switcher-wrap" style="display: none;">
        <span class="quality-label">Stream Mode:</span>
        <div class="quality-pills-row" id="quality-pills-row">
          <!-- Dynamically populated buttons -->
        </div>
      </div>

      <!-- In-Browser Video Player Section -->
      <div class="video-player-wrapper" id="video-wrapper">
        <video 
          id="embedded-video-player" 
          class="embedded-video-player" 
          controls 
          playsinline 
          preload="metadata"
        >
          <source id="video-source" src="" type="video/mp4" />
          Your browser does not support HTML5 video streaming.
        </video>
      </div>

      <!-- Multi-file Playlist / Folder Section (Visible only when link contains multiple files) -->
      <div class="multi-files-section" id="multi-files-section" style="display: none;">
        <h3 class="multi-files-heading">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
          </svg>
          <span id="multi-files-count">Folder Files (1)</span>
        </h3>
        <div class="multi-files-list" id="multi-files-list">
          <!-- Dynamically rendered file rows -->
        </div>
      </div>

      <!-- Action Buttons Grid -->
      <div class="result-actions-grid">
        <!-- Direct High-Speed Download Button -->
        <a 
          href="#" 
          class="btn-primary result-btn-download"
          id="direct-download-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span id="download-btn-text">Download Direct MP4</span>
        </a>

        <!-- Copy Direct Link Button -->
        <button type="button" class="btn-secondary result-btn-copy" id="copy-stream-link-btn" title="Copy stream/download link to clipboard">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span id="copy-btn-label">Copy Direct Link</span>
        </button>

        <!-- Optional Subtitle Download Button -->
        <a 
          href="#" 
          class="btn-secondary result-btn-subtitle" 
          id="download-subtitle-btn"
          target="_blank"
          rel="noopener noreferrer"
          style="display: none;"
          title="Download Subtitles"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M6 10h4"></path>
            <path d="M6 14h8"></path>
          </svg>
          <span>Subtitles</span>
        </a>

        <!-- Telegram Alternative CTA -->
        <a 
          href={APP_CONFIG.telegramBotUrl} 
          class="btn-secondary result-btn-tg" 
          id="result-open-bot-btn"
          target="_blank" 
          rel="noopener noreferrer"
          title="Open in Telegram Bot"
        >
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
          <span>Telegram Bot</span>
        </a>

        <!-- Reset Button -->
        <button type="button" class="btn-secondary result-btn-reset" id="reset-result-btn" title="Process a new link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          <span>Process Another</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .result-container {
    padding-top: 20px;
    padding-bottom: 40px;
    animation: fadeInSlide 0.4s ease forwards;
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .result-card {
    background: linear-gradient(180deg, rgba(14, 20, 22, 0.98) 0%, rgba(8, 12, 13, 0.99) 100%);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    padding: 36px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 24px 70px rgba(0, 0, 0, 0.75), 0 0 45px rgba(16, 185, 129, 0.14);
  }

  .result-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .result-status-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
  }

  .status-dot {
    width: 9px;
    height: 9px;
    background: var(--color-primary);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--color-primary);
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.2);
    }
  }

  .provider-tag {
    background: var(--color-primary-soft);
    border: 1px solid var(--color-primary-border);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .result-meta-info {
    margin-bottom: 20px;
  }

  .result-video-title {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 12px;
    word-break: break-word;
    line-height: 1.35;
  }

  .meta-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
  }

  .meta-pill-green {
    color: var(--color-primary);
    border-color: var(--color-primary-border);
    background: var(--color-primary-soft);
    font-weight: 700;
  }

  /* Quality Selector Row */
  .quality-switcher-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
    padding: 10px 14px;
    background: rgba(18, 26, 24, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .quality-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .quality-pills-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  :global(.quality-pill-btn) {
    background: var(--color-surface-3);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all var(--motion-fast) ease;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  :global(.quality-pill-btn:hover) {
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  :global(.quality-pill-btn.is-active) {
    background: var(--color-primary);
    color: var(--color-text-btn);
    border-color: var(--color-primary);
    font-weight: 700;
    box-shadow: 0 0 14px rgba(16, 214, 160, 0.35);
  }

  .video-player-wrapper {
    position: relative;
    width: 100%;
    background: #000000;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 24px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid var(--color-border-strong);
  }

  .embedded-video-player {
    width: 100%;
    max-height: 520px;
    aspect-ratio: 16 / 9;
    display: block;
    background: #000;
  }

  /* Multi-files / Folder Playlist */
  .multi-files-section {
    margin-bottom: 24px;
    background: rgba(18, 26, 24, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .multi-files-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .multi-files-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 220px;
    overflow-y: auto;
  }

  :global(.playlist-file-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--motion-fast) ease;
    text-align: left;
    width: 100%;
  }

  :global(.playlist-file-item:hover) {
    border-color: var(--color-primary-border);
    background: var(--color-surface-3);
  }

  :global(.playlist-file-item.is-active) {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  :global(.playlist-item-info) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow: hidden;
  }

  :global(.playlist-item-name) {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.playlist-item-meta) {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  :global(.playlist-item-badge) {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    background: rgba(16, 214, 160, 0.12);
  }

  /* Action Buttons Grid */
  .result-actions-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .result-btn-download {
    flex: 2 1 240px;
    padding: 14px 22px;
    font-size: var(--text-sm);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .result-btn-copy, 
  .result-btn-subtitle,
  .result-btn-tg,
  .result-btn-reset {
    flex: 1 1 140px;
    padding: 14px 18px;
    font-size: var(--text-sm);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  @media (max-width: 768px) {
    .result-container {
      padding-top: 10px;
      padding-bottom: 24px;
    }

    .result-card {
      padding: 20px 16px;
      border-radius: var(--radius-xl);
    }

    .result-video-title {
      font-size: var(--text-lg);
    }

    .result-actions-grid {
      flex-direction: column;
      gap: 10px;
    }

    .result-btn-download,
    .result-btn-copy,
    .result-btn-subtitle,
    .result-btn-tg,
    .result-btn-reset {
      width: 100%;
      flex: 1 1 auto;
      justify-content: center;
      padding: 14px 16px;
    }

    .meta-badges-row {
      gap: 6px;
    }

    .meta-pill {
      font-size: var(--text-xs);
      padding: 4px 8px;
    }
  }

  @media (max-width: 380px) {
    .result-card {
      padding: 14px 10px;
    }

    .result-video-title {
      font-size: var(--text-base);
    }
  }
</style>
