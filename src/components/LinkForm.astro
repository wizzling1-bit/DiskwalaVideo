---
import { APP_CONFIG } from '../utils/config';

interface Props {
  showHeroHeader?: boolean;
  placeholder?: string;
}

const {
  showHeroHeader = true,
  placeholder = "Paste your Terabox, Diskwala, or Flezen link here..."
} = Astro.props;
---

{showHeroHeader && (
  <section class="hero-section" id="tools">
    <div class="container container-hero">
      <!-- Top Pill Badge -->
      <div class="hero-badge-wrap">
        <div class="badge-pill">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="zap-icon">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span data-i18n="hero.badge">Free · Simple · Online</span>
        </div>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        <span class="hero-title-prefix" data-i18n="hero.prefix">Terawala — </span>
        <span class="text-gradient-green hero-title-accent" data-i18n="hero.accent">Video Downloader & Player</span>
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle" data-i18n="hero.desc">
        The fast, free online video downloader and player supporting TeraBox, Diskwala, and Flezen. Paste any supported video link below for instant browser streaming or high-speed MP4 downloads with zero ads.
      </p>
    </div>
  </section>
)}

<!-- Main Interactive Form Section -->
<div class={showHeroHeader ? "container container-hero-form" : ""}>
  <div class="hero-card-box">
    <form id="terawala-form" class="diskwala-form" novalidate>
        <div class="form-input-row">
          <!-- Leading Left Input Box (Large & Spacious) -->
          <div class="input-outer-wrapper" id="input-outer-wrapper">
            <div class="input-leading-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </div>

            <label for="link-input" class="visually-hidden">{placeholder}</label>
            <input 
              type="url" 
              id="link-input" 
              class="link-input" 
              placeholder={placeholder}
              data-i18n-placeholder="form.placeholder"
              autocomplete="off" 
              spellcheck="false" 
              inputmode="url" 
              aria-describedby="error-msg" 
              required 
            />

            <!-- Quick Actions: Paste & Clear -->
            <div class="input-actions">
              <button 
                type="button" 
                class="icon-action-btn paste-btn" 
                id="paste-btn" 
                title="Paste link from clipboard" 
                aria-label="Paste from clipboard"
              >
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                </svg>
                <span class="action-btn-text" data-i18n="form.paste">Paste</span>
              </button>

              <button 
                type="button" 
                class="icon-action-btn clear-btn" 
                id="clear-btn" 
                title="Clear input" 
                aria-label="Clear link input" 
                style="display: none;"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Primary Submit Button on Right (Disabled until link is entered) -->
          <button type="submit" class="submit-btn is-disabled" id="submit-btn" disabled data-magnetic>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="play-arrow-icon" id="btn-play-icon">
              <polygon points="6 4 19 12 6 20 6 4"></polygon>
            </svg>
            <span class="spinner-ring" id="btn-spinner" style="display: none;"></span>
            <span class="btn-text" id="submit-btn-text" data-i18n="form.submit">Play & Download</span>
          </button>
        </div>

        <!-- Processing status indicator (Matching Screenshot 3) -->
        <div class="processing-status-row" id="processing-status-row" style="display: none;">
          <span class="status-spinner"></span>
          <span class="processing-text" data-i18n="form.analyzing">Analyzing link & preparing video stream...</span>
        </div>

        <!-- Feedback & Detection Row -->
        <div class="form-feedback-row" id="feedback-row" aria-live="assertive">
          <div class="provider-pill" id="provider-pill" style="display: none;">
            <span class="provider-indicator"></span>
            <span id="provider-name">Diskwala Link Detected</span>
          </div>

          <div class="error-pill" id="error-pill" style="display: none;">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span id="error-msg">Please enter a valid link</span>
          </div>
        </div>

        <!-- Daily Quota Tracker Bar -->
        <!-- Daily Quota Tracker Bar -->
        <div class="quota-tracker-bar" id="quota-tracker-bar">
          <div class="quota-info">
            <span class="quota-icon">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="#10b981" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <span class="quota-title">Daily Free Quota:</span>
            <span class="quota-count" id="quota-count-display">5 of 5 links left today</span>
            <span class="quota-reset-pill" id="quota-reset-countdown">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Resets in <strong id="reset-time-string">--:--:--</strong></span>
            </span>
          </div>

          <!-- Non-VIP: Buy Premium trigger button with aligned crown icon -->
          <button type="button" class="quota-upgrade-trigger" id="quota-upgrade-trigger">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="#fbbf24" class="quota-crown-icon" aria-hidden="true">
              <path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path>
            </svg>
            <span id="quota-upgrade-text">Buy Premium</span>
          </button>

          <!-- VIP Active: Prestigious VIP badge replacing Buy button -->
          <a href="/dashboard/" class="quota-vip-status-badge" id="quota-vip-status-badge" style="display: none;">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="#fbbf24" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
            <span>VIP Active</span>
          </a>
        </div>
      </form>

      <!-- ======================================================== -->
      <!-- VIDEO READY RESULT CARD (Matching Screenshot 4)           -->
      <!-- ======================================================== -->
      <div class="telegram-ready-card" id="telegram-ready-card" style="display: none;">
        <!-- Centered Green Play Icon Badge -->
        <div class="ready-icon-circle">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="#10b981">
            <polygon points="8 5 19 12 8 19"></polygon>
          </svg>
        </div>

        <!-- Headline -->
        <h2 class="ready-title" data-i18n="ready.title">
          Your video is ready! Open our official Telegram Bot to watch and download in HD.
        </h2>

        <!-- Primary CTA Button (Green button with white text) -->
        <div class="ready-btn-wrap">
          <a 
            href={APP_CONFIG.telegramBotUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="ready-telegram-btn"
            id="ready-open-bot-btn"
            data-magnetic
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
              <polygon points="6 4 19 12 6 20 6 4"></polygon>
            </svg>
            <span data-i18n="ready.btn">Open in Telegram Bot</span>
          </a>
        </div>
      </div>
    </div>

    {showHeroHeader && (
      <!-- Free Action Cards Below Input -->
      <div class="hero-feature-cards">
        <!-- Card 1: Universal Cloud Stream & Direct MP4 Converter -->
        <div class="feature-card feature-card-emerald">
          <div class="feature-card-header">
            <div class="feature-icon-badge icon-emerald">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path>
                <polyline points="12 13 12 9 10 10"></polyline>
              </svg>
            </div>
            <span class="feature-tag tag-emerald">UNIVERSAL CLOUD RESOLVER</span>
          </div>
          <h2 class="feature-title" data-i18n="card.converterTitle">Direct Cloud MP4 Converter</h2>
          <p class="feature-desc" data-i18n="card.converterDesc">
            Instantly decode TeraBox, Diskwala, Flezen and 10+ cloud mirrors into high-speed direct MP4 streams. Zero advertisements, zero popups, zero app installs.
          </p>
          <a href="#tools-hub" class="btn-solid-emerald card-cta">
            <span>Explore All Tools</span>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
        </div>

        <!-- Card 2: Priority & Speed Web Player -->
        <div class="feature-card feature-card-amber">
          <div class="feature-card-header">
            <div class="feature-icon-badge icon-amber">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"></path>
              </svg>
            </div>
            <span class="feature-tag tag-amber">PRIORITY & SPEED</span>
          </div>
          <h2 class="feature-title" data-i18n="card.playerTitle">High-Speed Web Player</h2>
          <p class="feature-desc" data-i18n="card.playerDesc">
            Enjoy lightning-fast video previewing, priority buffering speeds, ad-free player experience, and zero registration required.
          </p>
          <a href="/pricing/" class="btn-solid-amber card-cta" id="hero-vip-trigger">
            <span>Buy Premium</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    )}
  </div>

<style>
  .hero-section {
    padding-top: 64px;
    padding-bottom: 56px;
    text-align: center;
  }

  .container-hero {
    max-width: 1040px;
  }

  .container-hero-form {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  .hero-badge-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 26px;
  }

  .zap-icon {
    color: var(--color-primary);
  }

  .hero-title {
    font-size: var(--text-display);
    font-weight: 850;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 22px;
    color: var(--color-text);
    text-wrap: balance;
  }

  .hero-title-prefix {
    display: inline;
  }

  .hero-title-accent {
    display: inline;
  }

  .hero-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 820px;
    margin: 0 auto 44px;
    line-height: 1.7;
    text-wrap: balance;
  }

  /* ======================================================== */
  /* Hero Card Box (Background Box around Input - Image 2)    */
  /* ======================================================== */
  .hero-card-box {
    background: #080d0f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 28px 30px 24px;
    max-width: 880px;
    margin: 0 auto;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    text-align: left;
  }

  :global(.bezel-inner) .hero-card-box {
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    max-width: 100%;
  }

  .diskwala-form {
    width: 100%;
  }

  .form-input-row {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
  }

  /* Inner Input Box on the Left (Spacious, Clean) */
  .input-outer-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    background: #05080a;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    height: 56px;
    padding: 0 16px 0 18px;
    gap: 12px;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
    transition: background 0.2s cubic-bezier(0.2, 0, 0, 1), border-color 0.2s, box-shadow 0.2s;
  }

  .input-outer-wrapper:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  /* When link is entered / filled (Matching Image 3 & 4) */
  .input-outer-wrapper.is-filled {
    background: #ebf3fa;
    border-color: #cbd5e1;
  }

  .input-leading-icon {
    color: var(--color-primary);
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .input-outer-wrapper.is-filled .input-leading-icon {
    color: #059669;
  }

  .link-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: 500;
    min-width: 120px;
    padding: 0;
    height: 100%;
    transition: color 0.2s;
  }

  .input-outer-wrapper.is-filled .link-input {
    color: #0f172a;
    font-weight: 600;
  }

  .link-input::placeholder {
    color: var(--color-text-muted);
  }

  .input-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-secondary);
    padding: 7px 14px;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s, color 0.15s, background-color 0.15s;
  }

  .icon-action-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
  }

  .input-outer-wrapper.is-filled .icon-action-btn {
    background: rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.12);
    color: #475569;
  }

  .input-outer-wrapper.is-filled .icon-action-btn:hover {
    background: rgba(0, 0, 0, 0.15);
    color: #0f172a;
  }

  .clear-btn {
    padding: 7px 9px;
  }

  /* Submit Button on Right (Matching Image 2, 3, 4) */
  .submit-btn {
    flex-shrink: 0;
    height: 56px;
    padding: 0 30px;
    font-size: var(--text-base);
    font-weight: 750;
    border-radius: var(--radius-md);
    background: #059669;
    border: 1px solid rgba(52, 211, 153, 0.35);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(5, 150, 105, 0.35);
    white-space: nowrap;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.2s, background 0.2s, opacity 0.2s;
  }

  .submit-btn:hover:not(:disabled) {
    background: #10b981;
    box-shadow: 0 6px 24px rgba(16, 185, 129, 0.45);
    transform: translateY(-1px);
  }

  .submit-btn:active:not(:disabled) {
    transform: scale(0.97);
  }

  /* Unclickable state before link is pasted: sleek neutral frosted dark glass */
  .submit-btn:disabled,
  .submit-btn.is-disabled {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.42);
    opacity: 1;
    cursor: not-allowed;
    pointer-events: none;
    box-shadow: none;
  }

  .submit-btn:disabled .play-arrow-icon,
  .submit-btn.is-disabled .play-arrow-icon {
    color: rgba(255, 255, 255, 0.32);
  }

  .play-arrow-icon {
    color: #ffffff;
    flex-shrink: 0;
  }

  .spinner-ring {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: #ffffff;
    border-radius: var(--radius-pill);
    animation: spin 0.75s linear infinite;
  }

  /* Processing Status Row (Matching Image 3) */
  .processing-status-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding: 14px 18px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.24);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: #34d399;
    font-weight: 600;
    animation: fadeIn 0.25s ease;
  }

  .status-spinner {
    width: 20px;
    height: 20px;
    border: 2.5px solid rgba(52, 211, 153, 0.25);
    border-top-color: #34d399;
    border-radius: var(--radius-pill);
    animation: spin 0.8s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Feedback Row */
  .form-feedback-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
    font-size: var(--text-sm);
  }

  .provider-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-primary-soft);
    border: 1px solid var(--color-primary-border);
    color: var(--color-primary);
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-xs);
  }

  .provider-indicator {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary);
  }

  .error-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-error-soft);
    border: 1px solid rgba(244, 63, 94, 0.35);
    color: #fda4af;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--text-xs);
  }



  /* Daily Quota Tracker Bar */
  .quota-tracker-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 18px;
    padding: 10px 16px;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.25);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    flex-wrap: wrap;
    gap: 10px;
  }

  .quota-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .quota-icon {
    font-size: 14px;
  }

  .quota-title {
    color: var(--color-text-secondary);
    font-weight: 650;
  }

  .quota-count {
    color: #34d399;
    font-weight: 800;
  }

  .quota-upgrade-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(5, 150, 105, 0.35) 100%);
    border: 1px solid rgba(52, 211, 153, 0.45);
    color: #ffffff;
    font-size: 11px;
    font-weight: 750;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .quota-upgrade-trigger:hover {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    box-shadow: 0 2px 10px rgba(16, 185, 129, 0.4);
    transform: translateY(-1px);
  }

  .quota-crown-icon {
    flex-shrink: 0;
    color: #fbbf24;
    filter: drop-shadow(0 0 4px rgba(251, 191, 36, 0.5));
  }

  .quota-vip-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.16) 0%, rgba(16, 185, 129, 0.16) 100%);
    border: 1px solid rgba(245, 158, 11, 0.5);
    color: #fbbf24;
    font-size: 11px;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    box-shadow: 0 0 14px rgba(245, 158, 11, 0.2);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .quota-vip-status-badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.35);
    color: #fef08a;
  }

  /* ======================================================== */
  /* VIDEO READY RESULT CARD CSS (Matching Screenshot 4)       */
  /* ======================================================== */
  .telegram-ready-card {
    background: #060a0c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 38px 24px 30px;
    margin-top: 24px;
    text-align: center;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
    animation: fadeInSlide 0.35s cubic-bezier(0.2, 0, 0, 1) forwards;
  }

  @keyframes fadeInSlide {
    from { 
      opacity: 0; 
      transform: translateY(12px) scale(0.98); 
    }
    to { 
      opacity: 1; 
