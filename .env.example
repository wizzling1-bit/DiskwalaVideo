# TeraWala Environment Variables Template
# Copy this file to .env locally or configure in Cloudflare Dashboard

# Site URL Configuration
PUBLIC_SITE_URL=https://terawala.com

# Supabase Configuration
PUBLIC_SUPABASE_URL=https://fyjeyhrkuuuxxwhjnhov.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay Integration (Live or Test key)
PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Telegram Community
PUBLIC_TELEGRAM_CHANNEL_URL=https://telegram.me/terawala_official
PUBLIC_TELEGRAM_BOT_URL=https://telegram.me/terawala_official
