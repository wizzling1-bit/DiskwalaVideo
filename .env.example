# TeraWala Environment Variables Template
# Copy this file to .env or configure in Cloudflare Pages dashboard

# Site URL Configuration
PUBLIC_SITE_URL=https://terawala.com

# Telegram Bot Integration
PUBLIC_TELEGRAM_BOT_URL=https://telegram.me/DiskWalaa_video_downloader_bot
PUBLIC_TELEGRAM_BOT_USERNAME=DiskWalaa_video_downloader_bot
# Optional: Server-side Telegram Bot Token for automated channel verification checks (Keep private in Cloudflare Secrets)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_REQUIRED_CHANNEL_ID=-1001234567890

# Search Console Verification (Optional meta tag values)
# PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here
# PUBLIC_BING_SITE_VERIFICATION=your_bing_verification_code_here

# Analytics (Optional, privacy-preserving)
# PUBLIC_CF_ANALYTICS_TOKEN=your_cloudflare_web_analytics_token
